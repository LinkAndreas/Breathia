    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Bluetooth to connect to your heart-rate sensor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia verwendet Bluetooth, um sich mit deinem Herzfrequenzsensor zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa Bluetooth para conectarse a tu sensor de frecuencia cardiaca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise le Bluetooth pour se connecter à votre capteur de fréquence cardiaque."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia reads your heart rate during breathing sessions to show live feedback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia liest während Atemsitzungen deine Herzfrequenz, um Live-Feedback anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia lee tu frecuencia cardiaca durante las sesiones de respiración para mostrar información en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia lit votre fréquence cardiaque pendant les séances de respiration pour afficher un retour en direct."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia saves your breathing sessions to Apple Health as mindful minutes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia sichert deine Atemsitzungen in Apple Health als Achtsamkeitsminuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia guarda tus sesiones de respiración en Apple Health como minutos de atención plena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia enregistre vos séances de respiration dans Apple Health en tant que minutes de pleine conscience."
