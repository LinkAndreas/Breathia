    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Bluetooth to connect to your heart-rate sensor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia verwendet Bluetooth, um sich mit deinem Herzfrequenzsensor zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa Bluetooth para conectarse a tu sensor de frecuencia cardiaca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise le Bluetooth pour se connecter à votre capteur de fréquence cardiaque."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Apple Watch, Breathia reads your heart rate from Apple Health during breathing sessions to show live feedback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Apple Watch liest Breathia während Atemsitzungen deine Herzfrequenz aus Apple Health, um Live-Feedback anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el Apple Watch, Breathia lee tu frecuencia cardiaca de Apple Health durante las sesiones de respiración para mostrar información en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur Apple Watch, Breathia lit votre fréquence cardiaque dans Apple Health pendant les séances de respiration pour afficher un retour en direct."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia saves your breathing sessions to Apple Health as mindful minutes, and on Apple Watch also as workouts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia sichert deine Atemsitzungen in Apple Health als Achtsamkeitsminuten und auf der Apple Watch zusätzlich als Trainings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia guarda tus sesiones de respiración en Apple Health como minutos de atención plena y, en el Apple Watch, también como entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia enregistre vos séances de respiration dans Apple Health en tant que minutes de pleine conscience et, sur Apple Watch, également en tant qu'entraînements."
          }
        }
      }
    }
  },
  "version" : "1.0"
