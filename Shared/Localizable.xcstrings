    "technique.belly.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz oder leg dich hin und lege eine Hand auf den Bauch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or lie down with one hand on your belly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o túmbate con una mano sobre el abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi ou allonge-toi, une main sur le ventre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti o sdraiati con una mano sulla pancia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座るか横になり、片手をおなかに当てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앉거나 누워서 한 손을 배 위에 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga zitten of liggen met één hand op je buik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se ou deite-se com uma mão sobre a barriga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь или ляг, положив одну руку на живот."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐下或躺下，将一只手放在腹部。"
          }
        }
      }
    },
    "technique.belly.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme durch die Nase ein und lass deinen Bauch 6 Sekunden lang steigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through your nose and let your belly rise for 6 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por la nariz y deja que el abdomen se eleve durante 6 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire par le nez et laisse ton ventre se soulever pendant 6 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira dal naso e lascia salire la pancia per 6 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻から吸い、6秒間かけておなかをふくらませます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 6초 동안 들이쉬며 배가 부풀어 오르게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem in door je neus en laat je buik 6 seconden omhoogkomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire pelo nariz e deixe a barriga subir por 6 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдыхай носом 6 секунд, позволяя животу подниматься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子吸气 6 秒，让腹部鼓起。"
          }
        }
      }
    },
    "technique.belly.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
