    "technique.sigh.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Zyklen reichen meist aus. Kehre zur normalen Atmung zurück, wenn du außer Atem bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few cycles are usually enough. Return to normal breathing if you feel out of breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente bastan unos pocos ciclos. Vuelve a respirar con normalidad si te falta el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques cycles suffisent généralement. Reviens à une respiration normale si tu manques de souffle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito bastano pochi cicli. Torna a respirare normalmente se ti senti senza fiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常は数サイクルで十分です。息切れを感じたら、ふだんの呼吸に戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보통 몇 번의 주기로 충분해요. 숨이 차면 평소 호흡으로 돌아가세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een paar cycli zijn meestal genoeg. Ga terug naar je normale ademhaling als je buiten adem raakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns ciclos costumam bastar. Volte a respirar normalmente se ficar sem fôlego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно достаточно нескольких циклов. Вернись к обычному дыханию, если не хватает воздуха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常几轮就足够了。如果感到气短，请恢复正常呼吸。"
          }
        }
      }
    },
    "technique.sigh.steps.1" : {
      "localizations" : {
