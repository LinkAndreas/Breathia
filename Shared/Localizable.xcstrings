    "technique.sunBreath.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeide diese Übung am späten Abend, wenn sie dich wach hält. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid this practice late in the evening if it keeps you awake. Stop if you feel lightheaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita esta práctica a última hora de la noche si te desvela. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez cette pratique tard le soir si elle vous empêche de dormir. Arrêtez si vous vous sentez étourdi."
          }
        }
      }
    },
    "technique.sunBreath.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht hin und lege die linke Hand in den Schoß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright and rest your left hand in your lap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido y apoya la mano izquierda en el regazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous droit et posez la main gauche sur vos genoux."
          }
        }
      }
    },
    "technique.sunBreath.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das linke Nasenloch mit dem Ringfinger und atme 4 Sekunden rechts ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close your left nostril with your ring finger and inhale through the right for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa izquierda con el dedo anular e inhala por la derecha durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouchez la narine gauche avec l'annulaire et inspirez par la droite pendant 4 secondes."
          }
        }
      }
    },
    "technique.sunBreath.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das rechte Nasenloch und atme 4 Sekunden links aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close the right nostril and exhale through the left for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa derecha y exhala por la izquierda durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouchez la narine droite et expirez par la gauche pendant 4 secondes."
          }
        }
      }
    },
    "technique.sunBreath.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole und atme immer rechts ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat, always inhaling on the right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite, inhalando siempre por la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommencez en inspirant toujours à droite."
          }
        }
      }
    },
    "technique.sunBreath.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
