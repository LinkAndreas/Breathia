    "settings.sound.footer" : {
      "comment" : "Footer below the sound settings",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanfter Klang markiert jeden Wechsel der Atmung: höher beim Einatmen, tiefer beim Ausatmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A soft sound marks each turn of the breath: higher when breathing in, lower when breathing out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido suave marca cada cambio de la respiración: más agudo al inspirar, más grave al espirar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son doux marque chaque changement de la respiration : plus aigu à l'inspiration, plus grave à l'expiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un suono delicato segna ogni cambio del respiro: più acuto quando inspiri, più grave quando espiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸が切り替わるたびに、やわらかな音でお知らせします。吸うときは高い音、吐くときは低い音です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡이 바뀔 때마다 부드러운 소리가 알려 줘요. 들이쉴 때는 높은 소리, 내쉴 때는 낮은 소리가 나요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zacht geluid markeert elke ademwissel: hoger bij het inademen, lager bij het uitademen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um som suave marca cada transição da respiração: mais agudo ao inspirar, mais grave ao expirar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкий звук отмечает каждую смену фазы дыхания: выше на вдохе, ниже на выдохе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次呼吸转换时会有轻柔的提示音：吸气时音调较高，呼气时音调较低。"
          }
        }
      }
    },
