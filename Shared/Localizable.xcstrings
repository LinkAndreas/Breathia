            "value" : "口を閉じ、やさしくハミングしながら6秒間吐きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입을 다물고 부드럽게 허밍하며 6초 동안 내쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem 6 seconden uit en neurie zacht met gesloten lippen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expire por 6 segundos cantarolando suavemente, com os lábios fechados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдыхай 6 секунд, мягко жужжа с сомкнутыми губами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闭上嘴唇，轻声哼鸣着呼气 6 秒。"
          }
        }
      }
    },
    "technique.humming.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass das Summen weich und gleichmäßig, nicht erzwungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the hum stay soft and steady, not forced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el zumbido sea suave y constante, sin forzarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde un bourdonnement doux et régulier, sans forcer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che il ronzio resti morbido e costante, senza forzarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハミングは無理せず、やわらかく一定に保ちます。"
          }
        },
        "ko" : {
