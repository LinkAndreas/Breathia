    "technique.triangle.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei gleich lange Phasen – Einatmen, Halten, Ausatmen – bilden einen einfachen, dreieckigen Rhythmus. Die Struktur der Box-Atmung bleibt erhalten, nur mit einer Pause weniger, was vielen leichter fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three equal phases — inhale, hold, exhale — form a simple triangle-shaped rhythm. It keeps the structure of box breathing with one fewer hold, which many people find easier to sustain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres fases iguales (inhalar, retener y exhalar) forman un ritmo sencillo en forma de triángulo. Mantiene la estructura de la respiración cuadrada con una retención menos, lo que a muchas personas les resulta más fácil de mantener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois phases égales — inspiration, rétention, expiration — forment un rythme simple en triangle. On garde la structure de la respiration carrée avec une rétention en moins, ce que beaucoup trouvent plus facile à tenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre fasi uguali (inspirazione, apnea, espirazione) formano un ritmo semplice a forma di triangolo. Mantiene la struttura della respirazione quadrata con un’apnea in meno, cosa che molti trovano più facile da sostenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸う、止める、吐くの3つの同じ長さのフェーズが、シンプルな三角形のリズムをつくります。ボックス呼吸の構造はそのままに息止めが1回少ないため、続けやすいと感じる人が多くいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들이쉬기, 참기, 내쉬기의 같은 길이 세 단계가 단순한 삼각형 모양의 리듬을 이뤄요. 박스 호흡의 구조를 유지하면서 참기가 한 번 적어, 꾸준히 이어 가기 더 쉽다고 느끼는 사람이 많아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie even lange fasen – inademen, vasthouden, uitademen – vormen een eenvoudig, driehoekig ritme. De structuur van boxademhaling blijft behouden, met één pauze minder, wat veel mensen makkelijker vol kunnen houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três fases iguais — inspirar, segurar, expirar — formam um ritmo simples em forma de triângulo. Ela mantém a estrutura da respiração quadrada com uma retenção a menos, o que muitas pessoas acham mais fácil de manter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три равные фазы — вдох, задержка, выдох — образуют простой ритм в форме треугольника. Он сохраняет структуру квадратного дыхания, но с одной задержкой меньше, и многим его легче поддерживать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气、屏息、呼气三个等长阶段构成简单的三角形节奏。它保留了箱式呼吸的结构，但少了一次屏息，许多人觉得更容易坚持。"
          }
        }
      }
    },
