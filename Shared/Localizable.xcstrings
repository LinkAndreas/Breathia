    "technique.equal.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein- und Ausatmen dauern gleich viele Sekunden, ohne Pausen. Das ist oft das erste Muster, das Menschen ausprobieren, weil es leicht zu zählen und einfach durchzuhalten ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The inhale and exhale last the same number of seconds, with no holds. This is often the first pattern people try because it is simple to count and easy to sustain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inhalación y la exhalación duran los mismos segundos, sin retenciones. Suele ser el primer patrón que se prueba porque es fácil de contar y de mantener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inspiration et l'expiration durent le même nombre de secondes, sans rétention. C'est souvent le premier rythme essayé, car il est simple à compter et facile à tenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirazione ed espirazione durano lo stesso numero di secondi, senza apnee. Spesso è il primo schema che si prova, perché è semplice da contare e facile da mantenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を止めずに、吸う時間と吐く時間を同じ秒数にします。数えやすく続けやすいため、多くの人が最初に試すパターンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들이쉬기와 내쉬기를 같은 초 동안 하고, 숨을 참지 않아요. 세기 쉽고 꾸준히 이어 가기 쉬워서 많은 사람이 가장 먼저 시도하는 패턴이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inademing en uitademing duren evenveel seconden, zonder pauzes. Dit is vaak het eerste patroon dat mensen proberen, omdat het makkelijk te tellen en goed vol te houden is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A inspiração e a expiração duram o mesmo número de segundos, sem retenções. Muitas vezes é o primeiro padrão que as pessoas experimentam, porque é simples de contar e fácil de manter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдох и выдох длятся одинаковое число секунд, без задержек. Часто это первый паттерн, который пробуют, потому что его просто считать и легко поддерживать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气和呼气的秒数相同，没有屏息。由于易于计数且容易坚持，这通常是人们尝试的第一种呼吸模式。"
          }
        }
      }
    },
