    "settings.info.heartRateReadingsHRV" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfrequenzwerte, HRV-Werte und der Sitzungsverlauf werden nur auf diesem Gerät gespeichert. Breathia hat kein Konto und sendet nichts an einen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart-rate readings, HRV values, and session history are stored only on this device. Breathia has no account and sends nothing to a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las lecturas de frecuencia cardiaca, los valores de VFC y el historial de sesiones se guardan solo en este dispositivo. Breathia no tiene cuentas y no envía nada a ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures de fréquence cardiaque, les valeurs de VFC et l'historique des séances sont stockés uniquement sur cet appareil. Breathia ne nécessite aucun compte et n'envoie rien à un serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le misurazioni della frequenza cardiaca, i valori HRV e la cronologia delle sessioni sono salvati solo su questo dispositivo. Breathia non ha account e non invia nulla a un server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数の測定値、HRVの値、セッション履歴は、このデバイスにのみ保存されます。Breathiaにはアカウントがなく、サーバーには何も送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수 측정값, HRV 값, 세션 기록은 이 기기에만 저장돼요. Breathia에는 계정이 없으며 서버로 아무것도 전송하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartslagmetingen, HRV-waarden en de sessiegeschiedenis worden alleen op dit apparaat bewaard. Breathia heeft geen account en stuurt niets naar een server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As medições de frequência cardíaca, os valores de VFC e o histórico de sessões ficam armazenados apenas neste dispositivo. O Breathia não tem conta e não envia nada a nenhum servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показания пульса, значения ВСР и история сеансов хранятся только на этом устройстве. У Breathia нет учётной записи, и приложение ничего не отправляет на сервер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率读数、HRV 数值和练习历史记录仅存储在此设备上。Breathia 无需账户，也不会向服务器发送任何数据。"
          }
        }
      }
    },
    "settings.info.moistenTheElectrodeAreas" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Brustgurt wie dem Polar H10 befeuchte die Elektrodenbereiche, befestige ihn direkt unterhalb der Brustmuskulatur und klicke den Sensor ein. Die meisten Sensoren werden aktiv und beginnen zu senden, sobald sie einen Herzschlag erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a chest strap like the Polar H10, moisten the electrode areas, fasten it just below your chest muscles, and snap the sensor on. Most sensors wake up and start advertising once they detect a heartbeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una correa pectoral como el Polar H10, humedece las zonas de los electrodos, abróchala justo debajo de los músculos pectorales y encaja el sensor. La mayoría de los sensores se activan y empiezan a emitir en cuanto detectan un latido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une ceinture thoracique comme le Polar H10, humidifie les zones d'électrodes, attache-la juste sous les muscles pectoraux et clipse le capteur. La plupart des capteurs s'activent et commencent à émettre dès qu'ils détectent un battement de cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una fascia toracica come il Polar H10, inumidisci le zone degli elettrodi, allacciala appena sotto i muscoli pettorali e aggancia il sensore. La maggior parte dei sensori si attiva e inizia a trasmettere appena rileva un battito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10などの胸部ストラップの場合は、電極部分を湿らせ、胸の筋肉のすぐ下に装着してから、センサーを取り付けます。ほとんどのセンサーは、心拍を検出すると起動して信号を発信し始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10 같은 가슴 스트랩은 전극 부위를 적신 다음 가슴 근육 바로 아래에 착용하고 센서를 끼우세요. 대부분의 센서는 심장 박동을 감지하면 켜지면서 신호를 보내기 시작해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevochtig bij een borstband zoals de Polar H10 de elektrodezones, maak de band vast net onder je borstspieren en klik de sensor erop. De meeste sensoren worden actief en beginnen te zenden zodra ze een hartslag detecteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma cinta peitoral como o Polar H10, umedeça as áreas dos eletrodos, prenda a cinta logo abaixo dos músculos do peito e encaixe o sensor. A maioria dos sensores liga e começa a transmitir assim que detecta batimentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у тебя нагрудный ремень, например Polar H10, смочи зоны электродов, застегни ремень чуть ниже грудных мышц и пристегни датчик. Большинство датчиков включаются и начинают передавать сигнал, как только улавливают сердцебиение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于 Polar H10 等胸带，请润湿电极区域，将其系在胸肌正下方，然后扣上传感器。大多数传感器在检测到心跳后会唤醒并开始广播信号。"
          }
        }
      }
    },
