    "technique.bellows.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze, kräftige Ein- und Ausatemzüge durch die Nase folgen in gleichmäßigem Tempo aufeinander, wie ein Blasebalg, der ein Feuer anfacht. Es ist eine traditionelle, belebende Übung in kurzen Runden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short, strong inhales and exhales through the nose follow each other at a steady pace, like a bellows fanning a fire. It is a traditional energizing practice done in short rounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalaciones y exhalaciones cortas y fuertes por la nariz se suceden a un ritmo constante, como un fuelle que aviva el fuego. Es una práctica tradicional energizante que se hace en rondas cortas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De courtes inspirations et expirations vigoureuses par le nez s'enchaînent à un rythme régulier, comme un soufflet qui attise un feu. C'est une pratique traditionnelle dynamisante, réalisée en courtes séries."
          }
        }
      }
    },
    "technique.bellows.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
