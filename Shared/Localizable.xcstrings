    },
    "technique.humming.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden lang aus und summe dabei sanft mit geschlossenen Lippen."
          }
