        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息が自然に消えていくように、6秒間ゆっくり吐きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
