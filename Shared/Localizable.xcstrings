    "onboarding.health.addEachBreathingSession" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia nutzt Apple Health (HealthKit), um jede Atemsitzung als Achtsamkeitsminuten hinzuzufügen, damit deine Praxis neben deinen übrigen Gesundheitsdaten erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Apple Health (HealthKit) to add each breathing session as mindful minutes, so your practice appears alongside the rest of your health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa la app Salud (HealthKit) para añadir cada sesión de respiración como minutos de atención plena, de modo que tu práctica aparezca junto al resto de tus datos de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise Apple Santé (HealthKit) pour ajouter chaque séance de respiration en tant que minutes de pleine conscience, pour que ta pratique apparaisse avec tes autres données de santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa l’app Salute (HealthKit) per aggiungere ogni sessione di respirazione come minuti di consapevolezza, così la tua pratica appare insieme al resto dei tuoi dati sulla salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaはヘルスケア（HealthKit）を使って各呼吸セッションをマインドフルネスの時間として追加します。これにより、ほかのヘルスケアデータと一緒にあなたの練習が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia는 건강 앱(HealthKit)을 사용해 각 호흡 세션을 마음 챙기기 시간으로 추가해요. 그러면 다른 건강 데이터와 함께 수련 기록을 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia gebruikt de Gezondheid-app (HealthKit) om elke ademsessie als mindfulnessminuten toe te voegen, zodat je oefening naast de rest van je gezondheidsgegevens verschijnt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia usa o app Saúde (HealthKit) para registrar cada sessão de respiração como Minutos de Atenção Plena, para que sua prática apareça junto com o restante dos seus dados de saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia использует приложение «Здоровье» (HealthKit), чтобы добавлять каждый дыхательный сеанс как минуты осознанности. Так твоя практика будет видна рядом с остальными данными о здоровье."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 使用“健康”App（HealthKit）将每次呼吸练习记录为正念分钟数，让你的练习与其他健康数据显示在一起。"
          }
        }
      }
    },
    "onboarding.health.breathiaOnlyWrites" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem iPhone schreibt Breathia nur Achtsamkeitsminuten und liest nie deine Gesundheitsdaten."
          }
        },
        "en" : {
