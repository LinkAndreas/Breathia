    "settings.info.bluetoothIsUsedSolely" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wird ausschließlich für die Verbindung mit deinem Herzfrequenzsensor verwendet. Die App sucht nicht nach anderen Geräten und sammelt keine Informationen über sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth is used solely to talk to your heart-rate sensor. The app doesn't scan for or collect information about any other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth se usa únicamente para comunicarse con tu sensor de frecuencia cardiaca. La app no busca otros dispositivos ni recopila información sobre ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Bluetooth sert uniquement à communiquer avec votre capteur de fréquence cardiaque. L'app ne recherche aucun autre appareil et ne collecte aucune information à leur sujet."
          }
        }
      }
    },
    "settings.info.breathia" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia ist ein Wellness-Tool und nicht dazu bestimmt, Erkrankungen zu diagnostizieren oder zu behandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia is a wellness tool and isn't intended to diagnose or treat any condition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
