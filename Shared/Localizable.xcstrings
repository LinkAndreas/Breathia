          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een malend hoofd tot rust brengen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acalmar uma mente acelerada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
