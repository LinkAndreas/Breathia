    "technique.box.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich das Anhalten unangenehm anfühlt, verkürze die Pausen oder lass sie weg. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If holding your breath feels uncomfortable, shorten the holds or skip them. Stop if you feel lightheaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si retener el aire te resulta incómodo, acorta las retenciones u omítelas. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si retenir votre souffle est inconfortable, raccourcissez ou supprimez les rétentions. Arrêtez si vous vous sentez étourdi."
          }
        }
      }
    },
    "technique.box.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich bequem hin und stütze deinen Rücken ab."
