    "versionHistory.1_4_8.note1" : {
      "comment" : "Version History: note 1 of what Breathia 1.4.8 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia erscheint im App Store: 24 Atemtechniken in sieben Kategorien, jede erklärt, mit ruhigem Atemkreis, Haptik und Tönen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia arrives on the App Store: 24 breathing techniques in seven categories, each explained, with a calm breathing circle, haptic and sound cues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia llega al App Store: 24 técnicas de respiración en siete categorías, cada una explicada, con un círculo de respiración tranquilo y señales hápticas y sonoras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia arrive sur l’App Store : 24 techniques de respiration en sept catégories, chacune expliquée, avec un cercle de respiration apaisant et des signaux haptiques et sonores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia arriva su App Store: 24 tecniche di respirazione in sette categorie, ognuna spiegata, con un cerchio di respirazione rilassante e segnali aptici e sonori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreathiaがApp Storeに登場：7つのカテゴリに分かれた24種類の呼吸テクニックを、それぞれの説明付きで収録。穏やかな呼吸サークルと、触覚と音による合図でガイドします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia가 App Store에 출시되었어요. 7개 카테고리의 24가지 호흡법과 각각의 설명, 차분한 호흡 원, 햅틱 및 사운드 신호를 만나 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia verschijnt in de App Store: 24 ademhalingstechnieken in zeven categorieën, elk uitgelegd, met een rustige ademcirkel en haptische en geluidssignalen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia chega à App Store: 24 técnicas de respiração em sete categorias, cada uma explicada, com um círculo de respiração tranquilo e sinais táteis e sonoros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia появляется в App Store: 24 дыхательные техники в семи категориях, каждая с объяснением, со спокойным дыхательным кругом, тактильными и звуковыми подсказками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 登陆 App Store：七个类别共 24 种呼吸法，每种都有详细说明，并配有平静的呼吸圆圈、触感和声音提示。"
          }
        }
      }
    },
    "versionHistory.1_4_8.note2" : {
      "comment" : "Version History: note 2 of what Breathia 1.4.8 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Biofeedback zu Herzfrequenz und HRV mit jedem Bluetooth-Herzfrequenzsensor, etwa dem Polar H10."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live heart-rate and HRV biofeedback with any Bluetooth heart-rate sensor, such as the Polar H10."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biofeedback en directo de frecuencia cardiaca y VFC con cualquier sensor de frecuencia cardiaca Bluetooth, como el Polar H10."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biofeedback en direct de la fréquence cardiaque et de la VFC avec n’importe quel capteur de fréquence cardiaque Bluetooth, comme le Polar H10."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biofeedback in tempo reale di frequenza cardiaca e HRV con qualsiasi sensore di frequenza cardiaca Bluetooth, come il Polar H10."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10など、あらゆるBluetooth心拍センサーで、心拍数とHRVのリアルタイムのバイオフィードバックを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10 같은 모든 Bluetooth 심박 센서로 실시간 심박수 및 HRV 바이오피드백."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live biofeedback over hartslag en HRV met elke Bluetooth-hartslagsensor, zoals de Polar H10."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biofeedback ao vivo de frequência cardíaca e VFC com qualquer sensor de frequência cardíaca Bluetooth, como o Polar H10."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живая биообратная связь по пульсу и ВСР с любым Bluetooth-датчиком пульса, например Polar H10."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用任何蓝牙心率传感器（如 Polar H10）获取实时心率和 HRV 生物反馈。"
          }
        }
      }
    },
    "versionHistory.1_4_8.note3" : {
      "comment" : "Version History: note 3 of what Breathia 1.4.8 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf aller Sitzungen, Achtsamkeitsminuten in Apple Health, eine Live-Aktivität und Apps für iPhone, iPad, Mac und Apple Watch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History of every session, mindful minutes in Apple Health, a Live Activity, and apps for iPhone, iPad, Mac and Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historial de cada sesión, minutos de atención plena en la app Salud, una actividad en directo y apps para iPhone, iPad, Mac y Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique de chaque séance, minutes de pleine conscience dans Apple Santé, une activité en direct et des apps pour iPhone, iPad, Mac et Apple Watch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronologia di ogni sessione, minuti di consapevolezza nell’app Salute, un’Attività in tempo reale e app per iPhone, iPad, Mac e Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのセッションの履歴、ヘルスケアへのマインドフルネスの時間の記録、ライブアクティビティ、そしてiPhone、iPad、Mac、Apple Watch用のApp。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 세션의 기록, 건강 앱의 마음 챙기기 시간, 실시간 현황, 그리고 iPhone, iPad, Mac, Apple Watch용 앱."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschiedenis van elke sessie, mindfulnessminuten in Gezondheid, een Live Activity en apps voor iPhone, iPad, Mac en Apple Watch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico de cada sessão, Minutos de Atenção Plena no app Saúde, uma Atividade ao Vivo e apps para iPhone, iPad, Mac e Apple Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История всех сеансов, минуты осознанности в «Здоровье», Live Activity и приложения для iPhone, iPad, Mac и Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次练习的历史记录、“健康”App 中的正念分钟数、实时活动，以及适用于 iPhone、iPad、Mac 和 Apple Watch 的 App。"
          }
        }
      }
    },
    "versionHistory.1_5_1.note1" : {
      "comment" : "Version History: note 1 of what Breathia 1.5.1 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia ist jetzt komplett kostenlos: keine Trinkgelder und Abos mehr – alle Funktionen und alle App-Icons sind für alle frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia is now completely free: no more tips or subscriptions — every feature and every app icon is free for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia ahora es totalmente gratis: sin propinas ni suscripciones; todas las funciones y todos los iconos de la app son gratis para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia est désormais entièrement gratuit : fini les pourboires et les abonnements, toutes les fonctions et toutes les icônes de l’app sont gratuites pour tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia ora è completamente gratuita: niente più mance né abbonamenti – ogni funzione e ogni icona dell’app sono gratuite per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaは完全無料になりました。チップやサブスクリプションはもうありません。すべての機能とすべてのAppアイコンを、誰でも無料で使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 Breathia가 완전히 무료예요. 팁이나 구독 없이 모든 기능과 모든 앱 아이콘을 누구나 무료로 이용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia is nu helemaal gratis: geen fooien of abonnementen meer – elke functie en elk appsymbool is gratis voor iedereen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia agora é totalmente gratuito: sem gorjetas nem assinaturas — todos os recursos e todos os ícones do app são gratuitos para todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia теперь полностью бесплатна: никаких чаевых и подписок — все функции и все значки приложения бесплатны для всех."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 现已完全免费：不再有打赏或订阅，所有功能和所有 App 图标对所有人免费。"
          }
        }
      }
    },
    "versionHistory.1_5_1.note2" : {
      "comment" : "Version History: note 2 of what Breathia 1.5.1 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle unter Einstellungen › App-Icon eines der acht Icons, alle auf einen Blick; Breathia übernimmt die Farben des gewählten Icons."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one of eight icons in Settings › App Icon, all at a glance; Breathia takes on the colors of the icon you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige uno de los ocho iconos en Ajustes › Icono de la app, todos a la vista; Breathia adopta los colores del que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis l’une des huit icônes dans Réglages › Icône de l’app, toutes d’un coup d’œil ; Breathia adopte les couleurs de celle que tu choisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una delle otto icone in Impostazioni › Icona app, tutte a colpo d’occhio; Breathia assume i colori dell’icona che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「Appアイコン」で8つのアイコンを一覧から選べます。Breathiaは選んだアイコンのカラーに合わせて表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 앱 아이콘에서 8가지 아이콘을 한눈에 보고 선택하세요. Breathia가 선택한 아이콘의 색상으로 바뀌어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een van de acht symbolen in Instellingen › Appsymbool, allemaal in één oogopslag; Breathia neemt de kleuren aan van het symbool dat je kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um dos oito ícones em Ajustes › Ícone do app, todos à vista; o Breathia assume as cores do ícone escolhido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирай один из восьми значков в разделе Настройки › Значок приложения, все сразу на виду; Breathia принимает цвета выбранного значка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”›“App 图标”中从八款图标中任选其一，所有图标一目了然；Breathia 会换上你所选图标的配色。"
          }
        }
      }
    },
    "versionHistory.1_5_1.note3" : {
      "comment" : "Version History: note 3 of what Breathia 1.5.1 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vollständige Datenschutzerklärung erreichst du jetzt direkt unter Einstellungen › Datenschutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full Privacy Policy is now one tap away in Settings › Privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La política de privacidad completa está ahora a un toque en Ajustes › Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La politique de confidentialité complète est désormais accessible dans Réglages › Confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’informativa sulla privacy completa è ora a un tocco di distanza in Impostazioni › Privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「プライバシー」から、プライバシーポリシーの全文をワンタップで確認できるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 설정 › 개인정보 보호에서 탭 한 번으로 개인정보 처리방침 전문을 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het volledige privacybeleid staat nu op één tik afstand in Instellingen › Privacy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Política de Privacidade completa agora está a um toque, em Ajustes › Privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полная политика конфиденциальности теперь в одном касании: Настройки › Конфиденциальность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在只需轻点一下，即可在“设置”›“隐私”中查看完整的隐私政策。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note1" : {
      "comment" : "Version History: note 1 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acht ruhige, natürliche Klänge in Stereo – neu: Kristallklangschale, Windspiel, Kalimba und Meeresrauschen – mit eigenem Bereich „Ton“ in den Einstellungen und eigener Lautstärke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eight calm, natural sounds in stereo — new: crystal bowl, wind chimes, kalimba and ocean waves — with their own Sound section in Settings and a volume control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocho sonidos tranquilos y naturales en estéreo (nuevos: cuenco de cristal, campanillas de viento, kalimba y olas del mar), con su propia sección Sonido en Ajustes y su propio volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huit sons calmes et naturels en stéréo (nouveaux : bol de cristal, carillon à vent, kalimba et vagues de l’océan), avec une section Son dédiée dans les Réglages et un réglage du volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otto suoni calmi e naturali in stereo – le novità: campana di cristallo, campane a vento, kalimba e onde del mare – con una sezione Suono dedicata in Impostazioni e un controllo del volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステレオで楽しめる、穏やかで自然な8つのサウンド。新たにクリスタルボウル、ウィンドチャイム、カリンバ、波の音が加わりました。「設定」には専用の「サウンド」セクションと音量調整も用意しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분하고 자연스러운 8가지 스테레오 사운드: 크리스털 볼, 윈드차임, 칼림바, 파도 소리가 새로 추가되었고, 설정에 전용 사운드 섹션과 음량 조절이 생겼어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acht rustige, natuurlijke geluiden in stereo – nieuw: kristallen klankschaal, windgong, kalimba en oceaangolven – met een eigen onderdeel ‘Geluid’ in Instellingen en een eigen volumeregeling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oito sons calmos e naturais em estéreo — novos: tigela de cristal, sinos dos ventos, kalimba e ondas do mar —, com uma seção Som própria nos Ajustes e controle de volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восемь спокойных природных звуков в стерео — новые: хрустальная чаша, музыка ветра, калимба и океанские волны — со своим разделом «Звук» в Настройках и регулировкой громкости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "八种平静、自然的立体声声音（新增水晶钵、风铃、卡林巴琴和海浪），在“设置”中拥有专属的“声音”部分，并可调节音量。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note2" : {
      "comment" : "Version History: note 2 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Herz im Detail: Nach einer Sitzung mit Herzfrequenzsensor siehst du Puls und HRV Sekunde für Sekunde und wie dein Herz mit jedem Atemzug stieg und fiel – in einfachen Worten erklärt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your heart in detail: after a session with a heart-rate sensor, see your heart rate and HRV second by second, and how your heart rose and fell with each breath — explained in plain words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu corazón, en detalle: tras una sesión con sensor de frecuencia cardiaca, ve tu frecuencia cardiaca y tu VFC segundo a segundo, y cómo tu corazón subió y bajó con cada respiración, explicado con palabras sencillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton cœur, en détail : après une séance avec un capteur de fréquence cardiaque, vois ta fréquence cardiaque et ta VFC seconde par seconde, et comment ton cœur a accéléré et ralenti à chaque respiration, le tout expliqué simplement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo cuore nel dettaglio: dopo una sessione con un sensore di frequenza cardiaca, vedi frequenza cardiaca e HRV secondo per secondo, e come il tuo cuore è salito e sceso a ogni respiro – spiegato con parole semplici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心臓の動きを詳しく：心拍センサーを使ったセッションのあとは、心拍数とHRVを1秒ごとに確認でき、呼吸ごとに心拍がどう上下したかもわかりやすい言葉で説明されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 심장을 자세히: 심박 센서를 연결한 세션이 끝나면 심박수와 HRV를 초 단위로 보고, 호흡할 때마다 심박수가 어떻게 오르내렸는지 쉬운 말로 된 설명과 함께 확인할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hart in detail: zie na een sessie met een hartslagsensor je hartslag en HRV seconde voor seconde, en hoe je hart bij elke ademhaling steeg en daalde – uitgelegd in gewone woorden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu coração em detalhes: depois de uma sessão com sensor de frequência cardíaca, veja sua frequência cardíaca e sua VFC segundo a segundo, e como seu coração subiu e desceu a cada respiração — explicado em palavras simples."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоё сердце в деталях: после сеанса с датчиком пульса смотри пульс и ВСР секунда за секундой и то, как сердце ускорялось и замедлялось с каждым вдохом и выдохом, — простыми словами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深入了解你的心脏：使用心率传感器完成练习后，你可以逐秒查看心率和 HRV，以及每次呼吸时心率如何起伏，并配有通俗易懂的说明。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note3" : {
      "comment" : "Version History: note 3 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sitzung läuft weiter, wenn du dein iPhone drehst oder aufklappst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your session carries on when you turn or unfold your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión continúa cuando giras o despliegas el iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta séance continue quand tu tournes ou déplies ton iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione continua quando ruoti o apri il tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneの向きを変えたり、本体を開いたりしても、セッションはそのまま続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 돌리거나 펼쳐도 세션이 그대로 이어져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je sessie loopt door als je je iPhone draait of openvouwt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sessão continua quando você gira ou desdobra o seu iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс продолжается, когда ты поворачиваешь или раскрываешь iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旋转或展开 iPhone 时，你的练习会继续进行。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note4" : {
      "comment" : "Version History: note 4 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem iPad bleibt die Liste neben der geöffneten Seite sichtbar, auch im Hochformat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On iPad, the list stays beside the open page, even in portrait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPad, la lista se mantiene junto a la página abierta, incluso en vertical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur iPad, la liste reste à côté de la page ouverte, même en mode portrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPad, l’elenco resta accanto alla pagina aperta, anche in verticale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadでは、縦向きでもリストが開いているページの横に表示されたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서는 세로 방향에서도 목록이 열린 페이지 옆에 계속 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op iPad blijft de lijst naast de geopende pagina staan, ook in staande stand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPad, a lista fica ao lado da página aberta, mesmo na orientação vertical."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPad список остаётся рядом с открытой страницей, даже в портретной ориентации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPad 上，即使是竖屏，列表也会保留在打开的页面旁边。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note5" : {
      "comment" : "Version History: note 5 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische im Verlauf über eine Sitzung, um sie zu löschen, oder lösche alle auf einmal in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe a session in History to delete it, or delete all sessions at once in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza una sesión en Historial para eliminarla, o elimínalas todas a la vez en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balaie une séance dans l’historique pour la supprimer, ou supprime-les toutes d’un coup dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri una sessione nella cronologia per eliminarla, oppure elimina tutte le sessioni in una volta in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「履歴」でセッションをスワイプして削除したり、「設定」ですべてのセッションを一度に削除したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에서 세션을 쓸어넘겨 삭제하거나, 설정에서 모든 세션을 한 번에 삭제할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg in Geschiedenis over een sessie om die te verwijderen, of verwijder alle sessies tegelijk in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize uma sessão no Histórico para apagá-la, ou apague todas as sessões de uma vez nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахни сеанс в Истории, чтобы удалить его, или удали все сеансы сразу в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“历史记录”中轻扫某次练习即可将其删除，也可以在“设置”中一次删除所有练习。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note6" : {
      "comment" : "Version History: note 6 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuer Bereich „Feedback“ in den Einstellungen: Breathia bewerten, eine Idee schicken oder die App teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new Feedback section in Settings: rate Breathia, send an idea or share the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva sección Comentarios en Ajustes: valora Breathia, envía una idea o comparte la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle section Ton avis dans les Réglages : note Breathia, envoie une idée ou partage l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova sezione Feedback in Impostazioni: valuta Breathia, invia un’idea o condividi l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」に新しい「フィードバック」セクションを追加：Breathiaの評価、アイデアの送信、Appの共有ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정의 새로운 피드백 섹션: Breathia를 평가하고, 아이디어를 보내고, 앱을 공유해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuw onderdeel ‘Feedback’ in Instellingen: beoordeel Breathia, stuur een idee of deel de app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova seção Feedback nos Ajustes: avalie o Breathia, envie uma ideia ou compartilhe o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый раздел «Отзывы» в Настройках: оцени Breathia, отправь идею или поделись приложением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设置”中新增“反馈”部分：为 Breathia 评分、发送想法或分享 App。"
          }
        }
      }
    },
    "versionHistory.1_8_2.note7" : {
      "comment" : "Version History: note 7 of what Breathia 1.8.2 brought, shown as a bullet point. Same text as the release notes on Breathia's website.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungs-Icons in Breathias eigenen Farben und viele kleine Verbesserungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings icons in Breathia’s own colors, and many smaller refinements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iconos de Ajustes con los colores propios de Breathia y muchas pequeñas mejoras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des icônes de réglages aux couleurs propres à Breathia et de nombreuses petites améliorations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icone delle impostazioni nei colori di Breathia e tanti piccoli miglioramenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定のアイコンがBreathia独自のカラーになったほか、細かな改善を多数行いました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia만의 색상으로 바뀐 설정 아이콘과 그 밖의 다양한 개선 사항."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbolen in Instellingen in de eigen kleuren van Breathia, en veel kleinere verbeteringen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ícones dos Ajustes nas cores do próprio Breathia e muitos pequenos aprimoramentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки настроек в фирменных цветах Breathia и множество небольших улучшений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设置”图标采用 Breathia 专属配色，另有许多细节改进。"
          }
        }
      }
    },
