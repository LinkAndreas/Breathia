        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez ensuite invité à autoriser l'utilisation du Bluetooth."
          }
        }
      }
    },
    "sensor.permission.privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Geräte werden dabei weder gesucht noch erfasst."
