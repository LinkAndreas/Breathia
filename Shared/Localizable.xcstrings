    "technique.sigh.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf zwei Einatmungen hintereinander – die zweite kürzer und auf die erste gesetzt – folgt ein langes, langsames Ausatmen. Dieses Muster kommt von Natur aus vor und soll helfen, die Lunge vor einem längeren Ausatmen wieder zu entfalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two inhales in a row, the second one shorter and on top of the first, are followed by one long, slow exhale. This pattern occurs naturally and is thought to help re-inflate the lungs before a longer release of air."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dos inhalaciones seguidas, la segunda más corta y sobre la primera, les sigue una exhalación larga y lenta. Este patrón se da de forma natural y se cree que ayuda a volver a expandir los pulmones antes de soltar el aire durante más tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux inspirations successives, la seconde plus courte et par-dessus la première, sont suivies d'une longue expiration lente. Ce schéma survient naturellement et aiderait à regonfler les poumons avant une expiration plus longue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due inspirazioni di fila, la seconda più breve e aggiunta alla prima, sono seguite da un’unica espirazione lunga e lenta. Questo schema si presenta in modo naturale e si ritiene che aiuti a riespandere i polmoni prima di un rilascio d’aria più lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2回続けて吸い（2回目は短く、1回目に重ねて）、そのあと長くゆっくり吐きます。このパターンは自然に起こるもので、長く息を吐き出す前に肺を再びふくらませるのに役立つと考えられています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번 연달아 들이쉬되 두 번째는 첫 번째에 더해 짧게 들이쉬고, 이어서 한 번 길고 천천히 내쉬어요. 자연스럽게 일어나는 호흡 패턴으로, 공기를 길게 내보내기 전에 폐를 다시 부풀리는 데 도움이 된다고 알려져 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee inademingen na elkaar, de tweede korter en boven op de eerste, worden gevolgd door één lange, langzame uitademing. Dit patroon komt vanzelf voor en helpt vermoedelijk de longen weer te ontplooien voordat de lucht langer wordt uitgeademd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas inspirações seguidas, a segunda mais curta e por cima da primeira, são seguidas de uma expiração longa e lenta. Esse padrão acontece naturalmente e, acredita-se, ajuda a reinflar os pulmões antes de uma liberação de ar mais longa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два вдоха подряд — второй короче и поверх первого — сменяются одним долгим, медленным выдохом. Этот паттерн возникает естественным образом и, как считается, помогает снова расправить лёгкие перед более долгим выпуском воздуха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连续两次吸气，第二次较短，叠加在第一次之上，随后是一次悠长、缓慢的呼气。这种模式会自然发生，一般认为它有助于在较长的呼气前让肺部重新充分扩张。"
          }
        }
      }
    },
