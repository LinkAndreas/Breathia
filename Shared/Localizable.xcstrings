    "technique.sunBreath.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeide diese Übung am späten Abend, wenn sie dich wach hält. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid this practice late in the evening if it keeps you awake. Stop if you feel lightheaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita esta práctica a última hora de la noche si te desvela. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évite cette pratique tard le soir si elle t'empêche de dormir. Arrête si la tête te tourne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita questa pratica la sera tardi se ti impedisce di dormire. Fermati se ti gira la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠れなくなる場合は、夜遅くの練習は避けてください。ふらつきを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠들기 어려워진다면 늦은 저녁에는 피하세요. 머리가 어지러우면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermijd deze oefening laat op de avond als je er wakker van blijft. Stop als je je licht in je hoofd voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite esta prática tarde da noite se ela tirar seu sono. Pare se sentir a cabeça leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не практикуй это поздно вечером, если потом трудно уснуть. Остановись, если закружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果这种练习让你难以入睡，请避免在深夜练习。如感到头晕，请停止练习。"
          }
        }
      }
    },
    "technique.sunBreath.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht hin und lege die linke Hand in den Schoß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright and rest your left hand in your lap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido y apoya la mano izquierda en el regazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi le dos droit et pose la main gauche sur tes genoux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti con la schiena dritta e appoggia la mano sinistra in grembo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背筋を伸ばして座り、左手をひざの上に置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "똑바로 앉아 왼손을 무릎 위에 편히 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga rechtop zitten en leg je linkerhand in je schoot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se com a coluna ereta e apoie a mão esquerda no colo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь прямо и положи левую руку на колени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐直，将左手放在腿上。"
          }
        }
      }
    },
    "technique.sunBreath.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das linke Nasenloch mit dem Ringfinger und atme 4 Sekunden rechts ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close your left nostril with your ring finger and inhale through the right for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa izquierda con el dedo anular e inhala por la derecha durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouche la narine gauche avec l'annulaire et inspire par la droite pendant 4 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi la narice sinistra con l’anulare e inspira dalla destra per 4 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薬指で左の鼻をふさぎ、右の鼻から4秒間吸います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약지로 왼쪽 콧구멍을 막고 오른쪽으로 4초 동안 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit je linkerneusgat met je ringvinger en adem 4 seconden in door het rechter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche a narina esquerda com o dedo anelar e inspire pela direita por 4 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрой левую ноздрю безымянным пальцем и вдыхай через правую 4 секунды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用无名指按住左鼻孔，用右鼻孔吸气 4 秒。"
          }
        }
      }
    },
    "technique.sunBreath.steps.3" : {
      "localizations" : {
        "de" : {
