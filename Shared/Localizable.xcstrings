    "technique.altnostril.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme durchgehend sanft. Lass die Pausen weg, wenn sich das Anhalten unangenehm anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe gently throughout. Skip the holds if breath-holding feels uncomfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con suavidad en todo momento. Omite las retenciones si te resultan incómodas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire doucement tout du long. Passe les rétentions si retenir ton souffle te met mal à l'aise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira sempre con delicatezza. Salta le apnee se trattenere il respiro ti mette a disagio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後までやさしく呼吸してください。息を止めるのがつらい場合は、止める部分を省いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음부터 끝까지 부드럽게 호흡하세요. 숨 참기가 불편하면 참는 단계는 건너뛰세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem de hele tijd rustig. Sla de pauzes over als het vasthouden van je adem onprettig voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire com suavidade o tempo todo. Pule as retenções se segurar o ar for desconfortável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё время дыши мягко. Пропускай задержки, если задерживать дыхание некомфортно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全程轻柔地呼吸。如果屏息让你感到不适，请跳过屏息。"
          }
        }
      }
    },
    "technique.altnostril.steps.1" : {
      "localizations" : {
        "de" : {
