    "technique.sevenEleven.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf ein langes Einatmen folgt ein noch längeres Ausatmen. Das Muster wird oft bei Angst oder Panik empfohlen, weil das Zählen und der lange Ausatem dem Geist etwas Beständiges zum Festhalten geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A long inhale is followed by an even longer exhale. The pattern is often recommended for moments of anxiety or panic because counting and the long out-breath give the mind something steady to hold on to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A una inhalación larga le sigue una exhalación aún más larga. Suele recomendarse en momentos de ansiedad o pánico porque contar y la exhalación larga dan a la mente algo estable a lo que aferrarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une longue inspiration est suivie d'une expiration encore plus longue. Ce rythme est souvent conseillé en cas d'anxiété ou de panique, car le comptage et la longue expiration offrent à l'esprit un repère stable."
          }
        }
      }
    },
