    "technique.heartFocused.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dir vor, 5 Sekunden lang durch dein Herz einzuatmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagine breathing in through your heart for 5 seconds."
