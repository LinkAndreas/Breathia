    "technique.equal.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein- und Ausatmen dauern gleich viele Sekunden, ohne Pausen. Das ist oft das erste Muster, das Menschen ausprobieren, weil es leicht zu zählen und einfach durchzuhalten ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The inhale and exhale last the same number of seconds, with no holds. This is often the first pattern people try because it is simple to count and easy to sustain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inhalación y la exhalación duran los mismos segundos, sin retenciones. Suele ser el primer patrón que se prueba porque es fácil de contar y de mantener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inspiration et l'expiration durent le même nombre de secondes, sans rétention. C'est souvent le premier rythme essayé, car il est simple à compter et facile à tenir."
          }
        }
      }
    },
