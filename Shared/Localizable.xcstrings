    "technique.twoToOne.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen dauert doppelt so lang wie das Einatmen. Den Ausatem so stark zu verlängern ist eine verbreitete Methode, vor dem Schlafengehen herunterzufahren und den Körper zur Ruhe kommen zu lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exhale lasts twice as long as the inhale. Lengthening the out-breath this much is a common way to slow down before bed and to let the body settle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exhalación dura el doble que la inhalación. Alargar tanto la salida del aire es una forma habitual de bajar el ritmo antes de dormir y dejar que el cuerpo se relaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration dure deux fois plus longtemps que l'inspiration. Allonger autant l'expiration est une façon courante de ralentir avant le coucher et de laisser le corps s'apaiser."
          }
        }
      }
    },
