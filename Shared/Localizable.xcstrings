    },
    "technique.sigh.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm, ohne auszuatmen, einen zweiten, kürzeren Atemzug obendrauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without exhaling, take a second, shorter sip of air on top of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin exhalar, toma un segundo sorbo de aire más corto encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans expirer, prends une seconde bouffée d'air plus courte par-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza espirare, aggiungi un secondo sorso d’aria, più breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吐かずに、もう一度短く吸い足します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내쉬지 말고 그 위에 한 번 더 짧게 숨을 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem zonder uit te ademen nog een tweede, korter teugje lucht erbovenop."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem expirar, puxe um segundo gole de ar, mais curto, por cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не выдыхая, сделай поверх него второй, более короткий глоток воздуха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要呼气，紧接着再短促地吸一小口气。"
          }
        }
      }
    },
