    "technique.box.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich das Anhalten unangenehm anfühlt, verkürze die Pausen oder lass sie weg. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If holding your breath feels uncomfortable, shorten the holds or skip them. Stop if you feel lightheaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si retener el aire te resulta incómodo, acorta las retenciones u omítelas. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si retenir ton souffle est inconfortable, raccourcis les rétentions ou passe-les. Arrête si la tête te tourne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se trattenere il respiro ti mette a disagio, accorcia le apnee o saltale. Fermati se ti gira la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を止めるのがつらい場合は、止める時間を短くするか省いてください。ふらつきを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨 참기가 불편하면 참는 시간을 줄이거나 건너뛰세요. 머리가 어지러우면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het vasthouden van je adem onprettig voelt, maak de pauzes dan korter of sla ze over. Stop als je je licht in je hoofd voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se segurar o ar for desconfortável, encurte as retenções ou pule-as. Pare se sentir a cabeça leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если задерживать дыхание некомфортно, сократи задержки или пропусти их. Остановись, если закружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果屏息让你感到不适，请缩短或跳过屏息。如感到头晕，请停止练习。"
          }
        }
      }
    },
    "technique.box.steps.1" : {
      "localizations" : {
        "de" : {
