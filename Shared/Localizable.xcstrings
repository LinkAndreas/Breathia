    "settings.breathiaIsntAllowed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia darf nicht in Apple Health schreiben. Aktiviere den Zugriff in der Health-App unter Profil › Apps › Breathia."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia isn't allowed to write to Apple Health. Turn on access in the Health app under Profile › Apps › Breathia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia no tiene permiso para escribir en Salud. Activa el acceso en la app Salud, en Perfil › Apps › Breathia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia n'est pas autorisé à écrire dans Apple Santé. Active l'accès dans l'app Santé sous Profil › Apps › Breathia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia non ha il permesso di scrivere in Salute. Attiva l’accesso nell’app Salute in Profilo › App › Breathia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaにはヘルスケアへの書き込みが許可されていません。ヘルスケアAppの「プロフィール」›「App」›「Breathia」でアクセスをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia에 건강 앱 기록 권한이 없어요. 건강 앱의 프로필 › 앱 › Breathia에서 접근을 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia mag niet naar Gezondheid schrijven. Schakel toegang in de Gezondheid-app in via Profiel › Apps › Breathia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia não tem permissão para registrar dados no app Saúde. Ative o acesso no app Saúde em Perfil › Apps › Breathia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia не может записывать данные в «Здоровье». Разреши доступ в приложении «Здоровье»: Профиль › Приложения › Breathia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 没有写入“健康”App 的权限。请在“健康”App 中前往“个人资料”›“App”›“Breathia”开启访问权限。"
          }
        }
      }
    },
