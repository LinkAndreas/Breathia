          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina la inhalación en la parte alta del pecho durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez l'inspiration dans le haut de la poitrine pendant 2 secondes."
          }
        }
      }
    },
    "technique.threePart.steps.5" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden langsam aus und lass alles weich werden."
