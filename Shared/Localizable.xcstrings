            "value" : "Falta de aire durante la actividad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'essoufflement pendant l'activité"
          }
        }
      }
    },
    "technique.pursedLip.bestFor.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelles, flaches Atmen verlangsamen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowing down quick, shallow breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentizar una respiración rápida y superficial"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentir une respiration rapide et superficielle"
          }
        }
      }
    },
    "technique.pursedLip.bestFor.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kontrolliertes Ausatmen lernen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning a controlled exhale"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender una exhalación controlada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprendre une expiration contrôlée"
          }
        }
      }
    },
    "technique.pursedLip.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen durch gespitzte Lippen, als würdest du eine Kerze auspusten, verlangsamt den Ausatem und hält ihn kontrolliert. Diese einfache Technik wird oft genutzt, damit sich das Atmen bei Anstrengung leichter anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing out through pursed lips, as if blowing out a candle, slows the exhale and keeps it controlled. It is a simple technique often used to make breathing feel easier during exertion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhalar con los labios fruncidos, como si soplaras una vela, ralentiza la salida del aire y la mantiene controlada. Es una técnica sencilla que se usa a menudo para que respirar resulte más fácil durante el esfuerzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirer par les lèvres pincées, comme pour souffler une bougie, ralentit l'expiration et la garde maîtrisée. Cette technique simple est souvent utilisée pour rendre la respiration plus facile pendant l'effort."
          }
        }
      }
    },
    "technique.pursedLip.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lippenbremse"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pursed-Lip Breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración con labios fruncidos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration à lèvres pincées"
          }
        }
      }
    },
    "technique.pursedLip.purpose" : {
      "localizations" : {
