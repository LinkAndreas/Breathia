          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положи руку на грудь, если это помогает сосредоточиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有助于集中注意力，可以将一只手放在胸前。"
          }
        }
      }
    },
    "technique.heartFocused.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dir vor, 5 Sekunden lang durch dein Herz einzuatmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagine breathing in through your heart for 5 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagina que inhalas a través del corazón durante 5 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagine que tu inspires par le cœur pendant 5 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagina di inspirare attraverso il cuore per 5 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心臓から5秒間息を吸い込むようにイメージします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5초 동안 심장으로 숨을 들이쉰다고 상상하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel je voor dat je 5 seconden door je hart inademt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagine que você inspira pelo coração por 5 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Представь, что вдыхаешь через сердце 5 секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想象气息经由心脏吸入，持续 5 秒。"
          }
        }
      }
    },
