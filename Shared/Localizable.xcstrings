    "settings.info.swipeASession" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische im Verlauf eine Sitzung nach links, um sie zu löschen, oder lösche alle unter Einstellungen › Verlauf. Wenn du die App löschst, werden alle ihre Daten entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe a session to the left in History to delete it, or delete them all in Settings › History. Deleting the app removes all of its data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza una sesión hacia la izquierda en Historial para eliminarla, o elimínalas todas en Ajustes › Historial. Al eliminar la app se borran todos sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balaie une séance vers la gauche dans l'Historique pour la supprimer, ou supprime-les toutes dans Réglages › Historique. Supprimer l'app efface toutes ses données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri una sessione verso sinistra nella cronologia per eliminarla, oppure eliminale tutte in Impostazioni › Cronologia. Eliminando l’app vengono rimossi tutti i suoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを削除するには「履歴」で左にスワイプします。すべて削除する場合は「設定」›「履歴」から行えます。Appを削除すると、そのデータもすべて削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에서 세션을 왼쪽으로 쓸어넘기면 삭제할 수 있고, 설정 › 기록에서 모두 삭제할 수도 있어요. 앱을 삭제하면 앱의 모든 데이터가 함께 삭제돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg in Geschiedenis een sessie naar links om die te verwijderen, of verwijder ze allemaal via Instellingen › Geschiedenis. Als je de app verwijdert, worden alle bijbehorende gegevens verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize uma sessão para a esquerda no Histórico para apagá-la, ou apague todas em Ajustes › Histórico. Ao apagar o app, todos os dados dele são removidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахни сеанс влево в Истории, чтобы удалить его, или удали все сразу в разделе Настройки › История. При удалении приложения удаляются все его данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“历史记录”中将练习向左轻扫即可删除，或在“设置”›“历史记录”中全部删除。删除 App 会移除其所有数据。"
          }
        }
      }
    },
    "settings.info.theSensorReportsEvery" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sensor meldet jeden Herzschlag und die Zeit zwischen den Schlägen (RR-Intervalle). Breathia berechnet RMSSD oder SDNN über ein gleitendes Fenster der letzten Schläge, um Live-Biofeedback zu geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sensor reports every heartbeat and the time between beats (RR intervals). Breathia computes RMSSD or SDNN over a rolling window of recent beats to give live biofeedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sensor registra cada latido y el tiempo entre latidos (intervalos RR). Breathia calcula RMSSD o SDNN sobre una ventana móvil de latidos recientes para ofrecer biofeedback en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capteur transmet chaque battement et le temps entre les battements (intervalles RR). Breathia calcule le RMSSD ou le SDNN sur une fenêtre glissante de battements récents pour fournir un biofeedback en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sensore trasmette ogni battito e il tempo tra un battito e l’altro (intervalli RR). Breathia calcola RMSSD o SDNN su una finestra mobile degli ultimi battiti per offrire biofeedback in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーは、すべての心拍と心拍間の時間（RR間隔）を送信します。Breathiaは直近の心拍の移動ウインドウでRMSSDまたはSDNNを計算し、リアルタイムのバイオフィードバックを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서는 모든 심장 박동과 박동 사이의 시간(RR 간격)을 전송해요. Breathia는 최근 박동들의 이동 구간에서 RMSSD 또는 SDNN을 계산해 실시간 바이오피드백을 제공해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sensor geeft elke hartslag door en de tijd tussen de slagen (RR-intervallen). Breathia berekent RMSSD of SDNN over een voortschrijdend venster van recente slagen om live biofeedback te geven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sensor informa cada batimento e o tempo entre os batimentos (intervalos RR). O Breathia calcula RMSSD ou SDNN em uma janela móvel de batimentos recentes para oferecer biofeedback ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик сообщает о каждом ударе сердца и о времени между ударами (RR-интервалы). Breathia вычисляет RMSSD или SDNN по скользящему окну последних ударов, чтобы давать биообратную связь в реальном времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传感器会报告每一次心跳以及心跳之间的时间（RR 间期）。Breathia 基于最近心跳的滚动窗口计算 RMSSD 或 SDNN，以提供实时生物反馈。"
          }
        }
      }
    },
