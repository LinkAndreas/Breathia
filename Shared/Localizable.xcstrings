    "technique.relax.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Pausen. Passe den Takt an, wenn sich eine Phase gehetzt anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No holds are involved. Adjust the counts if either phase feels rushed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay retenciones. Ajusta los tiempos si alguna fase te resulta apresurada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune rétention. Ajuste les durées si l'une des phases te semble précipitée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono apnee. Regola i tempi se una delle due fasi ti sembra affrettata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を止める部分はありません。どちらかのフェーズが慌ただしく感じたら、カウントを調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨 참기가 없어요. 들이쉬기나 내쉬기가 급하게 느껴지면 시간을 조절하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je houdt je adem hierbij niet vast. Pas de tellen aan als een van beide fasen gehaast voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há retenções. Ajuste os tempos se alguma fase parecer apressada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержек нет. Измени счёт, если какая-то из фаз кажется торопливой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不涉及屏息。如果任一阶段感觉仓促，请调整计数。"
          }
        }
      }
    },
    "technique.relax.steps.1" : {
      "localizations" : {
        "de" : {
