    "technique.belly.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz oder leg dich hin und lege eine Hand auf den Bauch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or lie down with one hand on your belly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o túmbate con una mano sobre el abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous ou allongez-vous, une main sur le ventre."
          }
        }
      }
    },
    "technique.belly.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme durch die Nase ein und lass deinen Bauch 6 Sekunden lang steigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through your nose and let your belly rise for 6 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por la nariz y deja que el abdomen se eleve durante 6 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez par le nez et laissez votre ventre se soulever pendant 6 secondes."
          }
        }
      }
    },
    "technique.belly.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden langsam aus und spüre, wie sich dein Bauch senkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale slowly for 6 seconds, feeling your belly fall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala despacio durante 6 segundos y siente cómo baja el abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez lentement pendant 6 secondes en sentant votre ventre redescendre."
          }
        }
      }
    },
    "technique.belly.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deine Brust dabei möglichst ruhig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your chest relatively still throughout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el pecho relativamente quieto en todo momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la poitrine relativement immobile tout du long."
          }
        }
      }
    },
    "technique.belly.summary" : {
