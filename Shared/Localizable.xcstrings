    "technique.relax.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen ist bewusst länger als das Einatmen. Ein längeres Ausatmen ist eine einfache Möglichkeit, jeden Atemzug in Richtung Ausatmung zu verlagern, was viele als beruhigend empfinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exhale is deliberately longer than the inhale. A longer exhale is a simple way to bias each breath toward the exhale phase, which many people experience as calming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exhalación es deliberadamente más larga que la inhalación. Una exhalación más larga es una forma sencilla de inclinar cada respiración hacia la fase de exhalación, algo que muchas personas encuentran relajante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration est volontairement plus longue que l'inspiration. Une expiration plus longue est un moyen simple d'orienter chaque respiration vers la phase d'expiration, ce que beaucoup trouvent apaisant."
          }
        }
      }
    },
