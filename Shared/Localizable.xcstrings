    "sensor.moistenTheStrapsElectrodes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befeuchte die Elektroden des Gurts und leg ihn an – der Polar H10 sendet nur, solange er einen Herzschlag erkennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moisten the strap's electrodes and put it on — Polar H10 only advertises while it detects a heartbeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humedece los electrodos de la correa y póntela: el Polar H10 solo emite mientras detecta un latido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humidifiez les électrodes de la sangle et mettez-la : le Polar H10 n'émet que lorsqu'il détecte un battement de cœur."
          }
        }
      }
    },
