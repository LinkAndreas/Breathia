          }
        }
      }
    },
    "technique.relax.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen ist bewusst länger als das Einatmen. Ein längeres Ausatmen ist eine einfache Möglichkeit, jeden Atemzug in Richtung Ausatmung zu verlagern, was viele als beruhigend empfinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exhale is deliberately longer than the inhale. A longer exhale is a simple way to bias each breath toward the exhale phase, which many people experience as calming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exhalación es deliberadamente más larga que la inhalación. Una exhalación más larga es una forma sencilla de inclinar cada respiración hacia la fase de exhalación, algo que muchas personas encuentran relajante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration est volontairement plus longue que l'inspiration. Une expiration plus longue est un moyen simple d'orienter chaque respiration vers la phase d'expiration, ce que beaucoup trouvent apaisant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espirazione è volutamente più lunga dell’inspirazione. Un’espirazione più lunga è un modo semplice per spostare ogni respiro verso la fase di espirazione, che molte persone trovano calmante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吐く息を意識的に吸う息より長くします。呼気を長くすることは、各呼吸の重心を吐く側に寄せるシンプルな方法で、多くの人が心が落ち着くと感じています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날숨을 의도적으로 들숨보다 길게 해요. 날숨을 길게 하면 호흡의 무게가 내쉬는 단계 쪽으로 옮겨 가는데, 많은 사람이 이를 차분하게 느껴요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De uitademing is bewust langer dan de inademing. Een langere uitademing is een eenvoudige manier om elke ademhaling meer naar de uitademfase te laten neigen, wat veel mensen als kalmerend ervaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A expiração é propositalmente mais longa que a inspiração. Uma expiração mais longa é uma forma simples de dar mais peso à fase de expiração em cada respiração, algo que muitas pessoas sentem como calmante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдох намеренно длиннее вдоха. Удлинённый выдох — простой способ сместить каждый цикл дыхания в сторону выдоха, и многие ощущают это как успокоение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有意让呼气比吸气更长。延长呼气是让每次呼吸偏向呼气阶段的简单方法，许多人会因此感到平静。"
          }
        }
      }
    },
