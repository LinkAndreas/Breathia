    "settings.feedback.shareMessage" : {
      "comment" : "Message shared with the App Store link",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia hilft mir, ruhiger zu atmen – mit Live-Feedback von meinem Herzen."
