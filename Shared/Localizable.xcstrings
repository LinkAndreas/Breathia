    "technique.triangle.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei gleich lange Phasen – Einatmen, Halten, Ausatmen – bilden einen einfachen, dreieckigen Rhythmus. Die Struktur der Box-Atmung bleibt erhalten, nur mit einer Pause weniger, was vielen leichter fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three equal phases — inhale, hold, exhale — form a simple triangle-shaped rhythm. It keeps the structure of box breathing with one fewer hold, which many people find easier to sustain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres fases iguales (inhalar, retener y exhalar) forman un ritmo sencillo en forma de triángulo. Mantiene la estructura de la respiración cuadrada con una retención menos, lo que a muchas personas les resulta más fácil de mantener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois phases égales — inspiration, rétention, expiration — forment un rythme simple en triangle. On garde la structure de la respiration carrée avec une rétention en moins, ce que beaucoup trouvent plus facile à tenir."
          }
        }
      }
    },
    "technique.triangle.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreiecksatmung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triangle Breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración triangular"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration triangulaire"
          }
        }
      }
    },
