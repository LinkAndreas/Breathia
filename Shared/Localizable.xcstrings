    "technique.pursedLip.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen durch gespitzte Lippen, als würdest du eine Kerze auspusten, verlangsamt den Ausatem und hält ihn kontrolliert. Diese einfache Technik wird oft genutzt, damit sich das Atmen bei Anstrengung leichter anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing out through pursed lips, as if blowing out a candle, slows the exhale and keeps it controlled. It is a simple technique often used to make breathing feel easier during exertion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhalar con los labios fruncidos, como si soplaras una vela, ralentiza la salida del aire y la mantiene controlada. Es una técnica sencilla que se usa a menudo para que respirar resulte más fácil durante el esfuerzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirer par les lèvres pincées, comme pour souffler une bougie, ralentit l'expiration et la garde maîtrisée. Cette technique simple est souvent utilisée pour rendre la respiration plus facile pendant l'effort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espirare a labbra socchiuse, come per spegnere una candela, rallenta l’espirazione e la mantiene controllata. È una tecnica semplice, usata spesso per respirare con meno fatica durante uno sforzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ろうそくの火を吹き消すように唇をすぼめて吐くと、呼気がゆっくりになり、コントロールしやすくなります。体を動かしているときに呼吸を楽にするために、よく使われるシンプルな方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "촛불을 끄듯 오므린 입술 사이로 숨을 내쉬면 날숨이 느려지고 조절돼요. 힘을 쓸 때 호흡을 더 편하게 하기 위해 자주 쓰이는 간단한 호흡법이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitademen door getuite lippen, alsof je een kaars uitblaast, vertraagt de uitademing en houdt die gecontroleerd. Het is een eenvoudige techniek die vaak wordt gebruikt om ademen bij inspanning makkelijker te laten voelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirar pelos lábios semicerrados, como se fosse apagar uma vela, desacelera a expiração e a mantém sob controle. É uma técnica simples, muito usada para facilitar a respiração durante o esforço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдох через сомкнутые губы, как будто задуваешь свечу, замедляет его и делает контролируемым. Это простая техника, которую часто используют, чтобы легче дышалось при нагрузке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像吹灭蜡烛一样通过缩起的嘴唇呼气，可以放慢呼气并保持可控。这是一种简单的方法，常用于在用力时让呼吸更轻松。"
          }
        }
      }
    },
