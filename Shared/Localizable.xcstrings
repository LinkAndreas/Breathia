    "watch.health.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia nutzt Apple Health (HealthKit), um während einer Sitzung deine Herzfrequenz zu lesen und die Sitzung als Achtsamkeitsminuten und Training zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Apple Health (HealthKit) to read your heart rate during a session and to save the session as mindful minutes and a workout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa la app Salud (HealthKit) para leer tu frecuencia cardiaca durante una sesión y guardarla como minutos de atención plena y como entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise Apple Santé (HealthKit) pour lire ta fréquence cardiaque pendant une séance et enregistrer la séance en tant que minutes de pleine conscience et entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa l’app Salute (HealthKit) per leggere la tua frequenza cardiaca durante una sessione e salvare la sessione come minuti di consapevolezza e come allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaはヘルスケア（HealthKit）を使って、セッション中の心拍数を読み取り、セッションをマインドフルネスの時間とワークアウトとして保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia는 건강 앱(HealthKit)을 사용해 세션 중 심박수를 읽고, 세션을 마음 챙기기 시간과 운동으로 저장해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia gebruikt de Gezondheid-app (HealthKit) om tijdens een sessie je hartslag te lezen en de sessie te bewaren als mindfulnessminuten en een workout."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia usa o app Saúde (HealthKit) para ler sua frequência cardíaca durante a sessão e salvá-la como Minutos de Atenção Plena e como treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia использует приложение «Здоровье» (HealthKit), чтобы считывать твой пульс во время сеанса и сохранять сеанс как минуты осознанности и тренировку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 使用“健康”App（HealthKit）在练习期间读取你的心率，并将练习存储为正念分钟数和一次体能训练。"
          }
        }
      }
    },
