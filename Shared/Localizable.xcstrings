            "state" : "translated",
            "value" : "Expirez vigoureusement par le nez pendant 1 seconde."
          }
        }
      }
    },
    "technique.bellows.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Rhythmus gleichmäßig und ruhe dich nach jeder Runde aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the rhythm steady and rest after each round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén un ritmo constante y descansa tras cada ronda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez un rythme régulier et reposez-vous après chaque série."
          }
        }
      }
    },
    "technique.bellows.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
