        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira profondamente dal naso per 4 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻から4秒間深く吸います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 4초 동안 깊이 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem 4 seconden diep in door je neus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire profundamente pelo nariz por 4 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубоко вдыхай носом 4 секунды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子深吸气 4 秒。"
          }
        }
      }
    },
    "technique.lion.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Mund weit, streck die Zunge heraus und atme 3 Sekunden kräftig mit einem „Ha“ aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your mouth wide, stick out your tongue, and exhale forcefully with a 'ha' sound for 3 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre bien la boca, saca la lengua y exhala con fuerza con un sonido «ja» durante 3 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre grand la bouche, tire la langue et expire fortement avec un « ha » pendant 3 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalanca la bocca, tira fuori la lingua ed espira con forza con un suono “ha” per 3 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口を大きく開けて舌を突き出し、「ハー」という音とともに3秒間力強く吐きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입을 크게 벌리고 혀를 내민 채 ‘하’ 소리와 함께 3초 동안 힘차게 내쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open je mond wijd, steek je tong uit en adem 3 seconden krachtig uit met een ‘ha’-geluid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra bem a boca, coloque a língua para fora e expire com força fazendo um som de “ha” por 3 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Широко открой рот, высунь язык и сильно выдохни со звуком «ха» за 3 секунды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "张大嘴巴，伸出舌头，发出“哈”的声音用力呼气 3 秒。"
          }
        }
      }
    },
    "technique.lion.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspanne dein Gesicht und wiederhole das ein paar Mal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
