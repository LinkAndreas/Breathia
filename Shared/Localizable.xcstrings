    "technique.ujjayi.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Rachen weich – das Geräusch soll leise sein, nie angestrengt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the throat soft — the sound should be quiet, never strained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la garganta relajada: el sonido debe ser suave, nunca forzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la gorge détendue : le son doit rester discret, jamais forcé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la gola morbida: il suono deve essere lieve, mai forzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喉はやわらかく保ってください。音は静かに、決して力まないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목에 힘을 주지 마세요. 소리는 조용해야 하며 절대 무리해서 내면 안 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je keel ontspannen – het geluid moet zacht zijn, nooit geforceerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a garganta relaxada — o som deve ser baixo, nunca forçado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держи горло мягким — звук должен быть тихим и никогда не напряжённым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持喉咙放松——声音应当轻柔，绝不吃力。"
          }
        }
      }
    },
    "technique.ujjayi.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme durch die Nase ein und aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in and out through your nose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala y exhala por la nariz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire et expire par le nez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira ed espira dal naso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻から吸って、鼻から吐きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 들이쉬고 내쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem in en uit door je neus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire e expire pelo nariz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдыхай и выдыхай через нос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子吸气和呼气。"
          }
        }
      }
    },
    "technique.ujjayi.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verenge sanft den hinteren Rachen, als wolltest du mit geschlossenem Mund einen Spiegel anhauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gently narrow the back of your throat, as if fogging a mirror with your mouth closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrecha suavemente la parte posterior de la garganta, como si empañaras un espejo con la boca cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resserre doucement le fond de la gorge, comme pour embuer un miroir la bouche fermée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringi delicatamente il fondo della gola, come per appannare uno specchio a bocca chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口を閉じたまま鏡を曇らせるように、喉の奥をやさしく狭めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입을 다문 채 거울에 입김을 불듯 목 안쪽을 부드럽게 좁히세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vernauw zacht je keel achterin, alsof je met gesloten mond een spiegel laat beslaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estreite suavemente o fundo da garganta, como se embaçasse um espelho com a boca fechada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягко сузь заднюю часть горла, как будто хочешь затуманить зеркало дыханием с закрытым ртом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻轻收窄喉咙后部，就像闭着嘴对镜子哈气一样。"
          }
        }
      }
    },
    "technique.ujjayi.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 5 Sekunden ein und lausche dem sanften Geräusch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale for 5 seconds, listening to the soft sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala durante 5 segundos escuchando el suave sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire pendant 5 secondes en écoutant ce léger son."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira per 5 secondi, ascoltando il suono morbido."
          }
        },
        "ja" : {
          "stringUnit" : {
