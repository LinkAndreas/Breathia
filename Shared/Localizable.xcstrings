    "support.breathiaIsFree" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia ist kostenlos, ohne Werbung und ohne gesperrte Funktionen. Wenn dir die App hilft, kannst du ihre Pflege und die Entwicklung neuer Techniken und Funktionen unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia is free, with no ads and nothing locked. If it helps you, you can support its maintenance and the development of new techniques and features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia es gratuita, sin anuncios y sin nada bloqueado. Si te resulta útil, puedes apoyar su mantenimiento y el desarrollo de nuevas técnicas y funciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia est gratuit, sans publicité et sans fonction verrouillée. S'il vous aide, vous pouvez soutenir sa maintenance et le développement de nouvelles techniques et fonctionnalités."
          }
        }
      }
    },
