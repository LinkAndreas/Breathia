    "technique.moonBreath.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme sanft. Hör auf, wenn ein Nasenloch verstopft ist oder sich das Atmen angestrengt anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe gently. Stop if one nostril is blocked or breathing feels strained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con suavidad. Detente si tienes una fosa nasal tapada o si respirar te cuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire doucement. Arrête si une narine est bouchée ou si la respiration devient pénible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con delicatezza. Fermati se una narice è chiusa o se respirare ti costa fatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしく呼吸してください。片方の鼻が詰まっているときや、呼吸が苦しく感じるときは中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드럽게 호흡하세요. 한쪽 코가 막혔거나 호흡이 힘들게 느껴지면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem rustig. Stop als een neusgat verstopt is of het ademen inspannend voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire com suavidade. Pare se uma narina estiver entupida ou se respirar exigir esforço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыши мягко. Остановись, если одна ноздря заложена или дышать тяжело."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请轻柔地呼吸。如果一侧鼻孔堵塞或呼吸感到吃力，请停止练习。"
          }
        }
      }
    },
    "technique.moonBreath.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht hin und lege die linke Hand in den Schoß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright and rest your left hand in your lap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido y apoya la mano izquierda en el regazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi le dos droit et pose la main gauche sur tes genoux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti con la schiena dritta e appoggia la mano sinistra in grembo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背筋を伸ばして座り、左手をひざの上に置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "똑바로 앉아 왼손을 무릎 위에 편히 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga rechtop zitten en leg je linkerhand in je schoot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se com a coluna ereta e apoie a mão esquerda no colo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь прямо и положи левую руку на колени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐直，将左手放在腿上。"
          }
        }
      }
    },
    "technique.moonBreath.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das rechte Nasenloch mit dem rechten Daumen und atme 4 Sekunden links ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close your right nostril with your right thumb and inhale through the left for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa derecha con el pulgar derecho e inhala por la izquierda durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouche la narine droite avec le pouce droit et inspire par la gauche pendant 4 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi la narice destra con il pollice destro e inspira dalla sinistra per 4 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右手の親指で右の鼻をふさぎ、左の鼻から4秒間吸います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른손 엄지로 오른쪽 콧구멍을 막고 왼쪽으로 4초 동안 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit je rechterneusgat met je rechterduim en adem 4 seconden in door het linker."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche a narina direita com o polegar direito e inspire pela esquerda por 4 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрой правую ноздрю большим пальцем правой руки и вдыхай через левую 4 секунды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用右手拇指按住右鼻孔，用左鼻孔吸气 4 秒。"
          }
        }
      }
    },
    "technique.moonBreath.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das linke Nasenloch und atme 6 Sekunden rechts aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close the left nostril and exhale through the right for 6 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa izquierda y exhala por la derecha durante 6 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouche la narine gauche et expire par la droite pendant 6 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi la narice sinistra ed espira dalla destra per 6 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左の鼻をふさぎ、右の鼻から6秒間吐きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 콧구멍을 막고 오른쪽으로 6초 동안 내쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit het linkerneusgat en adem 6 seconden uit door het rechter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche a narina esquerda e expire pela direita por 6 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрой левую ноздрю и выдыхай через правую 6 секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住左鼻孔，用右鼻孔呼气 6 秒。"
          }
        }
      }
    },
    "technique.moonBreath.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole und atme immer links ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat, always inhaling on the left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite, inhalando siempre por la izquierda."
          }
        },
        "fr" : {
          "stringUnit" : {
