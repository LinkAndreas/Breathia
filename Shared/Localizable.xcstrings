    "whatsNew.charts.text" : {
      "comment" : "New feature description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einer Sitzung mit Herzfrequenzsensor siehst du Herzfrequenz und HRV Sekunde für Sekunde und wie dein Herz mit jedem Atemzug stieg und fiel – jeweils in einfachen Worten erklärt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a session with a heart-rate sensor, see your heart rate and HRV second by second, and how your heart rose and fell with each breath — each explained in plain words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una sesión con sensor de frecuencia cardiaca, ve tu frecuencia cardiaca y tu VFC segundo a segundo, y cómo tu corazón subió y bajó con cada respiración, todo explicado con palabras sencillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une séance avec un capteur de fréquence cardiaque, vois ta fréquence cardiaque et ta VFC seconde par seconde, et comment ton cœur a accéléré et ralenti à chaque respiration, le tout expliqué simplement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo una sessione con un sensore di frequenza cardiaca, vedi frequenza cardiaca e HRV secondo per secondo, e come il tuo cuore è salito e sceso a ogni respiro, il tutto spiegato con parole semplici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍センサーを使ったセッションのあとは、心拍数とHRVを1秒ごとに確認できます。さらに、呼吸ごとに心拍がどう上下したかもわかり、それぞれわかりやすい言葉で説明されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박 센서를 연결한 세션이 끝나면 심박수와 HRV를 초 단위로 보고, 호흡할 때마다 심박수가 어떻게 오르내렸는지 확인할 수 있어요. 모두 쉬운 말로 설명해 드려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie na een sessie met een hartslagsensor je hartslag en HRV seconde voor seconde, en hoe je hart bij elke ademhaling steeg en daalde – telkens uitgelegd in gewone woorden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de uma sessão com sensor de frequência cardíaca, veja sua frequência cardíaca e sua VFC segundo a segundo, e como seu coração subiu e desceu a cada respiração — tudo explicado em palavras simples."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сеанса с датчиком пульса смотри свой пульс и ВСР секунда за секундой и то, как сердце ускорялось и замедлялось с каждым вдохом и выдохом, — и всё это простыми словами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用心率传感器完成练习后，你可以逐秒查看心率和 HRV，以及每次呼吸时心率如何起伏——每一项都配有通俗易懂的说明。"
          }
        }
      }
    },
    "whatsNew.charts.title" : {
      "comment" : "New feature title",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
