    "onboarding.pairYourChestStrap" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopple einen Bluetooth-Herzfrequenzsensor wie den Polar H10, um beim Atmen echtes Feedback zu Herzfrequenz und HRV zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair a Bluetooth heart-rate sensor, like the Polar H10, to see real heart-rate and HRV feedback while you breathe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula un sensor de frecuencia cardiaca Bluetooth, como el Polar H10, para ver tu frecuencia cardiaca y VFC reales mientras respiras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associe un capteur de fréquence cardiaque Bluetooth, comme le Polar H10, pour voir ta fréquence cardiaque et ta VFC réelles pendant que tu respires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina un sensore di frequenza cardiaca Bluetooth, come il Polar H10, per vedere un feedback reale su frequenza cardiaca e HRV mentre respiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10などのBluetooth心拍センサーをペアリングすると、呼吸しながら実際の心拍数とHRVのフィードバックを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10 같은 Bluetooth 심박 센서를 연결하면 호흡하는 동안 실제 심박수와 HRV 피드백을 볼 수 있어요."
          }
        },
