        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar la respiración con una emoción positiva"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associer la respiration à une émotion positive"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unire il respiro a una sensazione positiva"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸とポジティブな感情を組み合わせたいとき"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡과 긍정적인 감정 함께하기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
