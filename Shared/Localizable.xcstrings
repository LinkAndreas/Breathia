    "technique.buteyko.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere 4 Sekunden vor dem nächsten Einatmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause for 4 seconds before the next inhale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pausa de 4 segundos antes de la siguiente inhalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais une pause de 4 secondes avant l'inspiration suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai una pausa di 4 secondi prima della prossima inspirazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に吸う前に4秒間止めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 들이쉬기 전에 4초 동안 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeer 4 seconden voor de volgende inademing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma pausa de 4 segundos antes da próxima inspiração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделай паузу на 4 секунды перед следующим вдохом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停顿 4 秒，再进行下一次吸气。"
          }
        }
      }
    },
    "technique.buteyko.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte jeden Atemzug leicht; vermeide tiefes oder erzwungenes Atmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep every breath light; avoid deep or forced breathing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén cada respiración ligera; evita respirar hondo o forzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde chaque respiration légère ; évite de respirer profondément ou de forcer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni ogni respiro leggero; evita di respirare in modo profondo o forzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの呼吸も軽く保ち、深い呼吸や無理な呼吸は避けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 호흡을 가볍게 유지하고, 깊거나 억지스러운 호흡은 피하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd elke ademhaling licht; vermijd diep of geforceerd ademen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha cada respiração leve; evite respirar fundo ou forçar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый вдох должен быть лёгким; избегай глубокого или форсированного дыхания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持每次呼吸都很轻柔；避免深呼吸或用力呼吸。"
          }
        }
      }
    },
