    "technique.altnostril.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditionell wird dabei jeweils ein Nasenloch verschlossen und abwechselnd geatmet. Hier ist das Timing zu einem gleichmäßigen Rhythmus mit vier Phasen vereinfacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditionally practiced by closing one nostril at a time and alternating breaths between them. Here the timing is simplified into a steady four-phase rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradicionalmente se practica tapando una fosa nasal cada vez y alternando las respiraciones entre ellas. Aquí el ritmo se simplifica en cuatro fases constantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditionnellement, on ferme une narine à la fois en alternant les respirations. Ici, le rythme est simplifié en quatre phases régulières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradizionalmente si pratica chiudendo una narice alla volta e alternando il respiro tra le due. Qui il ritmo è semplificato in un andamento regolare in quattro fasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伝統的には片方の鼻を交互にふさぎながら、左右の鼻で交互に呼吸します。ここでは、タイミングを一定の4つのフェーズのリズムにシンプルにしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전통적으로 한쪽 콧구멍을 번갈아 막으며 양쪽으로 교대로 호흡해요. 여기서는 타이밍을 일정한 4단계 리듬으로 단순화했어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditioneel sluit je hierbij telkens één neusgat af en adem je afwisselend door het ene en het andere. Hier is de timing vereenvoudigd tot een gelijkmatig ritme in vier fasen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradicionalmente, é praticada fechando uma narina de cada vez e alternando a respiração entre elas. Aqui, o tempo é simplificado em um ritmo constante de quatro fases."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Традиционно выполняется так: одну ноздрю закрывают и дышат попеременно то через одну, то через другую. Здесь ритм упрощён до ровного цикла из четырёх фаз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传统做法是每次闭合一侧鼻孔，两侧鼻孔交替呼吸。这里将节奏简化为稳定的四个阶段。"
          }
        }
      }
    },
