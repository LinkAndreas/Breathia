    "technique.coherent.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich 6 Sekunden zu lang anfühlen, beginne mit der Resonanzatmung mit 5 Sekunden und steigere dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If 6 seconds feels too long, start with Resonance Breathing at 5 seconds and work up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 6 segundos te parecen demasiado, empieza con la respiración de resonancia a 5 segundos y ve aumentando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 6 secondes vous semblent trop longues, commencez par la respiration de résonance à 5 secondes et progressez."
          }
        }
      }
    },
    "technique.coherent.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht hin und lass die Schultern sinken."
          }
        },
