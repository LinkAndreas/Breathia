    "technique.ujjayi.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leichte Verengung im hinteren Rachen erzeugt bei jedem Atemzug ein sanftes, flüsterndes Geräusch, wie fernes Meeresrauschen. Das Geräusch gibt dir etwas, dem du folgen kannst, und verlangsamt den Atem ganz natürlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slight narrowing at the back of the throat creates a soft, whispering sound on each breath, like distant waves. The sound gives you something to follow and naturally slows the breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ligero estrechamiento en la parte posterior de la garganta crea un sonido suave, como un susurro, en cada respiración, parecido a olas lejanas. Ese sonido te da algo que seguir y ralentiza la respiración de forma natural."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger resserrement au fond de la gorge produit à chaque respiration un son doux et chuchoté, comme des vagues au loin. Ce son vous donne un repère à suivre et ralentit naturellement le souffle."
          }
        }
      }
    },
    "technique.ujjayi.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ozeanatmung (Ujjayi)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocean Breath (Ujjayi)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración oceánica (Ujjayi)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration océanique (Ujjayi)"
          }
        }
      }
    },
    "technique.ujjayi.purpose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhiger, geerdeter Fokus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm and grounded focus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentración serena y centrada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentration calme et ancrée"
          }
        }
      }
    },
    "technique.ujjayi.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Rachen weich – das Geräusch soll leise sein, nie angestrengt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the throat soft — the sound should be quiet, never strained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la garganta relajada: el sonido debe ser suave, nunca forzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la gorge détendue : le son doit rester discret, jamais forcé."
          }
        }
      }
    },
    "technique.ujjayi.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme durch die Nase ein und aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in and out through your nose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala y exhala por la nariz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez et expirez par le nez."
          }
        }
      }
    },
    "technique.ujjayi.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verenge sanft den hinteren Rachen, als wolltest du mit geschlossenem Mund einen Spiegel anhauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gently narrow the back of your throat, as if fogging a mirror with your mouth closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrecha suavemente la parte posterior de la garganta, como si empañaras un espejo con la boca cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resserrez doucement le fond de la gorge, comme pour embuer un miroir la bouche fermée."
          }
        }
      }
    },
    "technique.ujjayi.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 5 Sekunden ein und lausche dem sanften Geräusch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale for 5 seconds, listening to the soft sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala durante 5 segundos escuchando el suave sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez pendant 5 secondes en écoutant ce léger son."
          }
        }
      }
    },
    "technique.ujjayi.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 5 Sekunden mit demselben Geräusch aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale for 5 seconds with the same sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala durante 5 segundos con el mismo sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez pendant 5 secondes avec le même son."
          }
        }
      }
    },
    "technique.ujjayi.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsames Atmen mit einem sanften Rauschen wie das Meer"
          }
        },
        "en" : {
          "stringUnit" : {
