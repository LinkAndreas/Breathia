    "technique.buteyko.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Atemzüge bleiben klein und leicht durch die Nase, gefolgt von einer kurzen Pause nach dem Ausatmen. Ziel ist ein geringeres Atemvolumen statt tiefer Atemzüge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaths are kept small and light through the nose, followed by a brief pause after the exhale. The aim is reduced breathing volume rather than deep breaths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respiraciones son pequeñas y ligeras por la nariz, con una breve pausa tras la exhalación. El objetivo es reducir el volumen respiratorio en lugar de respirar hondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les respirations restent petites et légères par le nez, suivies d'une brève pause après l'expiration. L'objectif est de réduire le volume respiratoire plutôt que de respirer profondément."
          }
        }
      }
    },
    "technique.buteyko.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
