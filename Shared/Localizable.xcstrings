    "technique.recovery.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Sport hilft langsame Nasenatmung mit längerem Ausatmen, die Atmung wieder unter Kontrolle zu bringen. Sportler nutzen sie zwischen Sätzen und nach dem Training, um von Anstrengung auf Erholung umzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After exercise, slow nasal breathing with a longer exhale helps bring your breathing back under control. Athletes use it between sets and after training to shift from effort to recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después del ejercicio, respirar despacio por la nariz con una exhalación más larga ayuda a recuperar el control de la respiración. Los deportistas la usan entre series y al terminar para pasar del esfuerzo a la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l'effort, une respiration nasale lente avec une expiration plus longue aide à reprendre le contrôle du souffle. Les sportifs l'utilisent entre les séries et après l'entraînement pour passer de l'effort à la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo l’attività fisica, una respirazione nasale lenta con un’espirazione più lunga aiuta a riprendere il controllo del respiro. Gli atleti la usano tra le serie e dopo l’allenamento per passare dallo sforzo al recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動後に、吐く息を長めにしてゆっくり鼻で呼吸すると、呼吸を落ち着けやすくなります。アスリートはセットの合間やトレーニング後に、この呼吸で運動から回復へと切り替えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 후에 날숨을 더 길게 하는 느린 코 호흡을 하면 호흡을 다시 안정시키는 데 도움이 돼요. 운동선수들은 세트 사이와 훈련 후에 이 호흡으로 운동 상태에서 회복 상태로 전환해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het sporten helpt langzame neusademhaling met een langere uitademing om je ademhaling weer onder controle te krijgen. Sporters gebruiken het tussen sets en na de training om van inspanning naar herstel over te schakelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois do exercício, respirar devagar pelo nariz, com uma expiração mais longa, ajuda a recuperar o controle da respiração. Atletas usam essa técnica entre as séries e após o treino para passar do esforço à recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После нагрузки медленное дыхание носом с более долгим выдохом помогает снова взять дыхание под контроль. Спортсмены используют его между подходами и после тренировки, чтобы переключиться с усилия на восстановление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动后，以较长的呼气进行缓慢的鼻呼吸，有助于让呼吸重新平稳下来。运动员会在组间和训练后使用这种方法，从发力状态过渡到恢复状态。"
          }
        }
      }
    },
