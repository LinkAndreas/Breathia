    "technique.heartFocused.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du atmest langsam und gleichmäßig und stellst dir vor, dass der Atem durch den Bereich um dein Herz ein- und ausströmt. Ein gleichmäßiger Rhythmus zusammen mit einem ruhigen Fokus ist eine beliebte Methode, um einen ausgeglichenen, kohärenten Herzrhythmus zu fördern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You breathe slowly and evenly while imagining the breath flowing in and out through the area around your heart. Pairing a steady rhythm with a calm focus is a popular way to encourage a smooth, coherent heart rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiras despacio y de forma uniforme mientras imaginas que el aire entra y sale por la zona que rodea el corazón. Combinar un ritmo constante con una atención tranquila es una forma popular de favorecer un ritmo cardiaco suave y coherente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous respirez lentement et régulièrement en imaginant que l'air entre et sort par la zone autour de votre cœur. Associer un rythme régulier à une attention calme est une façon répandue de favoriser un rythme cardiaque fluide et cohérent."
          }
        }
      }
    },
    "technique.heartFocused.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfokussierte Atmung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart-Focused Breathing"
          }
        },
        "es" : {
