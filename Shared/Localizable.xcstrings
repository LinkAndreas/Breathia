    "technique.box.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Atemphase dauert gleich lang, was dem Atem einen gleichmäßigen, vorhersehbaren Rhythmus gibt. Vielen fällt es leichter, sich in diesen Rhythmus einzufinden, als ohne Struktur „langsam“ zu atmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each phase of the breath lasts the same length of time, which gives the breath a steady, predictable rhythm. Many people find that rhythm easier to settle into than trying to breathe \"slowly\" without a structure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fase de la respiración dura lo mismo, lo que le da a la respiración un ritmo estable y predecible. A muchas personas les resulta más fácil adaptarse a ese ritmo que intentar respirar «despacio» sin una estructura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque phase de la respiration dure le même temps, ce qui lui donne un rythme régulier et prévisible. Beaucoup trouvent ce rythme plus facile à adopter que d'essayer de respirer « lentement » sans structure."
          }
        }
      }
    },
