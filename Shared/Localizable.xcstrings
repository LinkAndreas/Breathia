          }
        }
      }
    },
    "technique.bellows.purpose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belebend"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energizing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energizante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamisante"
          }
        }
      }
    },
    "technique.bellows.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht geeignet in der Schwangerschaft oder bei Bluthochdruck, Herzerkrankungen oder Epilepsie. Hör sofort auf, wenn dir schwindlig wird oder es kribbelt, und übe nie beim Autofahren oder im Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not suitable during pregnancy or with high blood pressure, heart conditions, or epilepsy. Stop immediately if you feel dizzy or tingly, and never practice while driving or in water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es adecuada durante el embarazo ni en caso de hipertensión, problemas cardiacos o epilepsia. Detente de inmediato si notas mareo u hormigueo, y nunca la practiques mientras conduces o estás en el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconseillée pendant la grossesse et en cas d'hypertension, de maladie cardiaque ou d'épilepsie. Arrêtez immédiatement en cas de vertiges ou de fourmillements, et ne pratiquez jamais en conduisant ou dans l'eau."
          }
        }
      }
    },
    "technique.bellows.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitz aufrecht mit entspannten Schultern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit tall with your shoulders relaxed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido con los hombros relajados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous bien droit, les épaules détendues."
          }
        }
      }
    },
    "technique.bellows.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 1 Sekunde kräftig durch die Nase ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale forcefully through your nose for 1 second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala con fuerza por la nariz durante 1 segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez vigoureusement par le nez pendant 1 seconde."
          }
        }
      }
    },
    "technique.bellows.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 1 Sekunde kräftig durch die Nase aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale forcefully through your nose for 1 second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
