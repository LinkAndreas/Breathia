    "technique.humming.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden lang aus und summe dabei sanft mit geschlossenen Lippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale for 6 seconds while humming gently, lips closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala durante 6 segundos tarareando suavemente con los labios cerrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expire pendant 6 secondes en fredonnant doucement, lèvres fermées."
          }
        },
