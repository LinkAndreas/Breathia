    "technique.lion.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme kräftig, aber angenehm aus. Ein paar Runden reichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the exhale strong but comfortable. A few rounds are enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz la exhalación enérgica pero cómoda. Bastan unas pocas rondas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez une expiration puissante mais confortable. Quelques séries suffisent."
          }
        }
      }
    },
    "technique.lion.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie oder setz dich bequem hin, die Hände auf den Knien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kneel or sit comfortably with your hands on your knees."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate o siéntate cómodamente con las manos sobre las rodillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenouillez-vous ou asseyez-vous confortablement, les mains sur les genoux."
          }
        }
      }
    },
    "technique.lion.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden tief durch die Nase ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale deeply through your nose for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala profundamente por la nariz durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez profondément par le nez pendant 4 secondes."
          }
        }
      }
    },
    "technique.lion.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Mund weit, streck die Zunge heraus und atme 3 Sekunden kräftig mit einem „Ha“ aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your mouth wide, stick out your tongue, and exhale forcefully with a 'ha' sound for 3 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre bien la boca, saca la lengua y exhala con fuerza con un sonido «ja» durante 3 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez grand la bouche, tirez la langue et expirez fortement avec un « ha » pendant 3 secondes."
          }
        }
      }
    },
    "technique.lion.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspanne dein Gesicht und wiederhole das ein paar Mal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relax your face and repeat a few times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaja la cara y repite unas cuantas veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détendez votre visage et répétez quelques fois."
          }
        }
      }
    },
    "technique.lion.summary" : {
      "localizations" : {
        "de" : {
