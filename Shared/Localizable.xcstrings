    "report.breaths.explanation" : {
      "comment" : "Explains the swing per breath chart",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einatmen schlägt dein Herz schneller, beim Ausatmen langsamer. Größere Schwankungen bedeuten meist, dass du entspannt bist und im Einklang mit deinem Herzen atmest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing in speeds your heart up, breathing out slows it down. Bigger swings usually mean you're relaxed and breathing in tune with your heart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al inspirar, el corazón se acelera y al espirar se ralentiza. Oscilaciones mayores suelen indicar que estás relajado y respiras en sintonía con tu corazón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inspiration accélère le cœur, l'expiration le ralentit. Des variations plus grandes signifient généralement une respiration détendue, en accord avec ton cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirare accelera il cuore, espirare lo rallenta. Oscillazioni più ampie di solito indicano rilassamento e un respiro in sintonia con il cuore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吸うと心拍は速くなり、吐くと遅くなります。この揺れが大きいほど、たいていはリラックスして心臓と呼吸が調和している状態です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨을 들이쉬면 심장이 빨라지고, 내쉬면 느려져요. 변동 폭이 클수록 대개 몸이 이완되어 있고 호흡이 심장과 잘 맞고 있다는 뜻이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het inademen gaat je hart sneller slaan, bij het uitademen langzamer. Grotere schommelingen betekenen meestal dat je ontspannen bent en in harmonie met je hart ademt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao inspirar, o coração acelera; ao expirar, ele desacelera. Oscilações maiores costumam indicar que você está relaxado e respirando em sintonia com o coração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдох ускоряет сердце, выдох замедляет его. Чем больше колебания, тем обычно глубже расслабление и тем лучше дыхание совпадает с ритмом сердца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸气时心跳加快，呼气时心跳减慢。波动越大，通常说明你越放松，呼吸与心跳越合拍。"
          }
        }
      }
    },
    "report.breaths.grew" : {
      "comment" : "Shown when the swing per breath grew during the session",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schwankungen wurden im Lauf der Sitzung größer – ein Zeichen, dass du in den Rhythmus gefunden hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The swings grew as the session went on — a sign you settled into the rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las oscilaciones crecieron a lo largo de la sesión: señal de que encontraste el ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variations ont augmenté au fil de la séance : signe que tu as trouvé le rythme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le oscillazioni sono cresciute nel corso della sessione: segno che hai trovato il ritmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが進むにつれて揺れが大きくなりました。リズムに落ち着いてきたしるしです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 진행될수록 변동 폭이 커졌어요. 리듬에 잘 자리 잡았다는 신호예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schommelingen werden in de loop van de sessie groter – een teken dat je in het ritme kwam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As oscilações aumentaram ao longo da sessão — sinal de que você entrou no ritmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колебания росли по ходу сеанса — признак того, что дыхание вошло в ритм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随着练习进行，波动逐渐增大——这说明你已融入了节奏。"
          }
        }
      }
    },
    "report.breaths.summary %lld" : {
      "comment" : "Summary of the swing per breath",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
