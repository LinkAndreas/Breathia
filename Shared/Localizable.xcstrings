    "technique.relax.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden langsam aus und lass den Atem sanft auslaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale slowly for 6 seconds, letting the breath trail off gently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala despacio durante 6 segundos, dejando que el aire salga suavemente."
          }
        },
        "fr" : {
