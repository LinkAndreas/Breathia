    "technique.humming.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen wird mit einem sanften Summen verlängert, das den Vagusnerv sanft anregen und einen ruhigeren Zustand fördern soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exhale is drawn out with a soft humming sound, which is thought to gently stimulate the vagus nerve and encourage a calmer state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exhalación se alarga con un suave zumbido, que se cree que estimula suavemente el nervio vago y favorece un estado más tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration est prolongée par un léger bourdonnement, qui stimulerait doucement le nerf vague et favoriserait un état plus calme."
          }
        }
      }
    },
