    "technique.sitali.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luft, die über die gerollte Zunge eingeatmet wird, fühlt sich kühl an; darauf folgt ein langsames Ausatmen durch die Nase. Die Übung wird traditionell genutzt, um abzukühlen und den Geist zu beruhigen, besonders bei warmem Wetter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air drawn in over a curled tongue feels cool, and a slow exhale through the nose follows. The practice is traditionally used to cool down and calm the mind, especially in warm weather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aire que entra por la lengua enrollada se siente fresco y le sigue una exhalación lenta por la nariz. Tradicionalmente se usa para refrescarse y calmar la mente, sobre todo cuando hace calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'air aspiré sur la langue roulée paraît frais, puis vient une expiration lente par le nez. Cette pratique sert traditionnellement à se rafraîchir et à apaiser l'esprit, surtout par temps chaud."
          }
        }
      }
    },
    "technique.sitali.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kühlende Atmung (Sitali)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cooling Breath (Sitali)"
          }
        },
        "es" : {
          "stringUnit" : {
