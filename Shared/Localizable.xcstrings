    "report.hrv.explanation" : {
      "comment" : "Explains HRV under its chart",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV misst die winzigen Unterschiede im Abstand zwischen Herzschlägen. Höhere Werte bedeuten meist, dass dein Körper entspannter ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV measures the tiny differences in time between heartbeats. Higher values usually mean your body is more relaxed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VFC mide las pequeñas diferencias de tiempo entre latidos. Valores más altos suelen indicar que tu cuerpo está más relajado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VFC mesure les infimes différences de temps entre les battements. Des valeurs plus élevées signifient généralement que ton corps est plus détendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’HRV misura le minime differenze di tempo tra un battito e l’altro. Valori più alti di solito indicano che il corpo è più rilassato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRVは心拍と心拍の間隔のわずかな差を測定したものです。値が高いほど、たいていは体がリラックスしている状態です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV는 심장 박동 사이의 아주 작은 시간 차이를 측정해요. 값이 높을수록 대개 몸이 더 이완되어 있다는 뜻이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV meet de kleine tijdsverschillen tussen hartslagen. Hogere waarden betekenen meestal dat je lichaam meer ontspannen is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VFC mede as pequenas diferenças de tempo entre os batimentos. Valores mais altos costumam indicar que seu corpo está mais relaxado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ВСР измеряет крошечные различия во времени между ударами сердца. Более высокие значения обычно означают, что тело более расслаблено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 衡量的是心跳之间极其细微的时间差异。数值越高，通常说明身体越放松。"
          }
        }
      }
    },
