    "technique.twoToOne.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich 8 Sekunden anstrengend anfühlen, versuche 3 Sekunden ein und 6 Sekunden aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If 8 seconds feels like a strain, try 3 seconds in and 6 seconds out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 8 segundos te cuestan, prueba 3 segundos al inhalar y 6 al exhalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 8 secondes te demandent un effort, essaie 3 secondes à l'inspiration et 6 à l'expiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se 8 secondi ti affaticano, prova 3 secondi di inspirazione e 6 di espirazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8秒がつらい場合は、3秒吸って6秒吐くようにしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8초가 힘들게 느껴지면 3초 들이쉬고 6초 내쉬어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als 8 seconden zwaar voelt, probeer dan 3 seconden in en 6 seconden uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se 8 segundos exigirem esforço, experimente 3 segundos ao inspirar e 6 ao expirar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если 8 секунд даются с трудом, попробуй 3 секунды на вдох и 6 секунд на выдох."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 8 秒感觉吃力，可以尝试吸气 3 秒、呼气 6 秒。"
          }
        }
      }
    },
    "technique.twoToOne.steps.1" : {
      "localizations" : {
