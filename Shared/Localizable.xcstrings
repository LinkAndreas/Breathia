    "technique.humming.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen wird mit einem sanften Summen verlängert, das den Vagusnerv sanft anregen und einen ruhigeren Zustand fördern soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exhale is drawn out with a soft humming sound, which is thought to gently stimulate the vagus nerve and encourage a calmer state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exhalación se alarga con un suave zumbido, que se cree que estimula suavemente el nervio vago y favorece un estado más tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration est prolongée par un léger bourdonnement, qui stimulerait doucement le nerf vague et favoriserait un état plus calme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espirazione viene prolungata con un leggero ronzio, che si ritiene stimoli delicatamente il nervo vago e favorisca uno stato più calmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やわらかなハミングの音とともに、長く息を吐きます。迷走神経をやさしく刺激し、より穏やかな状態を促すと考えられています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 허밍 소리와 함께 길게 내쉬어요. 이 소리가 미주신경을 부드럽게 자극해 더 차분한 상태로 이끈다고 알려져 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De uitademing wordt verlengd met een zacht neuriegeluid, waarvan wordt aangenomen dat het de nervus vagus zacht stimuleert en een rustigere toestand bevordert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A expiração é prolongada com um zumbido suave, que, acredita-se, estimula levemente o nervo vago e favorece um estado mais calmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдох растягивается с мягким жужжащим звуком, который, как считается, мягко стимулирует блуждающий нерв и помогает прийти в более спокойное состояние."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼气时伴随轻柔的哼鸣声并拉长，一般认为这能温和地刺激迷走神经，帮助进入更平静的状态。"
          }
        }
      }
    },
