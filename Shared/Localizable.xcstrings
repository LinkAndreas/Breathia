    "technique.belly.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du mit dem Zwerchfell statt mit der Brust atmest, kann sich der Bauch beim Einatmen ganz ausdehnen. Darauf bauen die meisten anderen Atemtechniken auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing from the diaphragm instead of the chest lets the belly expand fully on the inhale. It is the foundation most other breathing techniques build on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar con el diafragma en lugar del pecho permite que el abdomen se expanda por completo al inhalar. Es la base de la mayoría de las demás técnicas de respiración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirer avec le diaphragme plutôt qu'avec la poitrine permet au ventre de se gonfler pleinement à l'inspiration. C'est la base de la plupart des autres techniques de respiration."
          }
        }
      }
    },
    "technique.belly.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwerchfellatmung"
