    "sensor.moistenTheStrapsElectrodes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg deinen Sensor an – bei einem Brustgurt befeuchte vorher die Elektroden. Die meisten Sensoren, wie der Polar H10, erscheinen nur, solange sie einen Herzschlag erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your sensor on — for a chest strap, moisten the electrodes first. Most sensors, like the Polar H10, only show up while they detect a heartbeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte el sensor; si es una correa pectoral, humedece antes los electrodos. La mayoría de los sensores, como el Polar H10, solo aparecen mientras detectan un latido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets ton capteur ; pour une ceinture thoracique, humidifie d'abord les électrodes. La plupart des capteurs, comme le Polar H10, n'apparaissent que lorsqu'ils détectent un battement de cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indossa il sensore: se è una fascia toracica, inumidisci prima gli elettrodi. La maggior parte dei sensori, come il Polar H10, compare solo quando rileva un battito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーを装着してください。胸部ストラップの場合は、先に電極を湿らせます。Polar H10などほとんどのセンサーは、心拍を検出しているあいだだけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서를 착용하세요. 가슴 스트랩이라면 먼저 전극을 적셔 주세요. Polar H10 같은 대부분의 센서는 심장 박동을 감지할 때만 목록에 나타나요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe je sensor om – bevochtig bij een borstband eerst de elektroden. De meeste sensoren, zoals de Polar H10, verschijnen alleen zolang ze een hartslag detecteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o sensor — se for uma cinta peitoral, umedeça os eletrodos antes. A maioria dos sensores, como o Polar H10, só aparece enquanto detecta batimentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надень датчик — если это нагрудный ремень, сначала смочи электроды. Большинство датчиков, например Polar H10, появляются, только когда улавливают сердцебиение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戴上传感器——如果是胸带，请先润湿电极。大多数传感器（如 Polar H10）只有在检测到心跳时才会出现。"
          }
        }
      }
    },
    "sensor.nearbySensors" : {
      "localizations" : {
