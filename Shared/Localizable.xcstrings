    "technique.altnostril.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme durchgehend sanft. Lass die Pausen weg, wenn sich das Anhalten unangenehm anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe gently throughout. Skip the holds if breath-holding feels uncomfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con suavidad en todo momento. Omite las retenciones si te resultan incómodas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirez doucement tout du long. Supprimez les rétentions si retenir votre souffle est inconfortable."
          }
        }
      }
    },
    "technique.altnostril.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht und bequem hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright in a comfortable position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido en una posición cómoda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous droit dans une position confortable."
          }
        }
