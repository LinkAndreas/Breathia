    "technique.threePart.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Einatmen füllt die Lunge in drei Stufen – erst den Bauch, dann die Rippen, dann die obere Brust –, gefolgt von einem langen, gleichmäßigen Ausatmen. So lernst du, dein volles Atemvolumen zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each inhale fills the lungs in three stages — belly, then ribs, then upper chest — followed by one long, smooth exhale. It teaches you to use your full breathing capacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inhalación llena los pulmones en tres etapas (primero el abdomen, luego las costillas y después la parte alta del pecho) y le sigue una exhalación larga y suave. Te enseña a usar toda tu capacidad respiratoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque inspiration remplit les poumons en trois étapes — le ventre, puis les côtes, puis le haut de la poitrine — suivie d'une longue expiration fluide. Elle vous apprend à utiliser toute votre capacité respiratoire."
          }
        }
      }
    },
    "technique.threePart.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreistufige Atmung (Dirga)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three-Part Breath (Dirga)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración en tres partes (Dirga)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration en trois temps (Dirga)"
          }
        }
      }
    },
    "technique.threePart.purpose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volles, achtsames Atmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full, mindful breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración completa y consciente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une respiration complète et consciente"
          }
        }
      }
    },
    "technique.threePart.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme sanft – es geht um Fülle, nicht um Kraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe gently — the aim is fullness, not force."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con suavidad: se busca plenitud, no fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirez doucement : l'objectif est l'amplitude, pas la force."
          }
        }
      }
    },
    "technique.threePart.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz oder leg dich bequem hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or lie down comfortably."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o túmbate cómodamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous ou allongez-vous confortablement."
          }
        }
      }
    },
    "technique.threePart.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 2 Sekunden in den Bauch ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale into your belly for 2 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala hacia el abdomen durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez dans le ventre pendant 2 secondes."
          }
        }
      }
    },
    "technique.threePart.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 2 Sekunden weiter in die Rippen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue inhaling into your ribs for 2 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue inhalando hacia las costillas durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez d'inspirer dans les côtes pendant 2 secondes."
          }
        }
      }
    },
    "technique.threePart.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende das Einatmen 2 Sekunden lang in der oberen Brust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
