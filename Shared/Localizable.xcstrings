    "technique.buteyko.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzwinge die Pause nie und dehne sie nicht bis zum Unwohlsein aus. Hör auf, wenn du kurzatmig wirst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never force or extend the pause to discomfort. Stop if you feel short of breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca fuerces ni alargues la pausa hasta sentir incomodidad. Detente si te falta el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne forcez jamais la pause et ne la prolongez pas jusqu'à l'inconfort. Arrêtez si vous êtes à bout de souffle."
          }
        }
      }
    },
    "technique.buteyko.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 3 Sekunden sanft durch die Nase ein – weniger als bei einem normalen Atemzug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in gently through your nose for 3 seconds — smaller than a normal breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala suavemente por la nariz durante 3 segundos, menos que en una respiración normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez doucement par le nez pendant 3 secondes, moins qu'une respiration normale."
          }
        }
      }
    },
    "technique.buteyko.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 3 Sekunden sanft aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale gently for 3 seconds."
          }
        },
        "es" : {
