    "whatsNew.feedback.text" : {
      "comment" : "New feature description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerte Breathia, schick eine Idee oder teile die App mit Freunden – jederzeit im neuen Bereich „Feedback“ in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate Breathia, send an idea or share the app with a friend — any time, from the new Feedback section in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valora Breathia, envía una idea o comparte la app con un amigo, cuando quieras, desde la nueva sección Comentarios de Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note Breathia, envoie une idée ou partage l'app avec un ami, à tout moment, depuis la nouvelle section Ton avis des Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta Breathia, invia un’idea o condividi l’app con un amico, quando vuoi, dalla nuova sezione Feedback in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaを評価したり、アイデアを送ったり、友達とAppを共有したりできます。「設定」の新しい「フィードバック」セクションからいつでもどうぞ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia를 평가하고, 아이디어를 보내고, 친구에게 앱을 공유해 보세요. 설정의 새로운 피드백 섹션에서 언제든지 할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beoordeel Breathia, stuur een idee of deel de app met een vriend – altijd, via het nieuwe onderdeel ‘Feedback’ in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalie o Breathia, envie uma ideia ou compartilhe o app com um amigo — quando quiser, na nova seção Feedback dos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцени Breathia, отправь идею или поделись приложением с другом — в любое время в новом разделе «Отзывы» в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”新增的“反馈”部分，你可以随时为 Breathia 评分、提出想法，或将 App 分享给朋友。"
          }
        }
      }
    },
