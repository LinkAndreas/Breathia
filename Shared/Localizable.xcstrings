    "technique.sigh.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Zyklen reichen meist aus. Kehre zur normalen Atmung zurück, wenn du außer Atem bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few cycles are usually enough. Return to normal breathing if you feel out of breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente bastan unos pocos ciclos. Vuelve a respirar con normalidad si te falta el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques cycles suffisent généralement. Revenez à une respiration normale si vous êtes essoufflé."
          }
        }
      }
    },
    "technique.sigh.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme normal durch die Nase ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a normal inhale through your nose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una inhalación normal por la nariz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez normalement par le nez."
          }
        }
      }
    },
    "technique.sigh.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm, ohne auszuatmen, einen zweiten, kürzeren Atemzug obendrauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without exhaling, take a second, shorter sip of air on top of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin exhalar, toma un segundo sorbo de aire más corto encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans expirer, prenez une seconde bouffée d'air plus courte par-dessus."
          }
        }
      }
    },
    "technique.sigh.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme langsam und vollständig durch den Mund aus."
          }
        },
        "en" : {
          "stringUnit" : {
