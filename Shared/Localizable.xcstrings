    },
    "technique.altnostril.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden durch ein Nasenloch ein (traditionell wird das andere mit einem Finger verschlossen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through one nostril for 4 seconds (traditionally closing the other with a finger)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por una fosa nasal durante 4 segundos (tradicionalmente, tapando la otra con un dedo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez par une narine pendant 4 secondes (traditionnellement en bouchant l'autre avec un doigt)."
          }
        }
      }
    },
    "technique.altnostril.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte kurz für 2 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold briefly for 2 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retén brevemente durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retenez brièvement pendant 2 secondes."
          }
        }
      }
    },
    "technique.altnostril.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden durch das andere Nasenloch aus und halte dann 2 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale through the other nostril for 4 seconds, then hold for 2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala por la otra fosa nasal durante 4 segundos y retén 2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez par l'autre narine pendant 4 secondes, puis retenez 2 secondes."
          }
        }
      }
    },
    "technique.altnostril.steps.5" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
