    "technique.buteyko.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Atemzüge bleiben klein und leicht durch die Nase, gefolgt von einer kurzen Pause nach dem Ausatmen. Ziel ist ein geringeres Atemvolumen statt tiefer Atemzüge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaths are kept small and light through the nose, followed by a brief pause after the exhale. The aim is reduced breathing volume rather than deep breaths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respiraciones son pequeñas y ligeras por la nariz, con una breve pausa tras la exhalación. El objetivo es reducir el volumen respiratorio en lugar de respirar hondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les respirations restent petites et légères par le nez, suivies d'une brève pause après l'expiration. L'objectif est de réduire le volume respiratoire plutôt que de respirer profondément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I respiri restano piccoli e leggeri, dal naso, seguiti da una breve pausa dopo l’espirazione. L’obiettivo è ridurre il volume respiratorio invece di fare respiri profondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻から小さく軽く呼吸し、吐いたあとに短く止めます。深い呼吸ではなく、呼吸量を減らすことを目指します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 작고 가볍게 호흡하고, 내쉰 뒤에 잠시 멈춰요. 깊이 호흡하는 것이 아니라 호흡량을 줄이는 것이 목표예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ademhalingen blijven klein en licht door de neus, gevolgd door een korte pauze na het uitademen. Het doel is een kleiner ademvolume in plaats van diepe ademhalingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respirações são pequenas e leves, pelo nariz, seguidas de uma breve pausa após a expiração. O objetivo é reduzir o volume de ar, e não respirar fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдохи остаются маленькими и лёгкими, через нос, а после выдоха следует короткая пауза. Цель — уменьшить объём дыхания, а не дышать глубоко."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子进行细小、轻柔的呼吸，呼气后短暂停顿。目的是减少呼吸量，而不是深呼吸。"
          }
        }
      }
    },
