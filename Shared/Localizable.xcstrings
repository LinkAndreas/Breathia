    "settings.history.footer" : {
      "comment" : "Footer under the button that deletes every session",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Sitzungen aus dem Verlauf auf diesem Gerät. Eine einzelne Sitzung löschst du, indem du sie im Verlauf nach links wischst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes every session from History on this device. To delete a single session, swipe it to the left in History."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todas las sesiones del historial de este dispositivo. Para eliminar solo una, deslízala hacia la izquierda en Historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les séances de l'Historique sur cet appareil. Pour en supprimer une seule, balaie-la vers la gauche dans l'Historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutte le sessioni dalla cronologia su questo dispositivo. Per eliminare una singola sessione, scorrila verso sinistra nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの履歴からすべてのセッションを削除します。1つのセッションだけを削除するには、「履歴」でそのセッションを左にスワイプします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 기록에서 모든 세션을 삭제해요. 세션을 하나만 삭제하려면 기록에서 해당 세션을 왼쪽으로 쓸어넘기세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle sessies uit de geschiedenis op dit apparaat. Wil je één sessie verwijderen, veeg die dan in Geschiedenis naar links."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as sessões do Histórico neste dispositivo. Para apagar uma única sessão, deslize-a para a esquerda no Histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все сеансы из Истории на этом устройстве. Чтобы удалить один сеанс, смахни его влево в Истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此设备的历史记录中删除所有练习。如需删除单次练习，请在“历史记录”中将其向左轻扫。"
          }
        }
      }
    },
