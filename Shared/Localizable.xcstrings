    "technique.lion.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem tiefen Einatmen durch die Nase atmest du kräftig durch den weit geöffneten Mund aus, streckst die Zunge heraus und machst dabei ein „Ha“. Das löst Spannungen in Gesicht und Kiefer und kann sich überraschend befreiend anfühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a deep inhale through the nose, you exhale forcefully through a wide-open mouth with your tongue stretched out, making a 'ha' sound. It releases tension in the face and jaw and can feel surprisingly freeing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una inhalación profunda por la nariz, exhalas con fuerza por la boca bien abierta, con la lengua estirada hacia fuera y emitiendo un sonido «ja». Libera la tensión de la cara y la mandíbula y puede resultar sorprendentemente liberador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une inspiration profonde par le nez, vous expirez fortement par la bouche grande ouverte, langue tirée, en émettant un « ha ». Cela relâche les tensions du visage et de la mâchoire et peut être étonnamment libérateur."
          }
        }
      }
    },
    "technique.lion.name" : {
      "localizations" : {
