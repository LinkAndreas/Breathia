    "settings.info.bluetoothIsUsedSolely" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wird ausschließlich für die Verbindung mit deinem Herzfrequenzsensor verwendet. Die App sucht nicht nach anderen Geräten und sammelt keine Informationen über sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth is used solely to talk to your heart-rate sensor. The app doesn't scan for or collect information about any other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth se usa únicamente para comunicarse con tu sensor de frecuencia cardiaca. La app no busca otros dispositivos ni recopila información sobre ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Bluetooth sert uniquement à communiquer avec ton capteur de fréquence cardiaque. L'app ne recherche aucun autre appareil et ne collecte aucune information à leur sujet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Bluetooth serve solo a comunicare con il tuo sensore di frequenza cardiaca. L’app non cerca né raccoglie informazioni su altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetoothは心拍センサーとの通信にのみ使用されます。本Appがほかのデバイスを探したり、その情報を収集したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth는 오직 심박 센서와 통신하는 데에만 사용돼요. 앱은 다른 기기를 검색하거나 다른 기기의 정보를 수집하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wordt uitsluitend gebruikt om met je hartslagsensor te communiceren. De app zoekt niet naar andere apparaten en verzamelt geen informatie over ze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bluetooth é usado apenas para se comunicar com seu sensor de frequência cardíaca. O app não procura outros dispositivos nem coleta informações sobre eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth используется только для связи с твоим датчиком пульса. Приложение не ищет другие устройства и не собирает о них никакой информации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝牙仅用于与你的心率传感器通信。App 不会扫描或收集任何其他设备的信息。"
          }
        }
      }
    },
