    "settings.eachCompletedBreathingSession" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia nutzt Apple Health (HealthKit), um jede abgeschlossene Atemsitzung als Achtsamkeitsminuten zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Apple Health (HealthKit) to save each completed breathing session as mindful minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa la app Salud (HealthKit) para guardar cada sesión de respiración completada como minutos de atención plena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise Apple Santé (HealthKit) pour enregistrer chaque séance de respiration terminée en tant que minutes de pleine conscience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa l’app Salute (HealthKit) per salvare ogni sessione di respirazione completata come minuti di consapevolezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaはヘルスケア（HealthKit）を使って、完了した各呼吸セッションをマインドフルネスの時間として保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia는 건강 앱(HealthKit)을 사용해 완료한 각 호흡 세션을 마음 챙기기 시간으로 저장해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia gebruikt de Gezondheid-app (HealthKit) om elke voltooide ademsessie als mindfulnessminuten te bewaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia usa o app Saúde (HealthKit) para salvar cada sessão de respiração concluída como Minutos de Atenção Plena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia использует приложение «Здоровье» (HealthKit), чтобы сохранять каждый завершённый дыхательный сеанс как минуты осознанности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 使用“健康”App（HealthKit）将每次完成的呼吸练习存储为正念分钟数。"
          }
        }
      }
    },
    "settings.feedback.footer" : {
      "comment" : "Footer below rating and feedback",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia ist kostenlos und wird von einer Person entwickelt. Eine Bewertung, eine Idee oder ein Hinweis, was nicht funktioniert hat, hilft mehr, als du denkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia is free and made by one person. A rating, an idea or a note about what didn't work helps more than you'd think."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia es gratis y lo crea una sola persona. Una valoración, una idea o un aviso de lo que no funcionó ayuda más de lo que crees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia est gratuit et créé par une seule personne. Une note, une idée ou un mot sur ce qui n'a pas marché aide plus que tu ne le penses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia è gratuita ed è creata da una sola persona. Una valutazione, un’idea o una segnalazione su cosa non ha funzionato aiuta più di quanto pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaは無料で、ひとりの開発者が作っています。評価やアイデア、うまく動かなかった点を伝えてもらえると、想像以上に大きな助けになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia는 무료이며 한 사람이 만들고 있어요. 평가 하나, 아이디어 하나, 잘 안 됐던 점에 대한 메모 하나가 생각보다 큰 도움이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia is gratis en wordt door één persoon gemaakt. Een beoordeling, een idee of een opmerking over wat niet werkte, helpt meer dan je denkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia é gratuito e feito por uma só pessoa. Uma avaliação, uma ideia ou um aviso sobre o que não funcionou ajuda mais do que você imagina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia бесплатна, и её делает один человек. Оценка, идея или пара слов о том, что не сработало, помогают больше, чем ты думаешь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 免费提供，由一个人独立开发。一个评分、一个想法，或是告诉我哪里出了问题，都比你想象的更有帮助。"
          }
        }
      }
    },
