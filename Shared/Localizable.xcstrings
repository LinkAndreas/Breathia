    "report.sessionsWithoutASensor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen ohne Sensor zählen trotzdem. Verbinde beim nächsten Mal einen Herzfrequenzsensor wie den Polar H10, um zu sehen, wie dein Herz reagiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions without a sensor still count. Connect a heart-rate sensor, like the Polar H10, next time to see how your heart responds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones sin sensor también cuentan. Conecta un sensor de frecuencia cardiaca, como el Polar H10, la próxima vez para ver cómo responde tu corazón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séances sans capteur comptent aussi. Connecte un capteur de fréquence cardiaque, comme le Polar H10, la prochaine fois pour voir comment ton cœur réagit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche le sessioni senza sensore contano. La prossima volta collega un sensore di frequenza cardiaca, come il Polar H10, per vedere come risponde il tuo cuore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーなしのセッションも記録に残ります。次回はPolar H10などの心拍センサーを接続して、心臓の反応を確かめてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서 없이 한 세션도 똑같이 기록돼요. 다음에는 Polar H10 같은 심박 센서를 연결해 심장이 어떻게 반응하는지 확인해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies zonder sensor tellen ook mee. Verbind de volgende keer een hartslagsensor, zoals de Polar H10, om te zien hoe je hart reageert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões sem sensor também contam. Da próxima vez, conecte um sensor de frequência cardíaca, como o Polar H10, para ver como seu coração responde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеансы без датчика тоже засчитываются. В следующий раз подключи датчик пульса, например Polar H10, чтобы увидеть, как реагирует твоё сердце."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有传感器的练习同样有效。下次连接心率传感器（如 Polar H10），就能看到心脏的反应。"
          }
        }
      }
    },
