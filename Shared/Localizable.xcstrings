    "technique.sitali.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass diese Technik aus, wenn kalte Luft dich zum Husten bringt. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip this technique if cold air makes you cough. Stop if you feel dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita esta técnica si el aire frío te hace toser. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez cette technique si l'air frais vous fait tousser. Arrêtez si vous avez des vertiges."
          }
        }
      }
    },
    "technique.sitali.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolle die Zungenränder zu einer Röhre (oder spitze die Lippen, falls das nicht geht)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curl the sides of your tongue to form a tube (or purse your lips if you can't)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enrolla los lados de la lengua formando un tubo (o frunce los labios si no puedes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roulez les bords de la langue pour former un tube (ou pincez les lèvres si vous n'y arrivez pas)."
          }
        }
      }
    },
    "technique.sitali.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden durch die Zunge ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through your tongue for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala a través de la lengua durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez par la langue pendant 4 secondes."
          }
        }
      }
    },
    "technique.sitali.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe den Mund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close your mouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la boca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermez la bouche."
          }
        }
      }
    },
    "technique.sitali.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden langsam durch die Nase aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale slowly through your nose for 6 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala despacio por la nariz durante 6 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez lentement par le nez pendant 6 secondes."
          }
        }
      }
    },
    "technique.sitali.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die gerollte Zunge ein-, durch die Nase ausatmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through a curled tongue, exhale through the nose"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
