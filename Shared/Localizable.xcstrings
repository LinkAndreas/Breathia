    "technique.moonBreath.bestFor.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktizierende, die Nasenlochatmung kennen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practitioners familiar with nostril breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practicantes familiarizados con la respiración por fosas nasales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratiquants familiers de la respiration par une narine"
          }
        }
      }
    },
    "technique.moonBreath.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei dieser Yoga-Übung atmest du immer durch das linke Nasenloch ein und durch das rechte aus. Sie wird traditionell mit Kühle und Ruhe verbunden und ist deshalb eine beliebte Abendübung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this yogic practice every inhale goes through the left nostril and every exhale through the right. It is traditionally associated with cooling and calming, which makes it a popular evening practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta práctica yóguica cada inhalación entra por la fosa nasal izquierda y cada exhalación sale por la derecha. Tradicionalmente se asocia con frescor y calma, por eso es una práctica popular por la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans cette pratique yogique, chaque inspiration passe par la narine gauche et chaque expiration par la droite. Traditionnellement associée à la fraîcheur et au calme, c'est une pratique appréciée le soir."
          }
        }
      }
    },
    "technique.moonBreath.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondatmung (Chandra Bhedana)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moon Breath (Chandra Bhedana)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración lunar (Chandra Bhedana)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration lunaire (Chandra Bhedana)"
          }
        }
      }
    },
    "technique.moonBreath.purpose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Ruhe kommen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winding down"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relajarse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se détendre"
          }
        }
      }
    },
    "technique.moonBreath.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme sanft. Hör auf, wenn ein Nasenloch verstopft ist oder sich das Atmen angestrengt anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe gently. Stop if one nostril is blocked or breathing feels strained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira con suavidad. Detente si tienes una fosa nasal tapada o si respirar te cuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirez doucement. Arrêtez si une narine est bouchée ou si la respiration devient pénible."
          }
        }
      }
    },
    "technique.moonBreath.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht hin und lege die linke Hand in den Schoß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright and rest your left hand in your lap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido y apoya la mano izquierda en el regazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous droit et posez la main gauche sur vos genoux."
          }
        }
      }
    },
    "technique.moonBreath.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das rechte Nasenloch mit dem rechten Daumen und atme 4 Sekunden links ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close your right nostril with your right thumb and inhale through the left for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa derecha con el pulgar derecho e inhala por la izquierda durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouchez la narine droite avec le pouce droit et inspirez par la gauche pendant 4 secondes."
          }
        }
      }
    },
    "technique.moonBreath.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschließe das linke Nasenloch und atme 6 Sekunden rechts aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close the left nostril and exhale through the right for 6 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa la fosa izquierda y exhala por la derecha durante 6 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouchez la narine gauche et expirez par la droite pendant 6 secondes."
          }
        }
      }
    },
    "technique.moonBreath.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole und atme immer links ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat, always inhaling on the left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite, inhalando siempre por la izquierda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommencez en inspirant toujours à gauche."
          }
        }
      }
    },
    "technique.moonBreath.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das linke Nasenloch ein-, durch das rechte ausatmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through the left nostril, exhale through the right"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por la fosa nasal izquierda y exhala por la derecha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez par la narine gauche, expirez par la droite"
          }
        }
      }
    },
