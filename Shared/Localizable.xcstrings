    "technique.resonance.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsames, gleichmäßiges Atmen mit etwa fünf bis sechs Atemzügen pro Minute wird häufig im kardiovaskulären und autonomen Biofeedback eingesetzt, weil es die natürliche Schwankung der Herzfrequenz bei jedem Atemzug tendenziell maximiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing slowly and evenly at roughly five to six breaths a minute is commonly used in cardiovascular and autonomic biofeedback because it tends to maximize the natural variation in heart rate that occurs with each breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar despacio y de forma regular, a unas cinco o seis respiraciones por minuto, se usa a menudo en el biofeedback cardiovascular y autonómico porque tiende a maximizar la variación natural de la frecuencia cardiaca que se produce con cada respiración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirer lentement et régulièrement, à environ cinq ou six respirations par minute, est couramment utilisé en biofeedback cardiovasculaire et autonome, car cela tend à maximiser la variation naturelle de la fréquence cardiaque à chaque respiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirare lentamente e in modo regolare, a circa cinque-sei respiri al minuto, è comune nel biofeedback cardiovascolare e autonomico, perché tende a massimizzare la variazione naturale della frequenza cardiaca che si verifica a ogni respiro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分間に約5〜6回のペースでゆっくり均等に呼吸する方法は、循環器系や自律神経系のバイオフィードバックで広く使われています。呼吸ごとに生じる心拍数の自然な変動が、最も大きくなりやすいためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분당 약 다섯에서 여섯 번으로 천천히 고르게 호흡하는 방법은 심혈관 및 자율신경 바이오피드백에서 흔히 사용돼요. 호흡할 때마다 자연스럽게 일어나는 심박수 변화를 최대로 키우는 경향이 있기 때문이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langzaam en gelijkmatig ademen met ongeveer vijf à zes ademhalingen per minuut wordt veel gebruikt bij cardiovasculaire en autonome biofeedback, omdat het de natuurlijke schommeling van de hartslag bij elke ademhaling doorgaans maximaliseert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar de forma lenta e uniforme, a cerca de cinco a seis respirações por minuto, é muito usado no biofeedback cardiovascular e autonômico, porque tende a maximizar a variação natural da frequência cardíaca que ocorre a cada respiração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленное ровное дыхание примерно пять–шесть раз в минуту часто используют в сердечно-сосудистой и вегетативной биообратной связи, потому что оно, как правило, максимально усиливает естественные колебания пульса, возникающие с каждым вдохом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以每分钟约五到六次的速度缓慢均匀地呼吸，常用于心血管和自主神经生物反馈，因为这往往能让每次呼吸带来的心率自然变化达到最大。"
          }
        }
      }
    },
