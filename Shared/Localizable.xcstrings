          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala durante 6 segundos tarareando suavemente con los labios cerrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez pendant 6 secondes en fredonnant doucement, lèvres fermées."
