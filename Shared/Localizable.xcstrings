    "technique.sevenEleven.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten sind lang. Verkürze sie, wenn du außer Atem gerätst – das längere Ausatmen ist wichtiger als die genauen Zahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The counts are long. Shorten them if you feel breathless — the longer exhale matters more than the exact numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos son largos. Acórtalos si te falta el aire: lo importante es que la exhalación sea más larga, no los números exactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les durées sont longues. Raccourcis-les si tu manques de souffle : une expiration plus longue compte davantage que les chiffres exacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tempi sono lunghi. Accorciali se ti senti senza fiato: l’espirazione più lunga conta più dei numeri esatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カウントが長めです。息苦しく感じたら短くしてください。正確な数字よりも、長く吐くことのほうが大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간이 긴 편이에요. 숨이 차면 줄이세요. 정확한 숫자보다 날숨을 더 길게 하는 것이 중요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tellen zijn lang. Verkort ze als je buiten adem raakt – de langere uitademing is belangrijker dan de precieze getallen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tempos são longos. Encurte-os se ficar sem fôlego — o que importa é a expiração mais longa, não os números exatos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счёт долгий. Сократи его, если не хватает воздуха, — более долгий выдох важнее точных цифр."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计数较长。如果感到气短，请缩短计数——更长的呼气比精确的数字更重要。"
          }
        }
      }
    },
    "technique.sevenEleven.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz oder stell dich hin, die Füße auf dem Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or stand with your feet on the ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o ponte de pie con los pies en el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi ou tiens-toi debout, les pieds au sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti o stai in piedi con i piedi ben appoggiati a terra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足を床につけて、座るか立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 발을 바닥에 대고 앉거나 서세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga zitten of staan met je voeten op de grond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se ou fique em pé, com os pés no chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь или встань, поставив ноги на пол."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐下或站立，双脚踩在地面上。"
          }
        }
      }
    },
    "technique.sevenEleven.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 7 Sekunden durch die Nase ein und fülle deinen Bauch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in through your nose for 7 seconds, filling your belly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por la nariz durante 7 segundos, llenando el abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire par le nez pendant 7 secondes en remplissant ton ventre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira dal naso per 7 secondi, riempiendo la pancia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おなかを満たすように、鼻から7秒間吸います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배를 채우며 코로 7초 동안 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem 7 seconden in door je neus en vul je buik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire pelo nariz por 7 segundos, enchendo a barriga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдыхай носом 7 секунд, наполняя живот."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子吸气 7 秒，让气息充满腹部。"
          }
        }
      }
    },
    "technique.sevenEleven.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 11 Sekunden durch den Mund aus."
          }
        },
        "en" : {
