    "sensor.denied.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Breathia in den Einstellungen, Bluetooth zu verwenden, um deinen Herzfrequenzsensor zu verbinden. Alle Atemsitzungen funktionieren auch ohne Sensor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To connect your heart-rate sensor, allow Breathia to use Bluetooth in Settings. Every breathing session also works without a sensor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conectar tu sensor de frecuencia cardiaca, permite que Breathia use Bluetooth en Ajustes. Todas las sesiones de respiración funcionan también sin sensor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour connecter votre capteur de fréquence cardiaque, autorisez Breathia à utiliser le Bluetooth dans Réglages. Toutes les séances de respiration fonctionnent aussi sans capteur."
          }
        }
      }
    },
