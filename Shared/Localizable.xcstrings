    "sensor.permission.privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Geräte werden dabei weder gesucht noch erfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It never looks for or collects information about other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca busca otros dispositivos ni recopila información sobre ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun autre appareil n'est recherché et aucune information à leur sujet n'est collectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non cerca né raccoglie mai informazioni su altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスを探したり、その情報を収集したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기를 찾거나 다른 기기의 정보를 수집하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt nooit naar andere apparaten gezocht of informatie over ze verzameld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele nunca procura outros dispositivos nem coleta informações sobre eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение никогда не ищет другие устройства и не собирает о них информацию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它绝不会搜索或收集其他设备的信息。"
          }
        }
      }
