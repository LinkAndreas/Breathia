          "stringUnit" : {
            "state" : "translated",
            "value" : "Unir a respiração a um sentimento positivo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетать дыхание с приятным чувством"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将呼吸与积极的感受结合"
          }
        }
      }
    },
    "technique.heartFocused.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du atmest langsam und gleichmäßig und stellst dir vor, dass der Atem durch den Bereich um dein Herz ein- und ausströmt. Ein gleichmäßiger Rhythmus zusammen mit einem ruhigen Fokus ist eine beliebte Methode, um einen ausgeglichenen, kohärenten Herzrhythmus zu fördern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You breathe slowly and evenly while imagining the breath flowing in and out through the area around your heart. Pairing a steady rhythm with a calm focus is a popular way to encourage a smooth, coherent heart rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiras despacio y de forma uniforme mientras imaginas que el aire entra y sale por la zona que rodea el corazón. Combinar un ritmo constante con una atención tranquila es una forma popular de favorecer un ritmo cardiaco suave y coherente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu respires lentement et régulièrement en imaginant que l'air entre et sort par la zone autour de ton cœur. Associer un rythme régulier à une attention calme est une façon répandue de favoriser un rythme cardiaque fluide et cohérent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiri lentamente e in modo regolare, immaginando che il respiro entri ed esca attraverso la zona intorno al cuore. Unire un ritmo costante a un’attenzione calma è un modo diffuso per favorire un ritmo cardiaco fluido e coerente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心臓のあたりから息が出入りするのをイメージしながら、ゆっくり均等に呼吸します。一定のリズムと穏やかな集中を組み合わせることは、なめらかで整った心拍リズムを促す方法として広く親しまれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심장 주변으로 숨이 들어오고 나간다고 상상하며 천천히 고르게 호흡해요. 일정한 리듬과 차분한 집중을 함께하는 것은 부드럽고 일관된 심장 리듬을 이끌어 내는 대표적인 방법이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ademt langzaam en gelijkmatig en stelt je voor dat de adem door het gebied rond je hart in- en uitstroomt. Een gelijkmatig ritme combineren met een rustige focus is een populaire manier om een soepel, coherent hartritme te bevorderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você respira de forma lenta e uniforme enquanto imagina o ar entrando e saindo pela região ao redor do coração. Unir um ritmo constante a uma atenção tranquila é uma forma popular de favorecer um ritmo cardíaco suave e coerente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты дышишь медленно и ровно, представляя, как дыхание входит и выходит через область вокруг сердца. Сочетание ровного ритма со спокойным вниманием — популярный способ помочь сердцу войти в плавный, когерентный ритм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓慢而均匀地呼吸，同时想象气息从心脏周围的区域流入和流出。将稳定的节奏与平静的专注相结合，是促进心律平稳、协调的常用方法。"
          }
        }
      }
    },
