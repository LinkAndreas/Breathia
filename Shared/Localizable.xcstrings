    "technique.triangle.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Pause entspannt. Verkürze sie, wenn sie sich unangenehm anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the hold relaxed. Shorten it if it feels uncomfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la retención relajada. Acórtala si te resulta incómoda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la rétention détendue. Raccourcissez-la si elle devient inconfortable."
          }
        }
      }
    },
    "technique.triangle.steps.1" : {
      "localizations" : {
