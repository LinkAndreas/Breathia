    "technique.humming.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summe leise und angenehm. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the hum quiet and comfortable. Stop if you feel dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el zumbido suave y cómodo. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le bourdonnement doux et confortable. Arrêtez si vous avez des vertiges."
          }
        }
      }
    },
    "technique.humming.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich bequem hin und schließ die Augen, wenn du möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit comfortably and close your eyes if you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate cómodamente y cierra los ojos si quieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous confortablement et fermez les yeux si vous le souhaitez."
          }
        }
      }
    },
    "technique.humming.steps.2" : {
      "localizations" : {
