    "report.yourHRVDippedSlightly" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV ist diesmal leicht gesunken. Ein sanfteres, angenehmeres Tempo kann beim nächsten Mal helfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV dipped slightly this time. A gentler, more comfortable pace may help next session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu VFC bajó un poco esta vez. Un ritmo más suave y cómodo puede ayudarte en la próxima sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta VFC a légèrement baissé cette fois-ci. Un rythme plus doux et plus confortable pourrait aider la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa volta la tua HRV è scesa leggermente. Un ritmo più dolce e comodo può aiutarti nella prossima sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回はHRVがわずかに低下しました。次回は、もっとゆったりとした楽なペースを試してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번에는 HRV가 약간 낮아졌어요. 다음 세션에서는 더 편안하고 부드러운 속도로 해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je HRV is deze keer licht gedaald. Een rustiger, prettiger tempo kan de volgende sessie helpen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua VFC caiu um pouco desta vez. Um ritmo mais suave e confortável pode ajudar na próxima sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этот раз твоя ВСР немного снизилась. В следующем сеансе может помочь более мягкий и комфортный темп."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次你的 HRV 略有下降。下次试试更温和、更舒适的节奏。"
          }
        }
      }
    },
    "report.yourHRVRose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV ist im Laufe der Sitzung gestiegen – dein Herzrhythmus hat sich auf deine Atmung eingestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV rose as the session went on — your heart rhythm settled into your breathing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu VFC aumentó a lo largo de la sesión: tu ritmo cardiaco se acompasó con tu respiración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta VFC a augmenté au fil de la séance : ton rythme cardiaque s'est accordé à ta respiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua HRV è salita nel corso della sessione: il ritmo del tuo cuore si è accordato al tuo respiro."
