    "settings.history.deleteAllMessage" : {
      "comment" : "Message of the dialog that confirms deleting every session, on iPhone and iPad",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Sitzungen mit ihren Herzfrequenz- und HRV-Daten werden von diesem Gerät gelöscht. Das lässt sich nicht rückgängig machen. In Apple Health gesicherte Achtsamkeitsminuten bleiben dort erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every session and its heart-rate and HRV data will be deleted from this device. This can't be undone. Mindful minutes saved to Apple Health stay there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este dispositivo todas las sesiones con sus datos de frecuencia cardiaca y VFC. Esta acción no se puede deshacer. Los minutos de atención plena guardados en la app Salud se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les séances et leurs données de fréquence cardiaque et de VFC seront supprimées de cet appareil. Cette action est irréversible. Les minutes de pleine conscience enregistrées dans Apple Santé y restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le sessioni e i relativi dati di frequenza cardiaca e HRV verranno eliminati da questo dispositivo. L’operazione non può essere annullata. I minuti di consapevolezza salvati in Salute restano lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのセッションと、その心拍数およびHRVのデータがこのデバイスから削除されます。この操作は取り消せません。ヘルスケアに保存されたマインドフルネスの時間は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 세션과 해당 심박수 및 HRV 데이터가 이 기기에서 삭제돼요. 이 작업은 되돌릴 수 없어요. 건강 앱에 저장된 마음 챙기기 시간은 그대로 남아 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sessies en hun hartslag- en HRV-gegevens worden van dit apparaat verwijderd. Dit kan niet ongedaan worden gemaakt. Mindfulnessminuten die in Gezondheid zijn bewaard, blijven daar staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as sessões e seus dados de frequência cardíaca e VFC serão apagados deste dispositivo. Não é possível desfazer esta ação. Os Minutos de Atenção Plena salvos no app Saúde continuam lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сеансы вместе с данными о пульсе и ВСР будут удалены с этого устройства. Это действие нельзя отменить. Минуты осознанности, сохранённые в «Здоровье», останутся там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有练习及其心率和 HRV 数据都将从此设备中删除。此操作无法撤销。已存储到“健康”App 的正念分钟数将保留。"
          }
        }
      }
    },
