    "technique.ujjayi.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leichte Verengung im hinteren Rachen erzeugt bei jedem Atemzug ein sanftes, flüsterndes Geräusch, wie fernes Meeresrauschen. Das Geräusch gibt dir etwas, dem du folgen kannst, und verlangsamt den Atem ganz natürlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slight narrowing at the back of the throat creates a soft, whispering sound on each breath, like distant waves. The sound gives you something to follow and naturally slows the breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ligero estrechamiento en la parte posterior de la garganta crea un sonido suave, como un susurro, en cada respiración, parecido a olas lejanas. Ese sonido te da algo que seguir y ralentiza la respiración de forma natural."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger resserrement au fond de la gorge produit à chaque respiration un son doux et chuchoté, comme des vagues au loin. Ce son te donne un repère à suivre et ralentit naturellement le souffle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un leggero restringimento in fondo alla gola crea un suono morbido e sussurrato a ogni respiro, come onde lontane. Il suono ti dà qualcosa da seguire e rallenta il respiro in modo naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喉の奥をわずかに狭めると、遠くの波のような、ささやくようなやわらかな音が呼吸ごとに生まれます。この音がよりどころとなり、呼吸が自然にゆっくりになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목 안쪽을 살짝 좁히면 숨 쉴 때마다 멀리서 들려오는 파도처럼 부드럽게 속삭이는 소리가 나요. 이 소리를 따라가다 보면 호흡이 자연스럽게 느려져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door je keel achterin iets te vernauwen, ontstaat bij elke ademhaling een zacht, fluisterend geluid, als verre golven. Het geluid geeft je iets om te volgen en vertraagt de adem op een natuurlijke manier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um leve estreitamento no fundo da garganta cria um som suave, como um sussurro, a cada respiração, parecido com ondas distantes. O som dá a você algo para acompanhar e desacelera a respiração naturalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкое сужение в глубине горла создаёт на каждом вдохе и выдохе мягкий шепчущий звук, похожий на далёкие волны. Этот звук даёт опору для внимания и естественно замедляет дыхание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻微收窄喉咙后部，每次呼吸都会发出柔和的、如耳语般的声音，就像远处的海浪。这种声音让你有所依循，并自然地放慢呼吸。"
          }
        }
      }
    },
