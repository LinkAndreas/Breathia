    "technique.threePart.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Einatmen füllt die Lunge in drei Stufen – erst den Bauch, dann die Rippen, dann die obere Brust –, gefolgt von einem langen, gleichmäßigen Ausatmen. So lernst du, dein volles Atemvolumen zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each inhale fills the lungs in three stages — belly, then ribs, then upper chest — followed by one long, smooth exhale. It teaches you to use your full breathing capacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inhalación llena los pulmones en tres etapas (primero el abdomen, luego las costillas y después la parte alta del pecho) y le sigue una exhalación larga y suave. Te enseña a usar toda tu capacidad respiratoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque inspiration remplit les poumons en trois étapes — le ventre, puis les côtes, puis le haut de la poitrine — suivie d'une longue expiration fluide. Elle t'apprend à utiliser toute ta capacité respiratoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni inspirazione riempie i polmoni in tre fasi (prima la pancia, poi le costole, poi la parte alta del petto) ed è seguita da un’unica espirazione lunga e fluida. Ti insegna a usare tutta la tua capacità respiratoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸うたびに、おなか、肋骨、胸の上部の3段階で肺を満たし、そのあと長くなめらかに1回で吐きます。呼吸の容量をすべて使うことを身につけられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들이쉴 때마다 배, 갈비뼈, 가슴 위쪽의 세 단계로 폐를 채운 뒤 한 번 길고 부드럽게 내쉬어요. 호흡 능력을 온전히 쓰는 법을 배울 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke inademing vult de longen in drie stappen – eerst de buik, dan de ribben, dan de bovenborst – gevolgd door één lange, vloeiende uitademing. Zo leer je je volledige ademcapaciteit te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inspiração enche os pulmões em três etapas — barriga, depois costelas, depois a parte alta do peito — seguida de uma expiração longa e suave. Ela ensina você a usar toda a sua capacidade respiratória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый вдох наполняет лёгкие в три этапа — живот, затем рёбра, затем верх груди, — после чего следует один долгий плавный выдох. Так ты учишься использовать весь объём своего дыхания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次吸气分三个阶段充满肺部——先是腹部，然后是肋部，最后是上胸部——随后是一次悠长、平顺的呼气。它教你充分利用全部呼吸容量。"
          }
        }
      }
    },
