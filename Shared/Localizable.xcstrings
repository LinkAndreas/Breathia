    "technique.resonance.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Muster hat keine Pausen und wird meist gut vertragen. Werde noch langsamer, wenn sich 5 Sekunden gehetzt anfühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pattern has no holds and is generally well tolerated. Slow down further if 5 seconds feels rushed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este patrón no tiene retenciones y suele tolerarse bien. Ve más despacio si 5 segundos te parecen poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce rythme ne comporte aucune rétention et est généralement bien toléré. Ralentis encore si 5 secondes te semblent trop rapides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo schema non prevede apnee ed è in genere ben tollerato. Rallenta ancora se 5 secondi ti sembrano affrettati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を止めないパターンで、一般的に無理なく続けられます。5秒が慌ただしく感じたら、さらにゆっくりにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨 참기가 없으며 대체로 무리 없이 할 수 있어요. 5초가 급하게 느껴지면 속도를 더 늦추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit patroon heeft geen pauzes en wordt meestal goed verdragen. Vertraag nog verder als 5 seconden gehaast voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este padrão não tem retenções e costuma ser bem tolerado. Vá ainda mais devagar se 5 segundos parecerem apressados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом паттерне нет задержек, и обычно он хорошо переносится. Замедлись ещё сильнее, если 5 секунд кажутся торопливыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这种模式没有屏息，通常耐受性良好。如果 5 秒感觉仓促，可以进一步放慢。"
          }
        }
      }
    },
