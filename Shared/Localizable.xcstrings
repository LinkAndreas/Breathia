    "technique.buteyko.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere 4 Sekunden vor dem nächsten Einatmen."
          }
        },
        "en" : {
