        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが進むにつれてHRVが上昇しました。心拍のリズムが呼吸に同調してきています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 진행될수록 HRV가 높아졌어요. 심장 리듬이 호흡에 맞춰 자리 잡았어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je HRV steeg in de loop van de sessie – je hartritme stemde zich af op je ademhaling."
          }
        },
        "pt-BR" : {
