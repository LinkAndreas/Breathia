    "technique.sitali.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass diese Technik aus, wenn kalte Luft dich zum Husten bringt. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip this technique if cold air makes you cough. Stop if you feel dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita esta técnica si el aire frío te hace toser. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évite cette technique si l'air frais te fait tousser. Arrête si tu as des vertiges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta questa tecnica se l’aria fredda ti fa tossire. Fermati se ti gira la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷たい空気で咳が出る場合は、このテクニックは避けてください。めまいを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찬 공기에 기침이 나면 이 호흡법은 건너뛰세요. 어지러우면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla deze techniek over als je van koude lucht moet hoesten. Stop als je duizelig wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite esta técnica se o ar frio fizer você tossir. Pare se sentir tontura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропусти эту технику, если от холодного воздуха начинаешь кашлять. Остановись, если закружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果冷空气让你咳嗽，请跳过这种呼吸法。如感到头晕，请停止练习。"
          }
        }
      }
    },
    "technique.sitali.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolle die Zungenränder zu einer Röhre (oder spitze die Lippen, falls das nicht geht)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curl the sides of your tongue to form a tube (or purse your lips if you can't)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enrolla los lados de la lengua formando un tubo (o frunce los labios si no puedes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roule les bords de la langue pour former un tube (ou pince les lèvres si tu n'y arrives pas)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrotola i lati della lingua a formare un tubo (oppure socchiudi le labbra, se non ci riesci)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舌の両側を丸めて筒状にします（できない場合は唇をすぼめます）。"
          }
        },
        "ko" : {
