            "value" : "集中しやすければ、胸に手を当てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중하는 데 도움이 된다면 한 손을 가슴에 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
