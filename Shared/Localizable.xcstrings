          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 소리에 귀 기울이며 5초 동안 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
