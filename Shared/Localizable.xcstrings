        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pausa de 4 segundos antes de la siguiente inhalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites une pause de 4 secondes avant l'inspiration suivante."
          }
        }
      }
    },
    "technique.buteyko.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte jeden Atemzug leicht; vermeide tiefes oder erzwungenes Atmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep every breath light; avoid deep or forced breathing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén cada respiración ligera; evita respirar hondo o forzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez chaque respiration légère ; évitez de respirer profondément ou de forcer."
