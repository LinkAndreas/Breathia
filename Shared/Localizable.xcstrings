            "value" : "Inhala en silencio por la nariz durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez silencieusement par le nez pendant 4 secondes."
          }
        }
      }
    },
