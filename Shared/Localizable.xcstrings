    "technique.coherent.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der kohärenten Atmung verlangsamst du den Atem auf etwa fünf Atemzüge pro Minute, mit langem, gleichmäßigem Ein- und Ausatmen. In diesem Tempo steigt und sinkt die Herzfrequenz bei vielen Menschen mit jedem Atemzug gleichmäßig – genau das Muster, das HRV-Biofeedback anstrebt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coherent breathing slows the breath to about five breaths a minute with a long, even inhale and exhale. At this pace, many people see heart rate rise and fall smoothly with each breath — the pattern HRV biofeedback aims for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respiración coherente reduce el ritmo a unas cinco respiraciones por minuto, con una inhalación y una exhalación largas y uniformes. A este ritmo, en muchas personas la frecuencia cardiaca sube y baja de forma suave con cada respiración, justo el patrón que busca el biofeedback de VFC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respiration cohérente ralentit le souffle à environ cinq respirations par minute, avec une inspiration et une expiration longues et régulières. À ce rythme, chez beaucoup de personnes, la fréquence cardiaque monte et descend en douceur à chaque respiration : c'est précisément le schéma recherché en biofeedback de VFC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respirazione coerente rallenta il respiro a circa cinque respiri al minuto, con inspirazione ed espirazione lunghe e regolari. A questo ritmo, in molte persone la frequenza cardiaca sale e scende in modo fluido a ogni respiro: proprio lo schema a cui mira il biofeedback HRV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コヒーレント呼吸では、長く均等な吸気と呼気で、呼吸を1分間に約5回まで遅くします。このペースでは、多くの人の心拍数が呼吸ごとになめらかに上下します。これこそHRVバイオフィードバックが目指すパターンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코히어런트 호흡은 길고 고르게 들이쉬고 내쉬며 호흡을 분당 약 다섯 번으로 늦춰요. 이 속도에서는 많은 사람의 심박수가 호흡에 따라 부드럽게 오르내리는데, 이것이 바로 HRV 바이오피드백이 목표로 하는 패턴이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij coherente ademhaling vertraag je de adem tot ongeveer vijf ademhalingen per minuut, met een lange, gelijkmatige in- en uitademing. In dit tempo zien veel mensen hun hartslag bij elke ademhaling soepel stijgen en dalen – precies het patroon waar HRV-biofeedback naar streeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A respiração coerente desacelera a respiração para cerca de cinco respirações por minuto, com inspiração e expiração longas e uniformes. Nesse ritmo, muitas pessoas veem a frequência cardíaca subir e descer suavemente a cada respiração — o padrão que o biofeedback de VFC busca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когерентное дыхание замедляет дыхание примерно до пяти вдохов в минуту с долгими, ровными вдохом и выдохом. В таком темпе у многих пульс плавно поднимается и опускается с каждым вдохом — именно к этому паттерну стремится биообратная связь по ВСР."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "协调呼吸将呼吸放慢到每分钟约五次，吸气和呼气都悠长而均匀。在这样的节奏下，许多人的心率会随每次呼吸平稳起伏——这正是 HRV 生物反馈所追求的模式。"
          }
        }
      }
    },
