    "technique.478.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lange Halten und Ausatmen kann sich anfangs intensiv anfühlen. Verkürze den Takt, wenn du außer Atem gerätst oder dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The long hold and exhale can feel intense at first. Reduce the counts if you feel breathless or dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retención y la exhalación largas pueden resultar intensas al principio. Reduce los tiempos si te falta el aire o te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longue rétention et l'expiration peuvent sembler intenses au début. Raccourcis les durées si tu manques de souffle ou as des vertiges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lunga apnea e l’espirazione possono sembrare intense all’inizio. Riduci i tempi se ti senti senza fiato o hai le vertigini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長く止めて吐く呼吸は、はじめは負担に感じることがあります。息苦しさやめまいを感じたら、カウントを短くしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래 숨을 참고 내쉬는 것이 처음에는 힘들게 느껴질 수 있어요. 숨이 차거나 어지러우면 시간을 줄이세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lange vasthouden en uitademen kan in het begin intens voelen. Verkort de tellen als je buiten adem raakt of duizelig wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retenção e a expiração longas podem parecer intensas no começo. Diminua os tempos se ficar sem fôlego ou sentir tontura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгая задержка и выдох поначалу могут ощущаться интенсивно. Сократи счёт, если не хватает воздуха или кружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长时间的屏息和呼气起初可能会让人感到吃力。如果感到气短或头晕，请缩短计数。"
          }
        }
      }
    },
    "technique.478.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege deine Zunge leicht hinter die oberen Schneidezähne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your tongue lightly behind your upper front teeth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya la lengua suavemente detrás de los dientes frontales superiores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose légèrement la langue derrière tes incisives supérieures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appoggia delicatamente la lingua dietro gli incisivi superiori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舌先を上の前歯の裏に軽く当てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혀끝을 윗앞니 뒤에 가볍게 대세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg je tong licht achter je bovenste voortanden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie a língua de leve atrás dos dentes da frente de cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слегка упрись кончиком языка за верхние передние зубы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将舌尖轻抵在上门牙背后。"
          }
        }
      }
    },
