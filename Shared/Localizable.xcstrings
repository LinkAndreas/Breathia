    "technique.478.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lange Halten und Ausatmen kann sich anfangs intensiv anfühlen. Verkürze den Takt, wenn du außer Atem gerätst oder dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The long hold and exhale can feel intense at first. Reduce the counts if you feel breathless or dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retención y la exhalación largas pueden resultar intensas al principio. Reduce los tiempos si te falta el aire o te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longue rétention et l'expiration peuvent sembler intenses au début. Réduisez le rythme si vous êtes essoufflé ou avez des vertiges."
          }
        }
      }
    },
    "technique.478.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege deine Zunge leicht hinter die oberen Schneidezähne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your tongue lightly behind your upper front teeth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya la lengua suavemente detrás de los dientes frontales superiores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez légèrement la langue derrière vos incisives supérieures."
          }
        }
      }
    },
    "technique.478.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden leise durch die Nase ein."
          }
        },
        "en" : {
