    "technique.lion.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem tiefen Einatmen durch die Nase atmest du kräftig durch den weit geöffneten Mund aus, streckst die Zunge heraus und machst dabei ein „Ha“. Das löst Spannungen in Gesicht und Kiefer und kann sich überraschend befreiend anfühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a deep inhale through the nose, you exhale forcefully through a wide-open mouth with your tongue stretched out, making a 'ha' sound. It releases tension in the face and jaw and can feel surprisingly freeing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una inhalación profunda por la nariz, exhalas con fuerza por la boca bien abierta, con la lengua estirada hacia fuera y emitiendo un sonido «ja». Libera la tensión de la cara y la mandíbula y puede resultar sorprendentemente liberador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une inspiration profonde par le nez, tu expires fortement par la bouche grande ouverte, langue tirée, en émettant un « ha ». Cela relâche les tensions du visage et de la mâchoire et peut être étonnamment libérateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un’inspirazione profonda dal naso, espiri con forza dalla bocca spalancata e con la lingua fuori, emettendo un suono “ha”. Scioglie la tensione di viso e mascella e può essere sorprendentemente liberatorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻から深く吸ったあと、口を大きく開けて舌を突き出し、「ハー」という音とともに力強く吐きます。顔やあごの緊張がほぐれ、驚くほど解放感を得られることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 깊이 들이쉰 뒤, 입을 크게 벌리고 혀를 길게 내밀어 ‘하’ 소리와 함께 힘차게 내쉬어요. 얼굴과 턱의 긴장이 풀리고, 생각보다 훨씬 홀가분한 느낌을 줄 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een diepe inademing door de neus adem je krachtig uit door je wijd geopende mond, met je tong naar buiten, terwijl je een ‘ha’-geluid maakt. Het maakt spanning in je gezicht en kaak los en kan verrassend bevrijdend voelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de uma inspiração profunda pelo nariz, você expira com força pela boca bem aberta, com a língua esticada para fora, fazendo um som de “ha”. Isso libera a tensão do rosto e da mandíbula e pode trazer uma sensação surpreendente de liberdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После глубокого вдоха через нос ты сильно выдыхаешь через широко открытый рот, высунув язык, со звуком «ха». Это снимает напряжение с лица и челюсти и может дарить удивительное чувство свободы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子深吸一口气后，张大嘴巴、伸出舌头，发出“哈”的声音用力呼气。它能释放面部和下颌的紧张，让人感到意想不到的畅快。"
          }
        }
      }
    },
