    "technique.sitali.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luft, die über die gerollte Zunge eingeatmet wird, fühlt sich kühl an; darauf folgt ein langsames Ausatmen durch die Nase. Die Übung wird traditionell genutzt, um abzukühlen und den Geist zu beruhigen, besonders bei warmem Wetter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air drawn in over a curled tongue feels cool, and a slow exhale through the nose follows. The practice is traditionally used to cool down and calm the mind, especially in warm weather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aire que entra por la lengua enrollada se siente fresco y le sigue una exhalación lenta por la nariz. Tradicionalmente se usa para refrescarse y calmar la mente, sobre todo cuando hace calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'air aspiré sur la langue roulée paraît frais, puis vient une expiration lente par le nez. Cette pratique sert traditionnellement à se rafraîchir et à apaiser l'esprit, surtout par temps chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aria inspirata sopra la lingua arrotolata risulta fresca, e segue un’espirazione lenta dal naso. Questa pratica è usata tradizionalmente per rinfrescarsi e calmare la mente, soprattutto quando fa caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丸めた舌から吸い込む空気はひんやりと感じられ、そのあと鼻からゆっくり吐きます。伝統的に、特に暑い時期に体を冷まし心を落ち着けるために行われてきた呼吸法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동그랗게 만 혀 위로 들이쉰 공기는 시원하게 느껴지고, 이어서 코로 천천히 내쉬어요. 전통적으로 특히 더운 날씨에 몸을 식히고 마음을 진정시키기 위해 해 온 수련이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucht die je over een opgerolde tong inademt, voelt koel aan, en daarna volgt een langzame uitademing door de neus. De oefening wordt traditioneel gebruikt om af te koelen en de geest te kalmeren, vooral bij warm weer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ar que entra pela língua enrolada parece fresco, e em seguida vem uma expiração lenta pelo nariz. Tradicionalmente, a prática é usada para refrescar o corpo e acalmar a mente, principalmente quando faz calor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воздух, вдыхаемый через свёрнутый язык, кажется прохладным, а за ним следует медленный выдох через нос. Традиционно эту практику используют, чтобы охладиться и успокоить ум, особенно в жару."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经卷起的舌头吸入的空气感觉清凉，随后用鼻子慢慢呼气。传统上这种练习用于降温和平静心神，尤其适合温暖的天气。"
          }
        }
      }
    },
