    "technique.twoToOne.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich 8 Sekunden anstrengend anfühlen, versuche 3 Sekunden ein und 6 Sekunden aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If 8 seconds feels like a strain, try 3 seconds in and 6 seconds out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 8 segundos te cuestan, prueba 3 segundos al inhalar y 6 al exhalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 8 secondes vous demandent un effort, essayez 3 secondes à l'inspiration et 6 à l'expiration."
          }
        }
      }
    },
