    "technique.heartFocused.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Muster hat keine Pausen. Atme sanft und hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pattern has no holds. Breathe gently and stop if you feel lightheaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este patrón no tiene retenciones. Respira con suavidad y detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce rythme ne comporte aucune rétention. Respire doucement et arrête si la tête te tourne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo schema non prevede apnee. Respira con delicatezza e fermati se ti gira la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を止めないパターンです。やさしく呼吸し、ふらつきを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨 참기가 없는 호흡법이에요. 부드럽게 호흡하고, 머리가 어지러우면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit patroon heeft geen pauzes. Adem rustig en stop als je je licht in je hoofd voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este padrão não tem retenções. Respire com suavidade e pare se sentir a cabeça leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом паттерне нет задержек. Дыши мягко и остановись, если закружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这种模式没有屏息。请轻柔地呼吸，如感到头晕，请停止练习。"
          }
        }
      }
    },
    "technique.heartFocused.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege eine Hand auf die Brust, wenn dir das beim Fokussieren hilft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place a hand on your chest if it helps you focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una mano sobre el pecho si te ayuda a concentrarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose une main sur ta poitrine si cela t'aide à te concentrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
