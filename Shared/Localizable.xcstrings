    "sensor.permission.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia nutzt Bluetooth nur, um sich mit deinem Brustgurt wie dem Polar H10 zu verbinden und beim Atmen deine Herzfrequenz und HRV anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Bluetooth only to connect to your chest strap, like the Polar H10, and show your heart rate and HRV while you breathe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa Bluetooth solo para conectarse a tu correa pectoral, como el Polar H10, y mostrar tu frecuencia cardiaca y tu VFC mientras respiras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise le Bluetooth uniquement pour se connecter à votre ceinture thoracique, comme le Polar H10, et afficher votre fréquence cardiaque et votre VFC pendant que vous respirez."
          }
        }
      }
    },
    "sensor.permission.next" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes wirst du um Erlaubnis gebeten, Bluetooth zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next, you'll be asked for permission to use Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
