    "technique.moonBreath.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei dieser Yoga-Übung atmest du immer durch das linke Nasenloch ein und durch das rechte aus. Sie wird traditionell mit Kühle und Ruhe verbunden und ist deshalb eine beliebte Abendübung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this yogic practice every inhale goes through the left nostril and every exhale through the right. It is traditionally associated with cooling and calming, which makes it a popular evening practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta práctica yóguica cada inhalación entra por la fosa nasal izquierda y cada exhalación sale por la derecha. Tradicionalmente se asocia con frescor y calma, por eso es una práctica popular por la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans cette pratique yogique, chaque inspiration passe par la narine gauche et chaque expiration par la droite. Traditionnellement associée à la fraîcheur et au calme, c'est une pratique appréciée le soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa pratica yoga ogni inspirazione passa dalla narice sinistra e ogni espirazione dalla destra. È tradizionalmente associata al raffreddamento e alla calma, ed è per questo una pratica serale molto diffusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このヨガの呼吸法では、吸うときは必ず左の鼻から、吐くときは右の鼻から行います。伝統的に体を冷まし心を落ち着けるとされ、夜の呼吸法として親しまれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 요가 수련에서는 항상 왼쪽 콧구멍으로 들이쉬고 오른쪽 콧구멍으로 내쉬어요. 전통적으로 몸을 식히고 마음을 진정시키는 것과 관련이 있어 저녁 수련으로 인기가 많아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij deze yogaoefening gaat elke inademing door het linkerneusgat en elke uitademing door het rechter. Ze wordt traditioneel in verband gebracht met verkoeling en rust, waardoor het een populaire avondoefening is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesta prática do yoga, toda inspiração passa pela narina esquerda e toda expiração pela direita. Tradicionalmente, ela é associada ao frescor e à calma, o que a torna uma prática popular à noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой йоговской практике каждый вдох идёт через левую ноздрю, а каждый выдох — через правую. Традиционно её связывают с прохладой и успокоением, поэтому она популярна по вечерам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这种瑜伽练习中，每次都用左鼻孔吸气、右鼻孔呼气。传统上它与清凉和平静相关，因此常在晚间练习。"
          }
        }
      }
    },
