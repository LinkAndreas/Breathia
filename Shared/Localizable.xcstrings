    "technique.altnostril.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditionell wird dabei jeweils ein Nasenloch verschlossen und abwechselnd geatmet. Hier ist das Timing zu einem gleichmäßigen Rhythmus mit vier Phasen vereinfacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditionally practiced by closing one nostril at a time and alternating breaths between them. Here the timing is simplified into a steady four-phase rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradicionalmente se practica tapando una fosa nasal cada vez y alternando las respiraciones entre ellas. Aquí el ritmo se simplifica en cuatro fases constantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traditionnellement, on ferme une narine à la fois en alternant les respirations. Ici, le rythme est simplifié en quatre phases régulières."
          }
        }
      }
    },
