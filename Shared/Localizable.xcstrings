        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relajación nocturna"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détente du soir"
          }
        }
      }
    },
    "technique.moonBreath.bestFor.2" : {
      "localizations" : {
