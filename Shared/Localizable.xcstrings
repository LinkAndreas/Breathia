          }
        }
      }
    },
    "technique.recovery.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Sport hilft langsame Nasenatmung mit längerem Ausatmen, die Atmung wieder unter Kontrolle zu bringen. Sportler nutzen sie zwischen Sätzen und nach dem Training, um von Anstrengung auf Erholung umzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After exercise, slow nasal breathing with a longer exhale helps bring your breathing back under control. Athletes use it between sets and after training to shift from effort to recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después del ejercicio, respirar despacio por la nariz con una exhalación más larga ayuda a recuperar el control de la respiración. Los deportistas la usan entre series y al terminar para pasar del esfuerzo a la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l'effort, une respiration nasale lente avec une expiration plus longue aide à reprendre le contrôle du souffle. Les sportifs l'utilisent entre les séries et après l'entraînement pour passer de l'effort à la récupération."
          }
        }
      }
    },
    "technique.recovery.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenerationsatmung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery Breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración de recuperación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
