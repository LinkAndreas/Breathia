    "technique.sevenEleven.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten sind lang. Verkürze sie, wenn du außer Atem gerätst – das längere Ausatmen ist wichtiger als die genauen Zahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The counts are long. Shorten them if you feel breathless — the longer exhale matters more than the exact numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos son largos. Acórtalos si te falta el aire: importa más que la exhalación sea más larga que los números exactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les durées sont longues. Raccourcissez-les si vous êtes essoufflé : une expiration plus longue compte davantage que les chiffres exacts."
          }
        }
      }
    },
    "technique.sevenEleven.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz oder stell dich hin, die Füße auf dem Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or stand with your feet on the ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o ponte de pie con los pies en el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous ou tenez-vous debout, les pieds au sol."
          }
        }
      }
    },
    "technique.sevenEleven.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 7 Sekunden durch die Nase ein und fülle deinen Bauch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in through your nose for 7 seconds, filling your belly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por la nariz durante 7 segundos, llenando el abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez par le nez pendant 7 secondes en remplissant votre ventre."
          }
        }
      }
    },
    "technique.sevenEleven.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 11 Sekunden durch den Mund aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe out through your mouth for 11 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala por la boca durante 11 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez par la bouche pendant 11 secondes."
          }
        }
      }
    },
    "technique.sevenEleven.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach ein paar Minuten weiter, bis du dich ruhiger fühlst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue for a few minutes until you feel calmer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa unos minutos hasta que te sientas más tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez quelques minutes jusqu'à vous sentir plus calme."
          }
        }
      }
    },
    "technique.sevenEleven.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
