    "sensor.denied.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Breathia in den Einstellungen, Bluetooth zu verwenden, um deinen Herzfrequenzsensor zu verbinden. Alle Atemsitzungen funktionieren auch ohne Sensor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To connect your heart-rate sensor, allow Breathia to use Bluetooth in Settings. Every breathing session also works without a sensor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conectar tu sensor de frecuencia cardiaca, permite que Breathia use Bluetooth en Ajustes. Todas las sesiones de respiración funcionan también sin sensor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour connecter ton capteur de fréquence cardiaque, autorise Breathia à utiliser le Bluetooth dans Réglages. Toutes les séances de respiration fonctionnent aussi sans capteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per collegare il tuo sensore di frequenza cardiaca, consenti a Breathia di usare il Bluetooth in Impostazioni. Ogni sessione di respirazione funziona anche senza sensore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍センサーを接続するには、「設定」でBreathiaにBluetoothの使用を許可してください。センサーがなくても、すべての呼吸セッションを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박 센서를 연결하려면 설정에서 Breathia의 Bluetooth 사용을 허용하세요. 모든 호흡 세션은 센서 없이도 이용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Breathia in Instellingen toe Bluetooth te gebruiken om je hartslagsensor te verbinden. Elke ademsessie werkt ook zonder sensor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conectar seu sensor de frequência cardíaca, permita que o Breathia use o Bluetooth em Ajustes. Todas as sessões de respiração também funcionam sem sensor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы подключить датчик пульса, разреши Breathia использовать Bluetooth в Настройках. Все дыхательные сеансы работают и без датчика."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要连接心率传感器，请在“设置”中允许 Breathia 使用蓝牙。没有传感器也可以进行所有呼吸练习。"
          }
        }
      }
    },
