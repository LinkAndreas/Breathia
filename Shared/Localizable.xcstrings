    "settings.info.heartRateReadingsHRV" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfrequenzwerte, HRV-Werte und der Sitzungsverlauf werden nur auf diesem Gerät gespeichert. Breathia hat kein Konto und sendet nichts an einen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart-rate readings, HRV values, and session history are stored only on this device. Breathia has no account and sends nothing to a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las lecturas de frecuencia cardiaca, los valores de VFC y el historial de sesiones se guardan solo en este dispositivo. Breathia no tiene cuentas y no envía nada a ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures de fréquence cardiaque, les valeurs de VFC et l'historique des séances sont stockés uniquement sur cet appareil. Breathia ne nécessite aucun compte et n'envoie rien à un serveur."
          }
        }
      }
    },
    "settings.info.moistenTheElectrodeAreas" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befeuchte die Elektrodenbereiche des Gurts, befestige ihn direkt unterhalb der Brustmuskulatur und klicke den Sensor ein. Der Sensor wird aktiv und beginnt zu senden, sobald er einen Herzschlag erkennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moisten the electrode areas of the strap, fasten it just below your chest muscles, and snap the sensor on. The sensor wakes up and starts advertising once it detects a heartbeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humedece las zonas de los electrodos de la correa, abróchala justo debajo de los músculos pectorales y encaja el sensor. El sensor se activa y empieza a emitir en cuanto detecta un latido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humidifiez les zones d'électrodes de la sangle, attachez-la juste sous les muscles pectoraux et clipsez le capteur. Le capteur s'active et commence à émettre dès qu'il détecte un battement de cœur."
          }
        }
      }
    },
    "settings.info.notMedicalAdvice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine medizinische Beratung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not medical advice"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es consejo médico"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas un avis médical"
          }
        }
      }
    },
    "settings.info.openTheSensorSheet" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Sensoransicht im Tab „Atmen“ oder in den Einstellungen. Dein Polar H10 erscheint innerhalb weniger Sekunden in der Liste – tippe darauf, um ihn zu verbinden. Halte das Telefon während einer Sitzung in wenigen Metern Entfernung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the sensor sheet from the Breathe tab or Settings. Your Polar H10 appears in the list within a few seconds — tap it to connect. Keep the phone within a few metres during a session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el panel del sensor desde la pestaña Respirar o desde Ajustes. Tu Polar H10 aparecerá en la lista en unos segundos: tócalo para conectarlo. Mantén el teléfono a pocos metros durante la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la fenêtre du capteur depuis l'onglet Respirer ou les Réglages. Votre Polar H10 apparaît dans la liste en quelques secondes : touchez-le pour le connecter. Gardez le téléphone à quelques mètres pendant une séance."
          }
        }
      }
    },
    "settings.info.swipeASession" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche im Verlauf über eine Sitzung, um sie zu löschen. Wenn du die App löschst, werden alle ihre Daten entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe a session in History to delete it. Deleting the app removes all of its data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza una sesión en Historial para eliminarla. Al eliminar la app se borran todos sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez une séance dans l'Historique pour la supprimer. Supprimer l'app efface toutes ses données."
          }
        }
      }
    },
    "settings.info.theSensorReportsEvery" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sensor meldet jeden Herzschlag und die Zeit zwischen den Schlägen (RR-Intervalle). Breathia berechnet RMSSD oder SDNN über ein gleitendes Fenster der letzten Schläge, um Live-Biofeedback zu geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sensor reports every heartbeat and the time between beats (RR intervals). Breathia computes RMSSD or SDNN over a rolling window of recent beats to give live biofeedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sensor registra cada latido y el tiempo entre latidos (intervalos RR). Breathia calcula RMSSD o SDNN sobre una ventana móvil de latidos recientes para ofrecer biofeedback en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capteur transmet chaque battement et le temps entre les battements (intervalles RR). Breathia calcule le RMSSD ou le SDNN sur une fenêtre glissante de battements récents pour fournir un biofeedback en direct."
          }
        }
      }
    },
