    "whatsNew.sounds18.text" : {
      "comment" : "New feature description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: Kristallklangschale, Windspiel, Kalimba und Meeresrauschen. Alle Klänge spielen jetzt in Stereo in einem warmen Raum, und kein Anschlag klingt ganz wie der andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New: crystal bowl, wind chimes, kalimba and ocean waves. Every sound now plays in stereo in a warm room, and no two strikes sound quite alike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuevos: cuenco de cristal, campanillas de viento, kalimba y olas del mar. Todos los sonidos suenan ahora en estéreo en una sala cálida, y ningún golpe suena igual que otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveaux : bol de cristal, carillon à vent, kalimba et vagues de l'océan. Chaque son est désormais en stéréo dans une pièce chaleureuse, et aucun coup ne sonne tout à fait pareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novità: campana di cristallo, campane a vento, kalimba e onde del mare. Ora ogni suono è in stereo in un ambiente caldo, e nessun rintocco suona esattamente uguale a un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい音：クリスタルボウル、ウィンドチャイム、カリンバ、波の音。すべての音が温かみのある空間でステレオ再生され、鳴らすたびに少しずつ違う響きになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 크리스털 볼, 윈드차임, 칼림바, 파도 소리를 만나 보세요. 이제 모든 소리가 따뜻한 공간감의 스테레오로 재생되며, 칠 때마다 조금씩 다르게 울려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuw: kristallen klankschaal, windgong, kalimba en oceaangolven. Elk geluid speelt nu in stereo af in een warme ruimte, en geen twee aanslagen klinken precies hetzelfde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos: tigela de cristal, sinos dos ventos, kalimba e ondas do mar. Agora todos os sons tocam em estéreo, numa sala acolhedora, e nenhum toque soa exatamente igual a outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое: хрустальная чаша, музыка ветра, калимба и океанские волны. Теперь каждый звук звучит в стерео в тёплом пространстве, и ни один удар не похож на другой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增水晶钵、风铃、卡林巴琴和海浪。现在每种声音都以立体声在温暖的空间中播放，而且每一次敲击听起来都略有不同。"
          }
        }
      }
    },
