    "technique.resonance.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Muster hat keine Pausen und wird meist gut vertragen. Werde noch langsamer, wenn sich 5 Sekunden gehetzt anfühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pattern has no holds and is generally well tolerated. Slow down further if 5 seconds feels rushed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este patrón no tiene retenciones y suele tolerarse bien. Ve más despacio si 5 segundos te parecen poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce rythme ne comporte aucune rétention et est généralement bien toléré. Ralentissez encore si 5 secondes vous semblent trop rapides."
          }
        }
      }
    },
