          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expire devagar por 6 segundos, deixando o ar sair aos poucos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно выдыхай 6 секунд, позволяя выдоху мягко угаснуть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢呼气 6 秒，让气息轻轻消散。"
          }
        }
      }
