    "technique.altnostril.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden durch ein Nasenloch ein (traditionell wird das andere mit einem Finger verschlossen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through one nostril for 4 seconds (traditionally closing the other with a finger)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por una fosa nasal durante 4 segundos (tradicionalmente, tapando la otra con un dedo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire par une narine pendant 4 secondes (traditionnellement en bouchant l'autre avec un doigt)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira da una narice per 4 secondi (tradizionalmente chiudendo l’altra con un dito)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片方の鼻から4秒間吸います（伝統的には、もう片方を指でふさぎます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한쪽 콧구멍으로 4초 동안 들이쉬세요(전통적으로는 손가락으로 다른 쪽을 막아요)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem 4 seconden in door één neusgat (traditioneel sluit je het andere af met een vinger)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire por uma narina por 4 segundos (tradicionalmente, fechando a outra com um dedo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдыхай через одну ноздрю 4 секунды (традиционно другую закрывают пальцем)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一侧鼻孔吸气 4 秒（传统做法是用手指按住另一侧鼻孔）。"
          }
        }
      }
    },
    "technique.altnostril.steps.3" : {
      "localizations" : {
