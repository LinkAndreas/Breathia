    "technique.belly.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du mit dem Zwerchfell statt mit der Brust atmest, kann sich der Bauch beim Einatmen ganz ausdehnen. Darauf bauen die meisten anderen Atemtechniken auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing from the diaphragm instead of the chest lets the belly expand fully on the inhale. It is the foundation most other breathing techniques build on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar con el diafragma en lugar del pecho permite que el abdomen se expanda por completo al inhalar. Es la base de la mayoría de las demás técnicas de respiración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirer avec le diaphragme plutôt qu'avec la poitrine permet au ventre de se gonfler pleinement à l'inspiration. C'est la base de la plupart des autres techniques de respiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirare con il diaframma invece che con il petto permette alla pancia di espandersi completamente durante l’inspirazione. È la base su cui si fondano la maggior parte delle altre tecniche di respirazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸ではなく横隔膜で呼吸することで、吸うときにおなかが十分にふくらみます。ほかの多くの呼吸法の土台となる呼吸です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가슴 대신 횡격막으로 호흡하면 들이쉴 때 배가 충분히 부풀어요. 다른 대부분의 호흡법이 바탕으로 삼는 기초 호흡이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je met je middenrif in plaats van met je borst ademt, kan je buik bij het inademen volledig uitzetten. Hierop bouwen de meeste andere ademhalingstechnieken voort."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar com o diafragma em vez do peito permite que a barriga se expanda totalmente ao inspirar. É a base sobre a qual a maioria das outras técnicas de respiração se apoia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыхание диафрагмой, а не грудью, позволяет животу полностью расширяться на вдохе. Это основа, на которой строится большинство других дыхательных техник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用横膈膜而非胸部呼吸，吸气时腹部可以充分扩张。这是大多数其他呼吸法的基础。"
          }
        }
      }
    },
