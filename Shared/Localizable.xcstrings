    "technique.resonance.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsames, gleichmäßiges Atmen mit etwa fünf bis sechs Atemzügen pro Minute wird häufig im kardiovaskulären und autonomen Biofeedback eingesetzt, weil es die natürliche Schwankung der Herzfrequenz bei jedem Atemzug tendenziell maximiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing slowly and evenly at roughly five to six breaths a minute is commonly used in cardiovascular and autonomic biofeedback because it tends to maximize the natural variation in heart rate that occurs with each breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar despacio y de forma regular, a unas cinco o seis respiraciones por minuto, se usa a menudo en el biofeedback cardiovascular y autonómico porque tiende a maximizar la variación natural de la frecuencia cardiaca que se produce con cada respiración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirer lentement et régulièrement, à environ cinq ou six respirations par minute, est couramment utilisé en biofeedback cardiovasculaire et autonome, car cela tend à maximiser la variation naturelle de la fréquence cardiaque à chaque respiration."
          }
        }
      }
    },
