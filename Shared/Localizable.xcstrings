    "settings.rmssdReflectsBeat" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD bildet Veränderungen von Schlag zu Schlag ab, SDNN die Gesamtvariabilität. Eine höhere Empfindlichkeit reagiert früher auf kleinere Veränderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD reflects beat-to-beat changes; SDNN reflects overall variability. Higher sensitivity responds sooner to smaller changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD refleja los cambios latido a latido; SDNN refleja la variabilidad global. Una sensibilidad mayor responde antes a cambios más pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RMSSD reflète les variations d'un battement à l'autre ; le SDNN, la variabilité globale. Une sensibilité plus élevée réagit plus tôt à de petits changements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD riflette le variazioni da un battito all’altro; SDNN la variabilità complessiva. Una sensibilità più alta reagisce prima a variazioni più piccole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSDは心拍ごとの変化を、SDNNは全体的な変動を表します。感度を高くすると、より小さな変化にすばやく反応します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD는 박동 간 변화를, SDNN은 전체적인 변이를 반영해요. 민감도가 높을수록 작은 변화에도 더 빨리 반응해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD weerspiegelt veranderingen van slag tot slag; SDNN weerspiegelt de totale variabiliteit. Een hogere gevoeligheid reageert sneller op kleinere veranderingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RMSSD reflete as mudanças de um batimento para outro; o SDNN reflete a variabilidade geral. Uma sensibilidade maior reage antes a mudanças menores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD отражает изменения от удара к удару, SDNN — общую вариабельность. Чем выше чувствительность, тем быстрее отклик на небольшие изменения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD 反映逐次心跳间的变化；SDNN 反映整体变异性。灵敏度越高，对较小变化的响应越快。"
          }
        }
      }
    },
