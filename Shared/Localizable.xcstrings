          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolerância ao CO₂, respiração nasal"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толерантность к CO₂, носовое дыхание"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二氧化碳耐受力、鼻呼吸"
          }
        }
      }
    },
    "technique.buteyko.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzwinge die Pause nie und dehne sie nicht bis zum Unwohlsein aus. Hör auf, wenn du kurzatmig wirst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never force or extend the pause to discomfort. Stop if you feel short of breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca fuerces ni alargues la pausa hasta sentir incomodidad. Detente si te falta el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne force jamais la pause et ne la prolonge pas jusqu'à l'inconfort. Arrête si tu es à bout de souffle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non forzare mai la pausa e non prolungarla fino al disagio. Fermati se ti senti a corto di fiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "止める時間を無理に延ばしたり、苦しくなるまで続けたりしないでください。息苦しさを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춤을 억지로 하거나 불편할 정도로 늘리지 마세요. 숨이 차면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forceer de pauze nooit en rek hem niet op tot hij onprettig wordt. Stop als je kortademig wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca force nem prolongue a pausa até sentir desconforto. Pare se ficar sem fôlego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не форсируй паузу и не затягивай её до дискомфорта. Остановись, если начинает не хватать воздуха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿勉强停顿或将停顿延长到不适的程度。如感到气短，请停止练习。"
          }
        }
      }
    },
    "technique.buteyko.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 3 Sekunden sanft durch die Nase ein – weniger als bei einem normalen Atemzug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in gently through your nose for 3 seconds — smaller than a normal breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala suavemente por la nariz durante 3 segundos, menos que en una respiración normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire doucement par le nez pendant 3 secondes, moins qu'une respiration normale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira delicatamente dal naso per 3 secondi, meno di un respiro normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻からやさしく3秒間吸います。ふだんの呼吸より小さめにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 3초 동안 평소보다 작게, 부드럽게 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem 3 seconden rustig in door je neus – kleiner dan een normale ademhaling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire suavemente pelo nariz por 3 segundos — menos do que numa respiração normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягко вдыхай носом 3 секунды — меньше, чем при обычном вдохе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子轻柔地吸气 3 秒——比平时的呼吸更小。"
          }
        }
      }
    },
    "technique.buteyko.steps.2" : {
      "localizations" : {
