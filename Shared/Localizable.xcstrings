    },
    "technique.twoToOne.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausatmen dauert doppelt so lang wie das Einatmen. Den Ausatem so stark zu verlängern ist eine verbreitete Methode, vor dem Schlafengehen herunterzufahren und den Körper zur Ruhe kommen zu lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exhale lasts twice as long as the inhale. Lengthening the out-breath this much is a common way to slow down before bed and to let the body settle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exhalación dura el doble que la inhalación. Alargar tanto la salida del aire es una forma habitual de bajar el ritmo antes de dormir y dejar que el cuerpo se relaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration dure deux fois plus longtemps que l'inspiration. Allonger autant l'expiration est une façon courante de ralentir avant le coucher et de laisser le corps s'apaiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espirazione dura il doppio dell’inspirazione. Allungare così tanto l’espirazione è un modo diffuso per rallentare prima di dormire e lasciare che il corpo si calmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸う時間の2倍の長さで吐きます。これほど呼気を長くすることは、寝る前にペースを落とし、体を落ち着かせるための一般的な方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날숨을 들숨보다 두 배 길게 해요. 이렇게 날숨을 길게 늘이는 것은 잠들기 전 속도를 늦추고 몸을 안정시키는 흔한 방법이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De uitademing duurt twee keer zo lang als de inademing. De uitademing zo sterk verlengen is een veelgebruikte manier om voor het slapengaan te vertragen en je lichaam tot rust te laten komen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A expiração dura o dobro da inspiração. Alongar tanto a expiração é uma forma comum de desacelerar antes de dormir e deixar o corpo se acomodar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдох длится вдвое дольше вдоха. Так сильно удлинять выдох — распространённый способ замедлиться перед сном и дать телу успокоиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼气时长是吸气的两倍。如此延长呼气，是睡前放慢节奏、让身体安定下来的常用方法。"
          }
        }
      }
    },
