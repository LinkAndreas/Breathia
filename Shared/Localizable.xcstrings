    "technique.sevenEleven.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf ein langes Einatmen folgt ein noch längeres Ausatmen. Das Muster wird oft bei Angst oder Panik empfohlen, weil das Zählen und der lange Ausatem dem Geist etwas Beständiges zum Festhalten geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A long inhale is followed by an even longer exhale. The pattern is often recommended for moments of anxiety or panic because counting and the long out-breath give the mind something steady to hold on to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A una inhalación larga le sigue una exhalación aún más larga. Suele recomendarse en momentos de ansiedad o pánico porque contar y la exhalación larga dan a la mente algo estable a lo que aferrarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une longue inspiration est suivie d'une expiration encore plus longue. Ce rythme est souvent conseillé en cas d'anxiété ou de panique, car le comptage et la longue expiration offrent à l'esprit un repère stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A una lunga inspirazione segue un’espirazione ancora più lunga. Questo schema è spesso consigliato nei momenti di ansia o panico, perché contare e la lunga espirazione offrono alla mente un appiglio stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長く吸ったあと、さらに長く吐きます。カウントと長い呼気が心に安定したよりどころを与えるため、不安やパニックを感じたときによく勧められるパターンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 들이쉰 뒤 그보다 더 길게 내쉬어요. 숫자를 세며 길게 내쉬는 동안 마음이 붙잡을 수 있는 일정한 무언가가 생기기 때문에, 불안하거나 공황이 올 때 자주 권장되는 호흡법이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een lange inademing volgt een nog langere uitademing. Het patroon wordt vaak aangeraden bij angst of paniek, omdat het tellen en de lange uitademing je geest iets stabiels geven om je aan vast te houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma inspiração longa é seguida de uma expiração ainda mais longa. O padrão é muito recomendado em momentos de ansiedade ou pânico, porque a contagem e a expiração longa dão à mente algo estável em que se apoiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За долгим вдохом следует ещё более долгий выдох. Этот паттерн часто советуют в моменты тревоги или паники: счёт и долгий выдох дают уму что-то устойчивое, за что можно держаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长吸气之后是更长的呼气。这种模式常被推荐用于焦虑或恐慌的时刻，因为计数和悠长的呼气能给头脑一个稳定的依托。"
          }
        }
      }
    },
