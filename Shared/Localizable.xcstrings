    "technique.humming.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summe leise und angenehm. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the hum quiet and comfortable. Stop if you feel dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el zumbido suave y cómodo. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le bourdonnement doux et confortable. Arrête si tu as des vertiges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il ronzio leggero e piacevole. Fermati se ti gira la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハミングは静かに、楽な強さで行ってください。めまいを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허밍은 조용하고 편안하게 하세요. 어지러우면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het neuriën zacht en comfortabel. Stop als je duizelig wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o zumbido baixo e confortável. Pare se sentir tontura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жужжи тихо и комфортно. Остановись, если закружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持哼鸣轻柔、舒适。如感到头晕，请停止练习。"
          }
        }
      }
    },
    "technique.humming.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich bequem hin und schließ die Augen, wenn du möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit comfortably and close your eyes if you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate cómodamente y cierra los ojos si quieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi confortablement et ferme les yeux si tu le souhaites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti comodamente e, se vuoi, chiudi gli occhi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽に座り、よければ目を閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편안하게 앉고, 원한다면 눈을 감으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga comfortabel zitten en sluit je ogen als je wilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se confortavelmente e feche os olhos, se quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь удобно и, если хочешь, закрой глаза."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舒适地坐好，可以闭上眼睛。"
          }
        }
      }
    },
    "technique.humming.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden durch die Nase ein."
          }
