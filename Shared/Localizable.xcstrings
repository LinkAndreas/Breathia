        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale slowly for 6 seconds, letting everything soften."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala despacio durante 6 segundos y deja que todo se relaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez lentement pendant 6 secondes en laissant tout se relâcher."
          }
        }
      }
    },
    "technique.threePart.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
