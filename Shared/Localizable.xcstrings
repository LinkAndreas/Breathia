            "value" : "Les débutants en respiration lente"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi si avvicina per la prima volta alla respirazione lenta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりとした呼吸が初めての方"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느린 호흡이 처음인 분"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen die net begint met langzaam ademen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem está começando na respiração lenta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для всех, кто только знакомится с медленным дыханием"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
