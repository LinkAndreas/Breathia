    "technique.478.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf ein kurzes Einatmen folgen ein langes Anhalten und ein noch längeres Ausatmen. Das verlängerte Ausatmen ist der Kern dieses Musters und wird oft mit einem ruhigeren Zustand in Verbindung gebracht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short inhale is followed by a long hold and an even longer exhale. The extended exhale is the key part of this pattern and is often associated with a shift toward a calmer state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A una inhalación corta le siguen una retención larga y una exhalación aún más larga. La exhalación prolongada es la parte clave de este patrón y suele asociarse con un estado más tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une inspiration courte est suivie d'une longue rétention et d'une expiration encore plus longue. L'expiration prolongée est l'élément clé de ce rythme et est souvent associée à un état plus calme."
          }
        }
      }
    },
    "technique.478.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4-7-8-Atmung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4-7-8 Breathing"
          }
        },
        "es" : {
          "stringUnit" : {
