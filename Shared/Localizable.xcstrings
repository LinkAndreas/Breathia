    "technique.sunBreath.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Einatmen geht durch das rechte Nasenloch, jedes Ausatmen durch das linke. Traditionell mit Wärme und Wachheit verbunden, wird die Übung genutzt, um Körper und Geist sanft aufzuwecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every inhale goes through the right nostril and every exhale through the left. Traditionally linked with warmth and alertness, it is used as a gentle way to wake up body and mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inhalación entra por la fosa nasal derecha y cada exhalación sale por la izquierda. Tradicionalmente asociada con el calor y el estado de alerta, se usa como una forma suave de despertar el cuerpo y la mente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque inspiration passe par la narine droite et chaque expiration par la gauche. Traditionnellement associée à la chaleur et à la vigilance, elle sert à réveiller doucement le corps et l'esprit."
          }
        }
      }
    },
    "technique.sunBreath.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnenatmung (Surya Bhedana)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun Breath (Surya Bhedana)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración solar (Surya Bhedana)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration solaire (Surya Bhedana)"
          }
        }
      }
    },
