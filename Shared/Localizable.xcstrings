    "technique.coherent.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der kohärenten Atmung verlangsamst du den Atem auf etwa fünf Atemzüge pro Minute, mit langem, gleichmäßigem Ein- und Ausatmen. In diesem Tempo steigt und sinkt die Herzfrequenz bei vielen Menschen mit jedem Atemzug gleichmäßig – genau das Muster, das HRV-Biofeedback anstrebt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coherent breathing slows the breath to about five breaths a minute with a long, even inhale and exhale. At this pace, many people see heart rate rise and fall smoothly with each breath — the pattern HRV biofeedback aims for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respiración coherente reduce el ritmo a unas cinco respiraciones por minuto, con una inhalación y una exhalación largas y uniformes. A este ritmo, en muchas personas la frecuencia cardiaca sube y baja de forma suave con cada respiración, justo el patrón que busca el biofeedback de VFC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respiration cohérente ralentit le souffle à environ cinq respirations par minute, avec une inspiration et une expiration longues et régulières. À ce rythme, chez beaucoup de personnes, la fréquence cardiaque monte et descend en douceur à chaque respiration : c'est précisément le schéma recherché en biofeedback de VFC."
          }
        }
      }
    },
