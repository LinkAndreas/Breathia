    "technique.sunBreath.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Einatmen geht durch das rechte Nasenloch, jedes Ausatmen durch das linke. Traditionell mit Wärme und Wachheit verbunden, wird die Übung genutzt, um Körper und Geist sanft aufzuwecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every inhale goes through the right nostril and every exhale through the left. Traditionally linked with warmth and alertness, it is used as a gentle way to wake up body and mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inhalación entra por la fosa nasal derecha y cada exhalación sale por la izquierda. Tradicionalmente asociada con el calor y el estado de alerta, se usa como una forma suave de despertar el cuerpo y la mente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque inspiration passe par la narine droite et chaque expiration par la gauche. Traditionnellement associée à la chaleur et à la vigilance, elle sert à réveiller doucement le corps et l'esprit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni inspirazione passa dalla narice destra e ogni espirazione dalla sinistra. Tradizionalmente legata al calore e alla vigilanza, è usata come modo delicato per risvegliare corpo e mente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸うときは必ず右の鼻から、吐くときは左の鼻から行います。伝統的に温かさや覚醒と結びつけられ、心身をやさしく目覚めさせる方法として行われています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 오른쪽 콧구멍으로 들이쉬고 왼쪽 콧구멍으로 내쉬어요. 전통적으로 따뜻함과 각성과 관련이 있어 몸과 마음을 부드럽게 깨우는 방법으로 쓰여요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke inademing gaat door het rechterneusgat en elke uitademing door het linker. Traditioneel wordt deze oefening verbonden met warmte en alertheid en gebruikt als zachte manier om lichaam en geest wakker te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda inspiração passa pela narina direita e toda expiração pela esquerda. Tradicionalmente associada ao calor e ao estado de alerta, é usada como uma forma suave de despertar o corpo e a mente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый вдох идёт через правую ноздрю, а каждый выдох — через левую. Традиционно эту практику связывают с теплом и бодростью и используют как мягкий способ разбудить тело и ум."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次都用右鼻孔吸气、左鼻孔呼气。传统上它与温暖和警觉相关，被用作温和唤醒身心的方法。"
          }
        }
      }
    },
