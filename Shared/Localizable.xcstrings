    "technique.coherent.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich 6 Sekunden zu lang anfühlen, beginne mit der Resonanzatmung mit 5 Sekunden und steigere dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If 6 seconds feels too long, start with Resonance Breathing at 5 seconds and work up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 6 segundos te parecen demasiado, empieza con la respiración de resonancia a 5 segundos y ve aumentando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 6 secondes te semblent trop longues, commence par la respiration de résonance à 5 secondes, puis augmente progressivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se 6 secondi ti sembrano troppi, inizia con la respirazione di risonanza a 5 secondi e aumenta gradualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6秒が長すぎると感じたら、5秒の共鳴呼吸から始めて、少しずつ延ばしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6초가 너무 길게 느껴지면 5초로 하는 공명 호흡부터 시작해 점차 늘려 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als 6 seconden te lang voelt, begin dan met resonantieademhaling op 5 seconden en bouw het op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se 6 segundos parecerem longos demais, comece com a Respiração de ressonância a 5 segundos e vá aumentando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если 6 секунд кажутся слишком долгими, начни с резонансного дыхания по 5 секунд и постепенно увеличивай."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 6 秒感觉太长，可以先从 5 秒的共振呼吸开始，再逐步延长。"
          }
        }
      }
    },
    "technique.coherent.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich aufrecht hin und lass die Schultern sinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright and let your shoulders drop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido y deja caer los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi le dos droit et relâche les épaules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti con la schiena dritta e lascia scendere le spalle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背筋を伸ばして座り、肩の力を抜きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "똑바로 앉아 어깨를 편안히 내리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga rechtop zitten en laat je schouders zakken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se com a coluna ereta e solte os ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь прямо и опусти плечи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐直，让双肩自然下沉。"
          }
        }
      }
    },
    "technique.coherent.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 6 Sekunden langsam durch die Nase ein."
          }
        },
        "en" : {
