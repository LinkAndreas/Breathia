    "technique.bellows.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht geeignet in der Schwangerschaft oder bei Bluthochdruck, Herzerkrankungen oder Epilepsie. Hör sofort auf, wenn dir schwindlig wird oder es kribbelt, und übe nie beim Autofahren oder im Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not suitable during pregnancy or with high blood pressure, heart conditions, or epilepsy. Stop immediately if you feel dizzy or tingly, and never practice while driving or in water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es adecuada durante el embarazo ni en caso de hipertensión, problemas cardiacos o epilepsia. Detente de inmediato si notas mareo u hormigueo, y nunca la practiques mientras conduces o estás en el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconseillée pendant la grossesse et en cas d'hypertension, de maladie cardiaque ou d'épilepsie. Arrête immédiatement en cas de vertiges ou de fourmillements, et ne pratique jamais en conduisant ou dans l'eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non adatta in gravidanza o in caso di pressione alta, problemi cardiaci o epilessia. Fermati subito se avverti vertigini o formicolii, e non praticarla mai alla guida o in acqua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "妊娠中の方、高血圧、心臓疾患、てんかんのある方には適していません。めまいやしびれを感じたらすぐに中止し、運転中や水中では絶対に行わないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임신 중이거나 고혈압, 심장 질환, 뇌전증이 있다면 적합하지 않아요. 어지럽거나 저린 느낌이 들면 즉시 멈추고, 운전 중이나 물속에서는 절대 하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet geschikt tijdens de zwangerschap of bij hoge bloeddruk, hartaandoeningen of epilepsie. Stop direct als je duizelig wordt of een tintelend gevoel krijgt, en oefen nooit tijdens het autorijden of in het water."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é indicada durante a gravidez nem em caso de pressão alta, problemas cardíacos ou epilepsia. Pare imediatamente se sentir tontura ou formigamento, e nunca pratique dirigindo ou dentro da água."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не подходит при беременности, высоком давлении, заболеваниях сердца или эпилепсии. Сразу остановись, если появились головокружение или покалывание, и никогда не практикуй за рулём или в воде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孕期或患有高血压、心脏疾病或癫痫者不宜练习。如感到头晕或刺麻，请立即停止；切勿在驾驶时或水中练习。"
          }
        }
      }
    },
    "technique.bellows.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitz aufrecht mit entspannten Schultern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit tall with your shoulders relaxed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate erguido con los hombros relajados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assieds-toi le dos bien droit, les épaules détendues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siediti con la schiena dritta e le spalle rilassate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩の力を抜いて、背筋を伸ばして座ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어깨의 힘을 빼고 허리를 펴고 앉으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zit rechtop met ontspannen schouders."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se com a coluna ereta e os ombros relaxados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сядь прямо, расслабив плечи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挺直坐好，放松双肩。"
          }
        }
      }
    },
    "technique.bellows.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 1 Sekunde kräftig durch die Nase ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale forcefully through your nose for 1 second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala con fuerza por la nariz durante 1 segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire vigoureusement par le nez pendant 1 seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspira con forza dal naso per 1 secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻から1秒間、力強く吸います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 1초 동안 힘차게 들이쉬세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem 1 seconde krachtig in door je neus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspire com força pelo nariz por 1 segundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильно вдохни носом за 1 секунду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子用力吸气 1 秒。"
          }
        }
      }
    },
    "technique.bellows.steps.3" : {
