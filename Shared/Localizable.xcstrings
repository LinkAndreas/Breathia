    "technique.sigh.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf zwei Einatmungen hintereinander – die zweite kürzer und auf die erste gesetzt – folgt ein langes, langsames Ausatmen. Dieses Muster kommt von Natur aus vor und soll helfen, die Lunge vor einem längeren Ausatmen wieder zu entfalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two inhales in a row, the second one shorter and on top of the first, are followed by one long, slow exhale. This pattern occurs naturally and is thought to help re-inflate the lungs before a longer release of air."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos inhalaciones seguidas, la segunda más corta y encima de la primera, van seguidas de una exhalación larga y lenta. Este patrón se da de forma natural y se cree que ayuda a volver a expandir los pulmones antes de soltar el aire más despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux inspirations successives, la seconde plus courte et par-dessus la première, sont suivies d'une longue expiration lente. Ce schéma survient naturellement et aiderait à regonfler les poumons avant une expiration plus longue."
          }
        }
      }
    },
    "technique.sigh.name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physiologischer Seufzer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physiological Sigh"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspiro fisiológico"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soupir physiologique"
          }
        }
      }
    },
    "technique.sigh.purpose" : {
