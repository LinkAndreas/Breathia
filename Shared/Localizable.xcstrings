    },
    "technique.pursedLip.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Lungenerkrankung hast, halte dich an die Empfehlungen deiner Ärztin oder deines Arztes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a lung condition, follow the guidance of your healthcare provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes una afección pulmonar, sigue las indicaciones de tu profesional sanitario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez une maladie pulmonaire, suivez les recommandations de votre professionnel de santé."
          }
        }
      }
    },
    "technique.pursedLip.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspanne Nacken und Schultern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relax your neck and shoulders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaja el cuello y los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâchez la nuque et les épaules."
          }
        }
      }
    },
    "technique.pursedLip.steps.2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 2 Sekunden durch die Nase ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through your nose for 2 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhala por la nariz durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirez par le nez pendant 2 secondes."
          }
        }
      }
    },
    "technique.pursedLip.steps.3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spitze die Lippen, als wolltest du pfeifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purse your lips as if you were about to whistle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frunce los labios como si fueras a silbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez les lèvres comme si vous alliez siffler."
          }
        }
      }
    },
    "technique.pursedLip.steps.4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme 4 Sekunden langsam durch die gespitzten Lippen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhale slowly through pursed lips for 4 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhala despacio por los labios fruncidos durante 4 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirez lentement par les lèvres pincées pendant 4 secondes."
          }
        }
      }
    },
    "technique.pursedLip.summary" : {
      "localizations" : {
