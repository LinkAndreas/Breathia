    "technique.recovery.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte, bis du bequem durch die Nase atmen kannst. Hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait until you can breathe comfortably through your nose. Stop if you feel dizzy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera hasta que puedas respirar cómodamente por la nariz. Detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attends de pouvoir respirer confortablement par le nez. Arrête si tu as des vertiges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta di riuscire a respirare comodamente dal naso. Fermati se ti gira la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻で楽に呼吸できるようになるまで待ってから始めてください。めまいを感じたら中止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코로 편안하게 숨 쉴 수 있을 때까지 기다리세요. 어지러우면 멈추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot je comfortabel door je neus kunt ademen. Stop als je duizelig wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere até conseguir respirar confortavelmente pelo nariz. Pare se sentir tontura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подожди, пока сможешь комфортно дышать носом. Остановись, если закружится голова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等到能用鼻子舒适地呼吸时再开始。如感到头晕，请停止练习。"
          }
        }
      }
    },
    "technique.recovery.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
