    "technique.heartFocused.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Muster hat keine Pausen. Atme sanft und hör auf, wenn dir schwindlig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pattern has no holds. Breathe gently and stop if you feel lightheaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este patrón no tiene retenciones. Respira con suavidad y detente si te mareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce rythme ne comporte aucune rétention. Respirez doucement et arrêtez si vous vous sentez étourdi."
          }
        }
      }
    },
    "technique.heartFocused.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege eine Hand auf die Brust, wenn dir das beim Fokussieren hilft."
