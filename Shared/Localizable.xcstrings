    "technique.bellows.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze, kräftige Ein- und Ausatemzüge durch die Nase folgen in gleichmäßigem Tempo aufeinander, wie ein Blasebalg, der ein Feuer anfacht. Es ist eine traditionelle, belebende Übung in kurzen Runden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short, strong inhales and exhales through the nose follow each other at a steady pace, like a bellows fanning a fire. It is a traditional energizing practice done in short rounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalaciones y exhalaciones cortas y fuertes por la nariz se suceden a un ritmo constante, como un fuelle que aviva el fuego. Es una práctica tradicional energizante que se hace en rondas cortas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De courtes inspirations et expirations vigoureuses par le nez s'enchaînent à un rythme régulier, comme un soufflet qui attise un feu. C'est une pratique traditionnelle dynamisante, réalisée en courtes séries."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirazioni ed espirazioni brevi e vigorose dal naso si susseguono a ritmo costante, come un mantice che ravviva il fuoco. È una pratica tradizionale energizzante, eseguita in brevi serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火をあおるふいごのように、鼻から短く強く吸って吐くことを一定のペースで繰り返します。短いラウンドで行う、伝統的な活力を高める呼吸法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀무로 불을 지피듯, 코로 짧고 강하게 들이쉬고 내쉬기를 일정한 속도로 이어 가요. 짧은 라운드로 진행하는 전통적인 활력 호흡법이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte, krachtige in- en uitademingen door de neus volgen elkaar in een vast tempo op, als een blaasbalg die een vuur aanwakkert. Het is een traditionele, energiegevende oefening in korte rondes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspirações e expirações curtas e fortes pelo nariz se sucedem em ritmo constante, como um fole que aviva o fogo. É uma prática tradicional energizante, feita em rodadas curtas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткие сильные вдохи и выдохи через нос следуют друг за другом в ровном темпе — как кузнечные мехи, раздувающие огонь. Это традиционная бодрящая практика, которую выполняют короткими раундами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用鼻子短促有力地吸气和呼气，以稳定的节奏连续进行，就像风箱为炉火鼓风。这是一种传统的提神练习，通常分几轮短时进行。"
          }
        }
      }
    },
