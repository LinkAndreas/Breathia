    "technique.triangle.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Pause entspannt. Verkürze sie, wenn sie sich unangenehm anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the hold relaxed. Shorten it if it feels uncomfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la retención relajada. Acórtala si te resulta incómoda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la rétention détendue. Raccourcis-la si elle devient inconfortable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni l’apnea rilassata. Accorciala se ti mette a disagio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息止めはリラックスして行ってください。つらい場合は短くしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨은 편안하게 참으세요. 불편하면 참는 시간을 줄이세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de pauze ontspannen. Maak hem korter als hij onprettig voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a retenção relaxada. Encurte-a se for desconfortável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задерживай дыхание расслабленно. Сократи задержку, если она некомфортна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏息时保持放松。如感到不适，请缩短屏息。"
          }
        }
      }
    },
    "technique.triangle.steps.1" : {
