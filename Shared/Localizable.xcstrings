    "technique.478.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf ein kurzes Einatmen folgen ein langes Anhalten und ein noch längeres Ausatmen. Das verlängerte Ausatmen ist der Kern dieses Musters und wird oft mit einem ruhigeren Zustand in Verbindung gebracht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short inhale is followed by a long hold and an even longer exhale. The extended exhale is the key part of this pattern and is often associated with a shift toward a calmer state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A una inhalación corta le siguen una retención larga y una exhalación aún más larga. La exhalación prolongada es la parte clave de este patrón y suele asociarse con un estado más tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une inspiration courte est suivie d'une longue rétention et d'une expiration encore plus longue. L'expiration prolongée est l'élément clé de ce rythme et est souvent associée à un état plus calme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A una breve inspirazione seguono una lunga apnea e un’espirazione ancora più lunga. L’espirazione prolungata è l’elemento chiave di questo schema ed è spesso associata al passaggio verso uno stato più calmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短く吸ったあとに長く息を止め、さらに長く吐きます。この長い呼気がこのパターンの要で、より穏やかな状態への切り替えと結びつけられることがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧게 들이쉰 뒤 오래 숨을 참고, 그보다 더 길게 내쉬어요. 길게 내쉬는 것이 이 호흡법의 핵심이며, 흔히 더 차분한 상태로 전환되는 것과 관련이 있다고 알려져 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een korte inademing volgen een lange adempauze en een nog langere uitademing. De verlengde uitademing is de kern van dit patroon en wordt vaak in verband gebracht met een rustigere toestand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma inspiração curta é seguida de uma retenção longa e de uma expiração ainda mais longa. A expiração prolongada é a parte principal deste padrão e costuma ser associada à passagem para um estado mais calmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За коротким вдохом следуют долгая задержка и ещё более долгий выдох. Удлинённый выдох — главная часть этого паттерна, и его часто связывают с переходом в более спокойное состояние."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短促吸气后，长时间屏息，再进行更长的呼气。延长的呼气是这种模式的关键，通常与身心转向更平静的状态有关。"
          }
        }
      }
    },
