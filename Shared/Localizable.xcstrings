          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 왼쪽으로 들이쉬며 반복하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhaal en adem steeds links in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repita, sempre inspirando pela esquerda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторяй, всегда вдыхая через левую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复练习，始终用左侧吸气。"
          }
        }
      }
    },
    "technique.moonBreath.summary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das linke Nasenloch ein-, durch das rechte ausatmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale through the left nostril, exhale through the right"
