    "sensor.permission.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia nutzt Bluetooth nur, um sich mit deinem Herzfrequenzsensor wie dem Polar H10 zu verbinden und beim Atmen deine Herzfrequenz und HRV anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia uses Bluetooth only to connect to your heart-rate sensor, like the Polar H10, and show your heart rate and HRV while you breathe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa Bluetooth solo para conectarse a tu sensor de frecuencia cardiaca, como el Polar H10, y mostrar tu frecuencia cardiaca y tu VFC mientras respiras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia utilise le Bluetooth uniquement pour se connecter à ton capteur de fréquence cardiaque, comme le Polar H10, et afficher ta fréquence cardiaque et ta VFC pendant que tu respires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia usa il Bluetooth solo per collegarsi al tuo sensore di frequenza cardiaca, come il Polar H10, e mostrare frequenza cardiaca e HRV mentre respiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathiaは、Polar H10などの心拍センサーに接続し、呼吸中の心拍数とHRVを表示するためだけにBluetoothを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia는 Polar H10 같은 심박 센서에 연결해 호흡하는 동안 심박수와 HRV를 보여 주는 데에만 Bluetooth를 사용해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia gebruikt Bluetooth alleen om verbinding te maken met je hartslagsensor, zoals de Polar H10, en om tijdens het ademen je hartslag en HRV te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Breathia usa o Bluetooth apenas para se conectar ao seu sensor de frequência cardíaca, como o Polar H10, e mostrar sua frequência cardíaca e VFC enquanto você respira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia использует Bluetooth только для подключения к твоему датчику пульса, например Polar H10, чтобы показывать пульс и ВСР во время дыхания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathia 仅使用蓝牙连接你的心率传感器（如 Polar H10），以便在你呼吸时显示心率和 HRV。"
          }
        }
      }
    },
    "sensor.permission.next" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
