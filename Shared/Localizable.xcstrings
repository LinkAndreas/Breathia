    "technique.box.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Atemphase dauert gleich lang, was dem Atem einen gleichmäßigen, vorhersehbaren Rhythmus gibt. Vielen fällt es leichter, sich in diesen Rhythmus einzufinden, als ohne Struktur „langsam“ zu atmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each phase of the breath lasts the same length of time, which gives the breath a steady, predictable rhythm. Many people find that rhythm easier to settle into than trying to breathe \"slowly\" without a structure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fase de la respiración dura lo mismo, lo que le da a la respiración un ritmo estable y predecible. A muchas personas les resulta más fácil adaptarse a ese ritmo que intentar respirar «despacio» sin una estructura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque phase de la respiration dure le même temps, ce qui lui donne un rythme régulier et prévisible. Beaucoup trouvent ce rythme plus facile à adopter que d'essayer de respirer « lentement » sans structure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni fase del respiro dura lo stesso tempo, il che dà al respiro un ritmo regolare e prevedibile. Molte persone trovano più facile adattarsi a questo ritmo che cercare di respirare “lentamente” senza una struttura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸の各フェーズを同じ長さにすることで、一定で予測しやすいリズムが生まれます。決まった型なしに「ゆっくり」呼吸しようとするより、このリズムのほうがなじみやすいと感じる人は多くいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡의 각 단계가 같은 시간 동안 이어져 일정하고 예측 가능한 리듬이 만들어져요. 정해진 틀 없이 ‘천천히’ 호흡하려 애쓰는 것보다 이런 리듬에 몸을 맡기는 것이 더 쉽다고 느끼는 사람이 많아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke fase van de ademhaling duurt even lang, wat de adem een gelijkmatig, voorspelbaar ritme geeft. Veel mensen vinden het makkelijker om in dat ritme te komen dan om zonder structuur ‘langzaam’ te ademen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fase da respiração dura o mesmo tempo, o que dá à respiração um ritmo estável e previsível. Muitas pessoas acham mais fácil se acomodar nesse ritmo do que tentar respirar “devagar” sem uma estrutura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая фаза дыхания длится одинаково, и это даёт дыханию ровный, предсказуемый ритм. Многим проще войти в такой ритм, чем пытаться дышать «медленно» без всякой структуры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸的每个阶段时长相同，让呼吸拥有稳定、可预期的节奏。许多人发现，比起在没有结构的情况下努力“慢慢”呼吸，这种节奏更容易进入状态。"
          }
        }
      }
    },
