            "state" : "translated",
            "value" : "Оставаться в моменте во время медитации"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冥想时保持当下觉知"
          }
        }
      }
    },
    "technique.ujjayi.bestFor.3" : {
      "localizations" : {
