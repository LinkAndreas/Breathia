    "settings.rmssdReflectsBeat" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD bildet Veränderungen von Schlag zu Schlag ab, SDNN die Gesamtvariabilität. Eine höhere Empfindlichkeit reagiert früher auf kleinere Veränderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD reflects beat-to-beat changes; SDNN reflects overall variability. Higher sensitivity responds sooner to smaller changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD refleja los cambios latido a latido; SDNN refleja la variabilidad global. Una sensibilidad mayor responde antes a cambios más pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RMSSD reflète les variations d'un battement à l'autre ; le SDNN, la variabilité globale. Une sensibilité plus élevée réagit plus tôt à de petits changements."
          }
        }
      }
    },
