    "technique.lion.safetyNote" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme kräftig, aber angenehm aus. Ein paar Runden reichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the exhale strong but comfortable. A few rounds are enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz la exhalación enérgica pero cómoda. Bastan unas pocas rondas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde une expiration puissante mais confortable. Quelques séries suffisent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni l’espirazione forte ma comoda. Bastano poche ripetizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力強く、でも無理のない範囲で吐いてください。数回で十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힘차게 내쉬되 편안한 정도로 하세요. 몇 번만 반복해도 충분해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem krachtig maar comfortabel uit. Een paar rondes zijn genoeg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a expiração forte, mas confortável. Algumas rodadas bastam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдох должен быть сильным, но комфортным. Достаточно нескольких раундов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼气要有力，但保持舒适。做几轮就足够了。"
          }
        }
      }
    },
    "technique.lion.steps.1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie oder setz dich bequem hin, die Hände auf den Knien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kneel or sit comfortably with your hands on your knees."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrodíllate o siéntate cómodamente con las manos sobre las rodillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenouille-toi ou assieds-toi confortablement, les mains sur les genoux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inginocchiati o siediti comodamente con le mani sulle ginocchia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正座するか楽に座り、両手をひざに置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무릎을 꿇거나 편안하게 앉아 두 손을 무릎에 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kniel of ga comfortabel zitten met je handen op je knieën."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoelhe-se ou sente-se confortavelmente, com as mãos sobre os joelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встань на колени или удобно сядь, положив руки на колени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跪坐或舒适地坐好，双手放在膝盖上。"
          }
        }
      }
    },
    "technique.lion.steps.2" : {
      "localizations" : {
