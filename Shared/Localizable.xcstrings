    "support.recurringSupportIsOptional" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regelmäßige Unterstützung ist freiwillig und schaltet nichts frei – Breathia bleibt vollständig kostenlos. Die Zahlung wird deinem Apple Account belastet. Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt werden. Du kannst sie jederzeit in den Einstellungen deines Apple Accounts verwalten oder kündigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recurring support is optional and unlocks nothing — Breathia stays fully free. Payment is charged to your Apple Account. Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period. You can manage or cancel them anytime in your Apple Account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El apoyo recurrente es opcional y no desbloquea nada: Breathia sigue siendo totalmente gratuita. El pago se carga en tu cuenta de Apple. Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes del final del periodo actual. Puedes gestionarlas o cancelarlas cuando quieras en los ajustes de tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soutien récurrent est facultatif et ne débloque rien : Breathia reste entièrement gratuit. Le paiement est débité de votre compte Apple. Les abonnements se renouvellent automatiquement, sauf résiliation au moins 24 heures avant la fin de la période en cours. Vous pouvez les gérer ou les résilier à tout moment dans les réglages de votre compte Apple."
          }
        }
      }
    },
